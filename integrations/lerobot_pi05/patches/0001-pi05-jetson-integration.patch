+#!/bin/bash
+# Pi0.5 INT8 量化一键执行脚本
+# 使用前确保无残留 D-state Python 进程（重启或等 GPU 锁自然释放）
+set -euo pipefail
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+cd "$SCRIPT_DIR/.."
+
+source ${CONDA_BASE:-$HOME/miniconda3}/etc/profile.d/conda.sh
+conda activate lerobot_ycy
+
+export PYTHONUNBUFFERED=1
+export PYTHONPATH="src:${LEROBOT_POLICY_ROOT:-$HOME/project/lerobot_0.3.3_pzy}/thrid-party/XLeRobot/software/src:$PYTHONPATH"
+export LD_PRELOAD=/usr/lib/aarch64-linux-gnu/libnvinfer.so.10
+export TRANSFORMERS_OFFLINE=1
+export HF_HUB_OFFLINE=1
+
+DATASET_PATH=$HOME/.cache/huggingface/lerobot/usrname1/eval_pi05_pytorch_60s
+TASK="put the bottle into the basket in front of you"
+POLICY_PATH=${LEROBOT_POLICY_ROOT:-$HOME/project/lerobot_0.3.3_pzy}/outputs/train/test/pi05_pick_up_bottle_three_pi_fixed/checkpoints/030000/pretrained_model
+ENGINE_DIR=outputs/trt_engines/pi05_pick_up_bottle_three_pi_fixed
+
+echo "===== Step 1: INT8 Quantization + Engine Build ====="
+DATASET_PATH="$DATASET_PATH" TASK="$TASK" NUM_FRAMES=20 \
+  bash scripts/build_trt_pi05_engine.sh --int8
+
+echo ""
+echo "===== Step 2: Synthetic Data Verification ====="
+python scripts/verify_pi05_trt.py \
+  --policy_path "$POLICY_PATH" \
+  --engine_path "$ENGINE_DIR/pi05_expert_decode_int8.engine"
+
+echo ""
+echo "===== Step 3: Real Data Verification ====="
+python scripts/verify_trt_with_real_data_pi05.py \
+  --policy_path "$POLICY_PATH" \
+  --engine_path "$ENGINE_DIR/pi05_expert_decode_int8.engine" \
+  --dataset_path "$DATASET_PATH" \
+  --task "$TASK" \
+  --num_frames 20
+
+echo ""
+echo "===== Step 4: trtexec Benchmark ====="
+/usr/src/tensorrt/bin/trtexec \
+  --loadEngine="$ENGINE_DIR/pi05_expert_decode_int8.engine" \
+  --fp16 --int8
+
+echo ""
+echo "===== DONE ====="
+echo "Clean temp FP32 ONNX (~2GB): rm $ENGINE_DIR/pi05_expert_decode_fp32.onnx"
