+import cv2
+import os
+import time
+import threading
+from queue import Queue, Empty
+
+def detect_available_cameras(max_index=10):
+    """自动检测可用的摄像头设备"""
+    available_cameras = []
+
+    print("正在检测可用摄像头...")
+    for i in range(max_index):
+        cap = cv2.VideoCapture(i)
