+#!/usr/bin/env python3
+"""
+Pi0.5 权重-only INT8 量化 — 只量化 MatMul 权重，不量化激活值。
+
+根因分析：
+  ORT quantize_static 会量化整个图的激活值（包括 attention Q*K、softmax*V 等
+  精度敏感的 Mul 操作），导致 INT8 截断后 attention 计算完全错误（cos_sim=0.07）。
+
+修复方案：
+  手动只对 MatMul 权重做 per-channel symmetric INT8 量化 + DQ 节点，
+  激活值保持原始精度（BF16/FP32）。TRT 编译时看到 DQ→MatMul 模式，
+  可选择性将 MatMul 改用 INT8 kernel。
+
+流程：
+  BF16 ONNX → 量化 MatMul 权重 → INT8(weight-only) ONNX → trtexec --int8 --bf16 → engine
+
+用法:
+  cd /path/to/lerobot_ycy
+  source /path/to/miniconda3/etc/profile.d/conda.sh && conda activate lerobot_ycy
+  export PATH="/path/to/miniconda3/envs/lerobot_ycy/bin:$PATH"
+
+  python scripts/quantize_onnx_int8_weight_only.py \
+    --onnx_path outputs/trt_engines/pi05_pick_up_bottle_three_pi_fixed/pi05_expert_decode.onnx
+"""
+
+import argparse
+import json
+import logging
+import os
+import subprocess
+import time
+import numpy as np
+import onnx
+from onnx import numpy_helper, TensorProto, helper
+
+logging.basicConfig(level=logging.INFO, format="%(asctime)s %(levelname)s %(message)s")
+logger = logging.getLogger(__name__)
+
+
+def parse_args():
+    p = argparse.ArgumentParser()
+    p.add_argument("--onnx_path", type=str, required=True, help="BF16 ONNX input")
+    p.add_argument("--output_dir", type=str, default=None,
+                   help="Output dir (default: same as onnx_path)")
+    return p.parse_args()
+
+
+def quantize_matmul_weights_weight_only(model):
+    """
+    Quantize only MatMul weights to INT8 (per-channel symmetric).
+    Insert DQ nodes. Leave activation paths unchanged.
+
+    Returns: (modified_model, stats_dict)
+    """
+    init_map = {i.name: i for i in model.graph.initializer}
+    nodes_to_remove = set()
+    nodes_to_add = []
+    inits_to_add = []
+    inits_to_remove = set()
+    # Track new names to avoid collisions
+    name_counter = [0]
+
+    def unique_name(base):
+        name_counter[0] += 1
+        return f"{base}_{name_counter[0]}"
+
+    stats = {"total_matmul": 0, "quantized": 0, "skipped": 0, "skipped_reasons": []}
+    dtype_map = {TensorProto.BFLOAT16: "BF16", TensorProto.FLOAT: "FP32", TensorProto.FLOAT16: "FP16"}
+
+    for node in list(model.graph.node):
+        if node.op_type != "MatMul":
+            continue
+        stats["total_matmul"] += 1
+
+        # MatMul weight is input[1]
+        weight_name = node.input[1]
+        weight_init = init_map.get(weight_name)
+        if weight_init is None:
+            stats["skipped"] += 1
+            stats["skipped_reasons"].append(f"{node.name}: weight {weight_name} not initializer")
+            continue
+
+        # Get weight data as FP32
+        raw = weight_init.raw_data
+        if weight_init.data_type == TensorProto.BFLOAT16:
+            bf16_raw = np.frombuffer(raw, dtype=np.uint16).copy()
+            fp32_raw = bf16_raw.astype(np.uint32) << 16
+            weight = fp32_raw.view(np.float32).reshape(list(weight_init.dims))
+        elif weight_init.data_type == TensorProto.FLOAT:
+            weight = np.frombuffer(raw, dtype=np.float32).reshape(list(weight_init.dims)).copy()
+        elif weight_init.data_type == TensorProto.FLOAT16:
+            weight = np.frombuffer(raw, dtype=np.float16).reshape(list(weight_init.dims)).copy().astype(np.float32)
+        else:
+            stats["skipped"] += 1
+            stats["skipped_reasons"].append(f"{node.name}: unsupported dtype {dtype_map.get(weight_init.data_type, weight_init.data_type)}")
+            continue
+
+        out_features = weight.shape[0]
+
+        # Per-channel symmetric quantization
+        max_abs = np.max(np.abs(weight), axis=1, keepdims=True)  # [out_features, 1]
+        # Avoid division by zero
+        max_abs = np.maximum(max_abs, 1e-10)
+        scale = (max_abs / 127.0).astype(np.float32).flatten()  # [out_features]
+
+        # Quantize
+        weight_int8 = np.clip(np.round(weight / max_abs * 127.0), -128, 127).astype(np.int8)
+        # Verify roundtrip
+        recovered = weight_int8.astype(np.float32) * scale.reshape(-1, 1)
+        max_err = np.max(np.abs(weight - recovered))
+        rel_err = np.linalg.norm(weight - recovered) / (np.linalg.norm(weight) + 1e-10)
+
+        # Create INT8 weight initializer
+        int8_name = f"{weight_name}_int8"
+        int8_init = numpy_helper.from_array(weight_int8, name=int8_name)
+        inits_to_add.append(int8_init)
+
+        # Create scale initializer (FP32, per-channel)
+        scale_name = f"{weight_name}_scale"
+        scale_init = numpy_helper.from_array(scale, name=scale_name)
+        inits_to_add.append(scale_init)
+
+        # Create DQ node: weight_int8 → DQ(scale) → fp32_tensor
+        dq_name = f"{weight_name}_DQ"
+        dq_output = f"{weight_name}_dq_out"
+        dq_node = helper.make_node(
+            "DequantizeLinear",
+            inputs=[int8_name, scale_name],
+            outputs=[dq_output],
+            name=dq_name,
+        )
+        nodes_to_add.append(dq_node)
+
+        # Update MatMul weight input to DQ output
+        # protobuf repeated field doesn't support direct assignment
+        old_inputs = list(node.input)
+        new_inputs = [old_inputs[0], dq_output] + old_inputs[2:]
+        del node.input[:]
+        node.input.extend(new_inputs)
+
+        # Mark old weight for removal
+        inits_to_remove.add(weight_name)
+
+        stats["quantized"] += 1
+
+        if stats["quantized"] <= 3:
+            logger.info(f"  {node.name}: out={out_features}, "
+                       f"max_abs_range=[{np.min(max_abs):.4f}, {np.max(max_abs):.4f}], "
+                       f"scale_range=[{np.min(scale):.6f}, {np.max(scale):.6f}], "
+                       f"max_recover_err={max_err:.6f}, rel_err={rel_err:.6f}")
+
+    # Apply changes — protobuf repeated fields need del+extend, not slice assignment
+    # Remove old weight initializers
+    kept_inits = [i for i in model.graph.initializer if i.name not in inits_to_remove]
+    del model.graph.initializer[:]
+    model.graph.initializer.extend(kept_inits)
+    # Add new initializers and nodes
+    model.graph.initializer.extend(inits_to_add)
+    model.graph.node.extend(nodes_to_add)
+
+    return model, stats
+
+
+def main():
+    args = parse_args()
+
+    if args.output_dir is None:
+        args.output_dir = os.path.dirname(os.path.abspath(args.onnx_path))
+
+    print("=" * 70)
+    print("Pi0.5 Weight-Only INT8 Quantization")
+    print("=" * 70)
+
+    # [1] Load BF16 ONNX
+    print("\n[1/3] Loading BF16 ONNX...")
+    model = onnx.load(args.onnx_path)
+    logger.info(f"  Nodes: {len(model.graph.node)}, Initializers: {len(model.graph.initializer)}")
+
+    # [2] Quantize MatMul weights
+    print("\n[2/3] Quantizing MatMul weights (weight-only, per-channel symmetric)...")
+    model, stats = quantize_matmul_weights_weight_only(model)
+    logger.info(f"  Total MatMul: {stats['total_matmul']}, "
+                f"Quantized: {stats['quantized']}, Skipped: {stats['skipped']}")
+    if stats["skipped_reasons"]:
+        for reason in stats["skipped_reasons"][:5]:
+            logger.info(f"    {reason}")
+
+    # [3] Save and build
+    int8_onnx_path = args.onnx_path.replace(".onnx", "_int8_weights_only.onnx")
+    onnx.save(model, int8_onnx_path)
+    onnx_size = os.path.getsize(int8_onnx_path) / 1024 / 1024
+    logger.info(f"  Saved: {int8_onnx_path} ({onnx_size:.1f} MB)")
+
+    # Count DQ nodes
+    dq_count = sum(1 for n in model.graph.node if n.op_type == "DequantizeLinear")
+    logger.info(f"  DQ nodes: {dq_count} (weight-only, NO activation quantization)")
+
+    print(f"\n[3/3] Build TRT engine:")
+    print(f"  ONNX: {int8_onnx_path}")
+    engine_path = int8_onnx_path.replace(".onnx", ".engine")
+
+    # Read config for shapes
+    orig_onnx = onnx.load(args.onnx_path)
+    prefix_len = None
+    hidden_size = None
+    num_kv_heads = None
+    kv_head_dim = None
+    for inp in orig_onnx.graph.input:
+        if inp.name == "kv_layer0_key":
+            dims = [d.dim_value for d in inp.type.tensor_type.shape.dim]
+            num_kv_heads = dims[1] if dims[1] > 0 else 1
+            prefix_len = dims[2]
+            kv_head_dim = dims[3] if dims[3] > 0 else 256
+            break
+        elif inp.name == "suffix_embs":
+            dims = [d.dim_value for d in inp.type.tensor_type.shape.dim]
+            hidden_size = dims[2] if dims[2] > 0 else 1024
+
+    if prefix_len is None:
+        prefix_len = 968
+    if hidden_size is None:
+        hidden_size = 1024
+    chunk_size = 50
+
+    num_layers = sum(1 for inp in orig_onnx.graph.input if inp.name.startswith("kv_layer")) // 2
+    total_len = prefix_len + chunk_size
+
+    logger.info(f"  prefix_len={prefix_len}, chunk_size={chunk_size}, layers={num_layers}")
+
+    shape_spec = (f"suffix_embs:1x{chunk_size}x{hidden_size},"
+                  f"attention_mask:1x1x{chunk_size}x{total_len},"
+                  f"position_ids:1x{chunk_size},"
+                  f"adarms_cond:1x{hidden_size}")
+
+    kv_shapes = ""
+    for i in range(num_layers):
+        kv_shapes += f",kv_layer{i}_key:1x{num_kv_heads}x{prefix_len}x{kv_head_dim}"
+        kv_shapes += f",kv_layer{i}_value:1x{num_kv_heads}x{prefix_len}x{kv_head_dim}"
+
+    cmd = [
+        "/usr/src/tensorrt/bin/trtexec",
+        "--onnx=" + int8_onnx_path,
+        "--saveEngine=" + engine_path,
+        "--int8",
+        "--memPoolSize=workspace:2048",
+        f"--minShapes={shape_spec}{kv_shapes}",
+        f"--optShapes={shape_spec}{kv_shapes}",
+        f"--maxShapes={shape_spec}{kv_shapes}",
+    ]
+
+    print(f"\n  Running: {' '.join(cmd)}")
+    print(f"  This may take 2-5 minutes...")
+    t0 = time.perf_counter()
+    result = subprocess.run(cmd, capture_output=True, text=True, timeout=1800)
+    t1 = time.perf_counter()
+
+    if result.returncode != 0:
+        logger.error(f"trtexec failed (exit {result.returncode}):")
+        stderr_tail = result.stderr[-3000:] if len(result.stderr) > 3000 else result.stderr
+        logger.error(stderr_tail)
+        return 1
+
+    for line in result.stdout.strip().split("\n")[-10:]:
+        logger.info(f"  trtexec: {line}")
+
+    engine_size = os.path.getsize(engine_path) / 1024 / 1024
+    logger.info(f"  Engine built in {t1-t0:.1f}s, size: {engine_size:.1f} MB")
+
+    print("\n" + "=" * 70)
+    print("DONE!")
+    print("=" * 70)
+    print(f"  Weight-only INT8 ONNX:  {int8_onnx_path} ({onnx_size:.1f} MB)")
+    print(f"  Weight-only INT8 engine: {engine_path} ({engine_size:.1f} MB)")
+    print(f"\n  Next: verify accuracy")
+    print(f"  python scripts/verify_pi05_trt.py \\")
+    print(f"    --policy_path <policy_path> \\")
+    print(f"    --engine_path {engine_path}")
+
+    return 0
+
+
+if __name__ == "__main__":
+    exit(main())
