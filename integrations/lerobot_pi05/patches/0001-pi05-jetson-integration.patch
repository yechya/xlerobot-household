diff --git a/scripts/export_trt_pi05_engine.py b/scripts/export_trt_pi05_engine.py
new file mode 100755
index 000000000..df05fb921
--- /dev/null
+++ b/scripts/export_trt_pi05_engine.py
@@ -0,0 +1,339 @@
+#!/usr/bin/env python3
+"""
+Export Pi0.5 expert decode path to ONNX for TensorRT acceleration.
+
+This script:
+1. Loads the Pi0.5 model, does a full prefill to get real KV cache
+2. Wraps the gemma_expert.model.forward() decode path for ONNX export
+3. Verifies ONNX model against PyTorch baseline
+
+Usage:
+  source /path/to/miniconda3/etc/profile.d/conda.sh
+  conda activate lerobot_ycy
+  PYTHONPATH="src:/path/to/lerobot_0.3.3_pzy/thrid-party/XLeRobot/software/src:$PYTHONPATH" \
+  python scripts/export_trt_pi05_engine.py \
+    --policy_path /path/to/lerobot_0.3.3_pzy/outputs/train/test/pi05_pick_up_bottle_three_pi_fixed/checkpoints/030000/pretrained_model
+"""
+
+import argparse
+import os
+import time
+import torch
+import numpy as np
+
+
+def parse_args():
+    p = argparse.ArgumentParser()
+    p.add_argument("--policy_path", type=str, required=True)
+    p.add_argument("--device", type=str, default="cuda")
+    p.add_argument("--output_dir", type=str, default="outputs/trt_engines/pi05_pick_up_bottle_three_pi_fixed")
+    return p.parse_args()
+
+
+def make_dummy_batch(policy, tokenizer_max_length, device):
+    """Create dummy inputs matching the model config."""
+    cfg = policy.config
+    batch = {}
+    image_keys = [k for k in cfg.input_features if "image" in k]
+    # Use actual image resolution from config
+    img_h, img_w = cfg.image_resolution
+    for key in image_keys:
+        batch[key] = torch.rand(1, 3, img_h, img_w, device=device)
+    batch["observation.language.tokens"] = torch.ones(1, tokenizer_max_length, dtype=torch.long, device=device)
+    batch["observation.language.attention_mask"] = torch.ones(1, tokenizer_max_length, dtype=torch.bool, device=device)
+    return batch
+
+
+class ExpertDecodeWrapper(torch.nn.Module):
+    """Wrap gemma_expert.model forward for ONNX export.
+
+    Takes flat KV cache tensors and reconstructs a list-of-tuples format.
+    Provides cache_position explicitly to avoid DynamicCache.get_seq_length()
+    which isn't ONNX-traceable. The list-of-tuples format is compatible with
+    the GemmaAttention forward when use_cache=False (it uses past_key_value[idx][0/1]
+    to access KV per layer).
+    """
+
+    def __init__(self, gemma_expert_model, num_layers, prefix_len):
+        super().__init__()
+        self.gemma_expert_model = gemma_expert_model
+        self.num_layers = num_layers
+        self.prefix_len = prefix_len
+
+    def forward(
+        self,
+        suffix_embs: torch.Tensor,
+        attention_mask: torch.Tensor,
+        position_ids: torch.LongTensor,
+        adarms_cond: torch.Tensor,
+        *kv_tensors: torch.Tensor,
+    ) -> torch.Tensor:
+        # Reconstruct past_key_values as list of (key, value) tuples
+        past_key_values = []
+        for i in range(self.num_layers):
+            past_key_values.append((kv_tensors[i * 2], kv_tensors[i * 2 + 1]))
+
+        # Provide cache_position to avoid past_key_values.get_seq_length() call
+        batch_size = suffix_embs.shape[0]
+        suffix_len = suffix_embs.shape[1]
+        cache_position = torch.arange(
+            self.prefix_len, self.prefix_len + suffix_len,
+            device=suffix_embs.device, dtype=torch.long
+        )
+
+        output = self.gemma_expert_model.forward(
+            inputs_embeds=suffix_embs,
+            attention_mask=attention_mask,
+            position_ids=position_ids,
+            past_key_values=past_key_values,
+            use_cache=False,
+            cache_position=cache_position,
+            adarms_cond=adarms_cond,
+        )
+        return output.last_hidden_state
+
+
+def main():
+    args = parse_args()
+
+    print("=" * 70)
+    print("Pi0.5 ONNX Export (Expert Decode Path)")
+    print("=" * 70)
+
+    # Load model
+    print("\n[1/5] Loading model...")
+    from lerobot.policies.pi05 import PI05Policy
+    policy = PI05Policy.from_pretrained(args.policy_path)
+    policy.to(args.device)
+    policy.eval()
+
+    model = policy.model
+    cfg = model.config
+    device = args.device
+
+    expert_cfg = model.paligemma_with_expert.gemma_expert.config
+    num_layers = expert_cfg.num_hidden_layers
+    hidden_size = expert_cfg.hidden_size
+    num_kv_heads = expert_cfg.num_key_value_heads
+    head_dim = expert_cfg.head_dim
+
+    print(f"  Expert: {num_layers} layers, hidden={hidden_size}, "
+          f"kv_heads={num_kv_heads}, head_dim={head_dim}")
+    print(f"  chunk_size={cfg.chunk_size}, max_action_dim={cfg.max_action_dim}")
+
+    # Build dummy inputs and run prefill to get real KV cache
+    print("\n[2/5] Prefill (getting real KV cache)...")
+
+    # Create realistic dummy inputs
+    from lerobot.policies.pi05.modeling_pi05 import make_att_2d_masks
+
+    batch_size = 1
+    chunk_size = cfg.chunk_size
+    max_action_dim = cfg.max_action_dim
+
+    # Prepare dummy images (3 cameras, 224x224)
+    img = torch.randn(batch_size, 3, 224, 224, device=device)
+    images = [img, img.clone(), img.clone()]
+    img_masks = [torch.ones(batch_size, dtype=torch.bool, device=device) for _ in range(3)]
+
+    # Dummy language tokens (tokenizer_max_length)
+    tokenizer_max_length = cfg.tokenizer_max_length
+    tokens = torch.ones(batch_size, tokenizer_max_length, dtype=torch.long, device=device)
+    masks = torch.ones(batch_size, tokenizer_max_length, dtype=torch.bool, device=device)
+
+    # Embed prefix
+    prefix_embs, prefix_pad_masks, prefix_att_masks = model.embed_prefix(
+        images, img_masks, tokens, masks
+    )
+    prefix_att_2d_masks = make_att_2d_masks(prefix_pad_masks, prefix_att_masks)
+    prefix_position_ids = torch.cumsum(prefix_pad_masks, dim=1) - 1
+
+    prefix_att_2d_masks_4d = model._prepare_attention_masks_4d(prefix_att_2d_masks)
+
+    # Run prefill
+    model.paligemma_with_expert.paligemma.language_model.config._attn_implementation = "eager"
+    with torch.no_grad():
+        _, past_key_values = model.paligemma_with_expert.forward(
+            attention_mask=prefix_att_2d_masks_4d,
+            position_ids=prefix_position_ids,
+            past_key_values=None,
+            inputs_embeds=[prefix_embs, None],
+            use_cache=True,
+        )
+
+    prefix_len = prefix_embs.shape[1]
+    print(f"  prefix_embs shape: {prefix_embs.shape}")
+    print(f"  prefix_len: {prefix_len}")
+
+    # Extract KV cache tensors
+    kv_tensors = []
+    # DynamicCache has key_cache and value_cache as lists
+    if hasattr(past_key_values, "key_cache"):
+        for i in range(num_layers):
+            k = past_key_values.key_cache[i]
+            v = past_key_values.value_cache[i]
+            print(f"  layer {i}: key {list(k.shape)}, value {list(v.shape)}")
+            kv_tensors.append(k)
+            kv_tensors.append(v)
+    else:
+        for i in range(num_layers):
+            kv = past_key_values[i]
+            print(f"  layer {i}: key {list(kv[0].shape)}, value {list(kv[1].shape)}")
+            kv_tensors.append(kv[0])
+            kv_tensors.append(kv[1])
+
+    # Prepare denoise step inputs
+    print("\n[3/5] Preparing denoise step inputs...")
+    x_t = torch.randn(batch_size, chunk_size, max_action_dim, device=device, dtype=torch.float32)
+    timestep = torch.tensor([0.5], device=device)
+
+    suffix_embs, suffix_pad_masks, suffix_att_masks, adarms_cond = model.embed_suffix(x_t, timestep)
+
+    # Build attention mask (same as denoise_step)
+    suffix_len = suffix_pad_masks.shape[1]
+    prefix_pad_2d_masks = prefix_pad_masks[:, None, :].expand(batch_size, suffix_len, prefix_len)
+    suffix_att_2d_masks = make_att_2d_masks(suffix_pad_masks, suffix_att_masks)
+    full_att_2d_masks = torch.cat([prefix_pad_2d_masks, suffix_att_2d_masks], dim=2)
+    prefix_offsets = torch.sum(prefix_pad_masks, dim=-1)[:, None]
+    position_ids = prefix_offsets + torch.cumsum(suffix_pad_masks, dim=1) - 1
+    full_att_2d_masks_4d = model._prepare_attention_masks_4d(full_att_2d_masks)
+
+    print(f"  suffix_embs: {list(suffix_embs.shape)}, dtype={suffix_embs.dtype}")
+    print(f"  attention_mask: {list(full_att_2d_masks_4d.shape)}, dtype={full_att_2d_masks_4d.dtype}")
+    print(f"  position_ids: {list(position_ids.shape)}, dtype={position_ids.dtype}")
+    print(f"  adarms_cond: {list(adarms_cond.shape)}, dtype={adarms_cond.dtype}")
+    total_len = prefix_len + suffix_len
+    print(f"  total_len (prefix+suffix): {total_len}")
+
+    # PyTorch baseline
+    print("\n[4/5] PyTorch baseline inference...")
+    model.paligemma_with_expert.gemma_expert.model.config._attn_implementation = "eager"
+    with torch.no_grad():
+        baseline_output, _ = model.paligemma_with_expert.forward(
+            attention_mask=full_att_2d_masks_4d,
+            position_ids=position_ids,
+            past_key_values=past_key_values,
+            inputs_embeds=[None, suffix_embs],
+            use_cache=False,
+            adarms_cond=[None, adarms_cond],
+        )
+    baseline_result = baseline_output[1]
+    print(f"  output shape: {list(baseline_result.shape)}, dtype={baseline_result.dtype}")
+    print(f"  output stats: mean={baseline_result.float().mean():.6f}, "
+          f"std={baseline_result.float().std():.6f}")
+
+    # ONNX export
+    print("\n[5/5] ONNX export...")
+
+    # Cast attention_mask to bfloat16 for consistency with TRT engine expectations
+    full_att_2d_masks_4d = full_att_2d_masks_4d.to(torch.bfloat16)
+    print(f"  attention_mask cast to {full_att_2d_masks_4d.dtype}")
+
+    wrapper = ExpertDecodeWrapper(model.paligemma_with_expert.gemma_expert.model, num_layers, prefix_len)
+    wrapper.eval()
+
+    # Prepare all inputs for ONNX export
+    all_inputs = [suffix_embs, full_att_2d_masks_4d, position_ids, adarms_cond] + kv_tensors
+
+    input_names = ["suffix_embs", "attention_mask", "position_ids", "adarms_cond"]
+    for i in range(num_layers):
+        input_names.append(f"kv_layer{i}_key")
+        input_names.append(f"kv_layer{i}_value")
+    output_names = ["expert_output"]
+
+    # Dynamic axes (only for inputs with variable dimensions)
+    # adarms_cond is (B, hidden_size) — fully static, no dynamic axes needed
+    dynamic_axes = {
+        "suffix_embs": {1: "chunk_size"},
+        "attention_mask": {2: "chunk_size", 3: "total_len"},
+        "position_ids": {1: "chunk_size"},
+        "expert_output": {1: "chunk_size"},
+    }
+
+    os.makedirs(args.output_dir, exist_ok=True)
+    onnx_path = f"{args.output_dir}/pi05_expert_decode.onnx"
+
+    try:
+        # Use bfloat16 autocast during export to match inference dtype
+        with torch.no_grad():
+            torch.onnx.export(
+                wrapper,
+                tuple(all_inputs),
+                onnx_path,
+                input_names=input_names,
+                output_names=output_names,
+                dynamic_axes=dynamic_axes,
+                opset_version=17,
+                do_constant_folding=True,
+                export_params=True,
+            )
+        print(f"  ONNX export successful: {onnx_path}")
+
+        # Verify ONNX
+        import onnx
+        onnx_model = onnx.load(onnx_path)
+        onnx.checker.check_model(onnx_model)
+        print("  ONNX model check passed")
+
+        # Count model size
+        onnx_size_mb = os.path.getsize(onnx_path) / 1024 / 1024
+        print(f"  ONNX file size: {onnx_size_mb:.1f} MB")
+
+        # Numerical verification with onnxruntime (if available)
+        try:
+            import onnxruntime as ort
+            print("  Running onnxruntime verification...")
+
+            # ONNX Runtime may need inputs as FP32 (no bfloat16 support in CPU)
+            ort_inputs = {}
+            for name, inp in zip(input_names, all_inputs):
+                np_inp = inp.detach().cpu().numpy() if inp.dtype != torch.bfloat16 else inp.detach().float().cpu().numpy()
+                ort_inputs[name] = np_inp
+
+            sess = ort.InferenceSession(onnx_path, providers=["CPUExecutionProvider"])
+            ort_out = sess.run(None, ort_inputs)
+            ort_result = torch.from_numpy(ort_out[0])
+
+            pt_result = baseline_result.detach().float().cpu()
+            diff = (ort_result - pt_result).abs()
+            print(f"  Max error (FP32 reference): {diff.max():.6f}")
+            print(f"  Mean error: {diff.mean():.6f}")
+            if diff.max() < 0.01:
+                print("  Numerical verification PASSED (error < 0.01)")
+            elif diff.max() < 0.1:
+                print("  Numerical verification ACCEPTABLE (error < 0.1, likely bfloat16 casting)")
+            else:
+                print("  WARNING: Large numerical error, check export configuration")
+        except ImportError:
+            print("  onnxruntime not installed, skipping numerical verification")
+        except Exception as e:
+            print(f"  onnxruntime verification failed (expected for BF16 models): {e}")
+
+    except Exception as e:
+        print(f"  ONNX export failed: {e}")
+        print(f"  Error type: {type(e).__name__}")
+        import traceback
+        traceback.print_exc()
+
+        print("\n  Trying torch.jit.trace fallback...")
+        try:
+            with torch.no_grad():
+                traced = torch.jit.trace(wrapper, tuple(all_inputs))
+                torch.onnx.export(
+                    traced,
+                    tuple(all_inputs),
+                    onnx_path,
+                    input_names=input_names,
+                    output_names=output_names,
+                    opset_version=17,
+                    do_constant_folding=True,
+                )
+            print(f"  torch.jit.trace fallback succeeded: {onnx_path}")
+        except Exception as e2:
+            print(f"  torch.jit.trace fallback also failed: {e2}")
+
+    print("\nDone.")
+
+
+if __name__ == "__main__":
+    main()
