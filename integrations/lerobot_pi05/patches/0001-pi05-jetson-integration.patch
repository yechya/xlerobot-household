+
+    print("\n" + "=" * 70)
+    print("智能摄像头录制测试")
+    print("=" * 70)
+    print(f"检测到 {len(available_cameras)} 个可用摄像头")
+    print(f"录制时长: 5秒")
+    print(f"输出目录: {os.path.abspath(output_dir)}")
