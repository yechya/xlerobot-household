+#!/usr/bin/env python3
+"""
+Pi0.5 TRT 精度验证 — 用合成随机数据对比 PyTorch vs TRT 输出。
+
+与 SmolVLA 的 verify_trt_deterministic.py 功能一致，适配 Pi0.5：
+- 完全复用 denoise_step 推理路径
+- 对比 TRT 和 PyTorch 每一步去噪的输出
+- 验证 cosine similarity、relative L2、max abs diff
+
+用法:
+  cd /path/to/lerobot_ycy
+  source /path/to/miniconda3/etc/profile.d/conda.sh
+  conda activate lerobot_ycy
+  PYTHONPATH="src:/path/to/lerobot_0.3.3_pzy/thrid-party/XLeRobot/software/src:$PYTHONPATH" \
+  python scripts/verify_pi05_trt.py \
+    --policy_path /path/to/lerobot_0.3.3_pzy/outputs/train/test/pi05_pick_up_bottle_three_pi_fixed/checkpoints/030000/pretrained_model \
+    --engine_path outputs/trt_engines/pi05_pick_up_bottle_three_pi_fixed/pi05_expert_decode.engine
+"""
+
+import argparse
+import json
+import time
+import numpy as np
+import torch
+from pathlib import Path
+
+
+def parse_args():
+    p = argparse.ArgumentParser()
+    p.add_argument("--policy_path", type=str, required=True)
+    p.add_argument("--engine_path", type=str, required=True)
+    p.add_argument("--device", type=str, default="cuda")
+    p.add_argument("--num_runs", type=int, default=5,
+                   help="验证次数（不同随机种子）")
+    p.add_argument("--output", type=str, default=None,
+                   help="结果输出路径 (默认: 与 engine_path 同目录)")
+    return p.parse_args()
+
+
+def compute_metrics(a, b):
+    """Compute per-step similarity metrics."""
+    a_f = a.flatten().float()
+    b_f = b.flatten().float()
+
+    cos_sim = torch.dot(a_f, b_f) / (torch.norm(a_f) * torch.norm(b_f))
+    rel_l2 = torch.norm(a_f - b_f) / torch.norm(a_f)
+    max_abs = (a_f - b_f).abs().max()
+    mean_abs = (a_f - b_f).abs().mean()
+
+    return {
+        "cosine_similarity": cos_sim.item(),
+        "relative_l2": rel_l2.item(),
+        "max_abs_diff": max_abs.item(),
+        "mean_abs_diff": mean_abs.item(),
+    }
+
+
+def main():
+    args = parse_args()
+    device = args.device
+
+    # Default output path
+    out_path = args.output
+    if out_path is None:
+        engine_dir = Path(args.engine_path).parent
+        out_path = str(engine_dir / "verify_deterministic_results.json")
+
+    print("=" * 70)
+    print("Pi0.5 TRT 确定性验证 (合成数据)")
+    print("=" * 70)
+
+    # Load model
+    print("\n[1/4] Loading model...")
+    from lerobot.policies.pi05 import PI05Policy
+    from lerobot.policies.pi05.modeling_pi05 import make_att_2d_masks
+
+    policy = PI05Policy.from_pretrained(args.policy_path)
+    policy.to(device)
+    policy.eval()
+    model = policy.model
+    cfg = model.config
+
+    # Enable TRT
+    cfg.use_tensorrt = True
+    cfg.tensorrt_engine_path = args.engine_path
+    model._trt_engine = None
+    from lerobot.policies.pi05.trt_expert_decoder import TRTExpertDecoder
+    model._trt_engine = TRTExpertDecoder(args.engine_path, device)
+
+    print(f"  chunk_size={cfg.chunk_size}, max_action_dim={cfg.max_action_dim}")
+
+    # Run verification multiple times with different seeds
+    print("\n[2/4] Running verification...")
+    all_results = []
+    overall_metrics = []
+
+    for run_idx in range(args.num_runs):
+        seed = 42 + run_idx
+        torch.manual_seed(seed)
+        np.random.seed(seed)
+
+        print(f"\n  --- Run {run_idx + 1}/{args.num_runs} (seed={seed}) ---")
+
+        # Build dummy inputs
+        batch_size = 1
+        chunk_size = cfg.chunk_size
+        max_action_dim = cfg.max_action_dim
+        tokenizer_max_length = cfg.tokenizer_max_length
+
+        # Dummy images
+        img = torch.randn(batch_size, 3, 224, 224, device=device)
+        images = [img, img.clone(), img.clone()]
+        img_masks = [torch.ones(batch_size, dtype=torch.bool, device=device) for _ in range(3)]
+
+        # Dummy language
+        tokens = torch.ones(batch_size, tokenizer_max_length, dtype=torch.long, device=device)
+        masks = torch.ones(batch_size, tokenizer_max_length, dtype=torch.bool, device=device)
+
+        # Prefix + prefill
+        with torch.no_grad():
+            prefix_embs, prefix_pad_masks, prefix_att_masks = model.embed_prefix(
+                images, img_masks, tokens, masks
+            )
+            prefix_att_2d_masks = make_att_2d_masks(prefix_pad_masks, prefix_att_masks)
+            prefix_position_ids = torch.cumsum(prefix_pad_masks, dim=1) - 1
+            prefix_att_2d_masks_4d = model._prepare_attention_masks_4d(prefix_att_2d_masks)
+
+            model.paligemma_with_expert.paligemma.language_model.config._attn_implementation = "eager"
+            _, past_key_values = model.paligemma_with_expert.forward(
+                attention_mask=prefix_att_2d_masks_4d,
+                position_ids=prefix_position_ids,
+                past_key_values=None,
+                inputs_embeds=[prefix_embs, None],
+                use_cache=True,
+            )
+
+        prefix_len = prefix_embs.shape[1]
+        print(f"    prefix_len={prefix_len}")
+
+        # Run a full denoising loop (10 steps) with PyTorch and TRT
+        noise = model.sample_noise((batch_size, chunk_size, max_action_dim), device)
+
+        # PyTorch path
+        x_t_pt = noise.clone()
+        # Deep copy KV cache for PyTorch
+        if hasattr(past_key_values, "key_cache"):
+            kv_pt = type(past_key_values)()
+            for i in range(len(past_key_values.key_cache)):
+                kv_pt.update(
+                    past_key_values.key_cache[i].clone(),
+                    past_key_values.value_cache[i].clone(),
+                    layer_idx=i,
+                )
+        else:
+            kv_pt = {i: {"key_states": past_key_values[i][0].clone(),
+                          "value_states": past_key_values[i][1].clone()}
+                     for i in past_key_values}
+
+        # TRT path
+        x_t_trt = noise.clone()
+        if hasattr(past_key_values, "key_cache"):
+            kv_trt = type(past_key_values)()
+            for i in range(len(past_key_values.key_cache)):
+                kv_trt.update(
+                    past_key_values.key_cache[i].clone(),
+                    past_key_values.value_cache[i].clone(),
+                    layer_idx=i,
+                )
+        else:
+            kv_trt = {i: {"key_states": past_key_values[i][0].clone(),
+                           "value_states": past_key_values[i][1].clone()}
+                      for i in past_key_values}
+
+        dt = -1.0 / cfg.num_inference_steps
+        step_metrics = []
+
+        for step in range(cfg.num_inference_steps):
+            time_val = 1.0 + step * dt
+            time_tensor = torch.tensor(time_val, dtype=torch.float32, device=device).expand(batch_size)
+
+            # PyTorch denoise step
+            with torch.no_grad():
+                # Temporarily disable TRT
+                trt_saved = model._trt_engine
+                model._trt_engine = None
+
+                v_t_pt = model.denoise_step(
+                    prefix_pad_masks=prefix_pad_masks,
+                    past_key_values=kv_pt,
+                    x_t=x_t_pt,
+                    timestep=time_tensor,
+                )
+
+                # Restore TRT
+                model._trt_engine = trt_saved
+
+                # TRT denoise step
+                v_t_trt = model.denoise_step(
+                    prefix_pad_masks=prefix_pad_masks,
+                    past_key_values=kv_trt,
+                    x_t=x_t_trt,
+                    timestep=time_tensor,
+                )
+
+            # Metrics
+            step_m = compute_metrics(v_t_pt, v_t_trt)
+            step_metrics.append(step_m)
+
+            # Euler update
+            x_t_pt = x_t_pt + dt * v_t_pt
+            x_t_trt = x_t_trt + dt * v_t_trt
+
+        # Summary for this run
+        cos_sims = [m["cosine_similarity"] for m in step_metrics]
+        max_diffs = [m["max_abs_diff"] for m in step_metrics]
+        rel_l2s = [m["relative_l2"] for m in step_metrics]
+
+        run_summary = {
+            "seed": seed,
+            "cosine_similarity": {"mean": np.mean(cos_sims), "min": np.min(cos_sims)},
+            "relative_l2": {"mean": np.mean(rel_l2s), "max": np.max(rel_l2s)},
+            "max_abs_diff": {"mean": np.mean(max_diffs), "max": np.max(max_diffs)},
+            "per_step": step_metrics,
+        }
+        all_results.append(run_summary)
+
+        overall_metrics.append({
+            "cos_sim_mean": np.mean(cos_sims),
+            "cos_sim_min": np.min(cos_sims),
+            "rel_l2_mean": np.mean(rel_l2s),
+            "rel_l2_max": np.max(rel_l2s),
+            "max_abs_max": np.max(max_diffs),
+        })
+
+        status = "PASS" if np.min(cos_sims) > 0.99 and np.max(rel_l2s) < 0.05 else "WARN"
+        print(f"    cos_sim: mean={np.mean(cos_sims):.6f}, min={np.min(cos_sims):.6f}")
+        print(f"    rel_l2:  mean={np.mean(rel_l2s):.6f}, max={np.max(rel_l2s):.6f}")
+        print(f"    max_abs_diff: mean={np.mean(max_diffs):.6f}, max={np.max(max_diffs):.6f}")
+        print(f"    → {status}")
+
+    # Overall summary
+    print("\n[3/4] Overall Summary")
+    print("=" * 70)
+    cos_all = [m["cos_sim_min"] for m in overall_metrics]
+    l2_all = [m["rel_l2_max"] for m in overall_metrics]
+    diff_all = [m["max_abs_max"] for m in overall_metrics]
+
+    print(f"  Worst cosine_sim:  {np.min(cos_all):.6f}")
+    print(f"  Worst relative_l2: {np.max(l2_all):.6f}")
+    print(f"  Worst max_abs_diff:{np.max(diff_all):.6f}")
+
+    all_pass = all(c > 0.99 for c in cos_all) and all(l < 0.05 for l in l2_all)
+    print(f"\n  Final: {'✅ PASS' if all_pass else '⚠️  WARN'}")
+
+    # Save results
+    print(f"\n[4/4] Saving results to {out_path}...")
+    summary = {
+        "engine_path": args.engine_path,
+        "num_runs": args.num_runs,
+        "overall_metrics": {
+            "cosine_similarity": {"min": float(np.min(cos_all))},
+            "relative_l2": {"max": float(np.max(l2_all))},
+            "max_abs_diff": {"max": float(np.max(diff_all))},
+        },
+        "per_run": all_results,
+        "verdict": "PASS" if all_pass else "WARN",
+    }
+    with open(out_path, "w") as f:
+        json.dump(summary, f, indent=2)
+    print("  Done.")
+
+
+if __name__ == "__main__":
+    main()
