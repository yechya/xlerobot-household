+        threads.append(thread)
+        time.sleep(0.1)  # 稍微延迟启动
+
+    print("所有线程已启动，正在录制...")
+    print()
+
+    # 等待所有线程完成
+    for thread in threads:
+        thread.join()
+
+    # 收集结果
+    print("=" * 70)
+    print("录制完成！结果汇总:")
+    print("=" * 70)
+
+    results = {}
+    for _ in range(len(available_cameras[:6])):
