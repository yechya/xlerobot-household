+            # 获取设备信息
+            width = int(cap.get(cv2.CAP_PROP_FRAME_WIDTH))
+            height = int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT))
+            fps = cap.get(cv2.CAP_PROP_FPS)
+
+            available_cameras.append({
+                "index": i,
+                "width": width,
+                "height": height,
+                "fps": fps
+            })
+            print(f"  ✓ 找到摄像头设备 /dev/video{i} - {width}x{height} @ {fps}fps")
+
+            cap.release()
+        else:
+            # print(f"  ✗ /dev/video{i} 不可用")
+            pass
+
+    return available_cameras
+
+def record_camera(camera_config, output_dir, result_queue, stop_event):
+    """录制单个摄像头的线程函数"""
+    index = camera_config["index"]
+    width = camera_config["width"]
+    height = camera_config["height"]
+    fps = camera_config["fps"]
+    name = camera_config.get("name", f"camera_{index}")
+
+    cap = cv2.VideoCapture(index)
+
+    if not cap.isOpened():
+        result_queue.put((name, False, f"无法打开摄像头 {index}"))
+        return
+
+    # 设置分辨率和帧率
+    cap.set(cv2.CAP_PROP_FRAME_WIDTH, width)
+    cap.set(cv2.CAP_PROP_FRAME_HEIGHT, height)
+    cap.set(cv2.CAP_PROP_FPS, fps)
+
+    # 获取实际参数
+    actual_width = int(cap.get(cv2.CAP_PROP_FRAME_WIDTH))
+    actual_height = int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT))
+    actual_fps = cap.get(cv2.CAP_PROP_FPS)
+
+    print(f"[{name}] 摄像头已打开 - 分辨率: {actual_width}x{actual_height}, 目标FPS: {fps}, 实际FPS: {actual_fps}")
+
+    # 创建输出文件
+    output_file = os.path.join(output_dir, f"{name}.mp4")
+    fourcc = cv2.VideoWriter_fourcc(*'mp4v')
+    out = cv2.VideoWriter(output_file, fourcc, 20, (actual_width, actual_height))
+
+    if not out.isOpened():
+        result_queue.put((name, False, f"无法创建视频文件 {output_file}"))
+        cap.release()
+        return
+
+    print(f"[{name}] 开始录制到: {output_file}")
+    frame_count = 0
+    start_time = time.time()
+
+    try:
+        while not stop_event.is_set():
+            ret, frame = cap.read()
+            if not ret:
+                print(f"[{name}] ✗ 无法读取帧")
+                break
+
+            # 写入视频文件
+            out.write(frame)
+            frame_count += 1
+
+            # 5秒后自动停止
+            elapsed = time.time() - start_time
+            if elapsed >= 5:
+                break
+
+    except Exception as e:
+        result_queue.put((name, False, f"录制过程中发生错误: {str(e)}"))
+    finally:
+        # 清理资源
+        cap.release()
+        out.release()
+
+        # 记录结果
+        elapsed = time.time() - start_time
+        actual_fps_achieved = frame_count / elapsed if elapsed > 0 else 0
+        result_queue.put((name, True, {
+            'frames': frame_count,
+            'elapsed': elapsed,
+            'fps_achieved': actual_fps_achieved,
+            'output_file': output_file,
+            'device': f'/dev/video{index}'
+        }))
+
