+wandb>=0.20.0,<0.22.0
+draccus==0.10.0
+gymnasium>=1.1.1,<2.0.0
+
+# --- Manually Pinned for Compatibility ---
+# Pinned to a known-good version compatible with numpy<2.0
+opencv-python-headless==4.9.0.80
+
+# --- Other Dependencies ---
+av>=15.0.0,<16.0.0
