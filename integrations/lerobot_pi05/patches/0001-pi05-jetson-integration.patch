+#!/usr/bin/env python3
+"""
+Pi0.5 TRT 真实数据验证 — 用真实录制的观测数据，对比 PyTorch vs TRT 输出。
+
+完全复用推理路径：observation dict → preprocessor → select_action → postprocessor
+与 eval_fixed.sh 中 predict_action() 一致。
+
+基于 SmolVLA 的 verify_trt_with_real_data.py 适配，Pi0.5 差异：
+  - Policy: PI05Policy（非 SmolVLAPolicy）
+  - State: 12 维（双 SO-100 臂）
+  - TRT 通过 config.use_tensorrt 控制，不需要手动设置 trt_expert_decoder
+
+用法:
+  cd /path/to/lerobot_ycy
+  source /path/to/miniconda3/etc/profile.d/conda.sh
+  conda activate lerobot_ycy
+
+  PYTHONPATH="src:/path/to/lerobot_0.3.3_pzy/thrid-party/XLeRobot/software/src:$PYTHONPATH" \
+  python scripts/verify_trt_with_real_data_pi05.py \
+    --policy_path <训练后模型路径> \
+    --engine_path <engine路径> \
+    --dataset_path <录制数据集路径> \
+    --task "put the bottle into the basket in front of you" \
+    --num_frames 20
+"""
+
+import argparse
+import copy
+import json
+import time
+import numpy as np
+import torch
+import av
+import pyarrow.parquet as pq
+from pathlib import Path
+
+
+def parse_args():
+    p = argparse.ArgumentParser()
+    p.add_argument("--policy_path", type=str, required=True)
+    p.add_argument("--engine_path", type=str, required=True)
+    p.add_argument("--dataset_path", type=str, required=True)
+    p.add_argument("--task", type=str, default="put the bottle into the basket in front of you")
+    p.add_argument("--num_frames", type=int, default=20)
+    p.add_argument("--device", type=str, default="cuda")
+    p.add_argument("--output", type=str, default=None,
+                   help="结果输出路径 (默认: 与 engine_path 同目录下的 verify_real_data_results.json)")
+    return p.parse_args()
+
+
+def load_video_frames(video_path, num_frames):
+    frames = []
+    container = av.open(video_path)
+    stream = container.streams.video[0]
+    for i, frame in enumerate(container.decode(stream)):
+        if i >= num_frames:
+            break
+        frames.append(np.array(frame.to_ndarray(format="rgb24")))
+    container.close()
+    return frames
+
+
+def predict_action_raw(observation, policy, device, preprocessor, postprocessor):
+    """完全复用 select_action 的推理路径，返回 raw action tensor (action_dim,)."""
+    observation = copy.copy(observation)
+    task = observation.pop("task", None)
+    with torch.inference_mode():
+        for name in observation:
+            observation[name] = torch.from_numpy(observation[name])
+            if "image" in name:
+                observation[name] = observation[name].type(torch.float32) / 255
+                observation[name] = observation[name].permute(2, 0, 1).contiguous()
+            observation[name] = observation[name].unsqueeze(0)
+            observation[name] = observation[name].to(device)
+
+        observation["task"] = task if task else ""
+        observation["robot_type"] = ""
+
+        observation = preprocessor(observation)
+        action = policy.select_action(observation)
+        action = postprocessor(action)
+        action = action.squeeze(0).to("cpu")
+    return action
+
+
+def main():
+    args = parse_args()
+    device = torch.device(args.device)
+
+    print("=" * 70)
+    print("Pi0.5 TRT Verification with Real Recorded Data")
+    print("Path: observation → preprocessor → select_action → postprocessor")
+    print("=" * 70)
+
+    # [1] Load policy + preprocessor + postprocessor
+    print("\n[1/5] Loading policy + preprocessor/postprocessor...")
+    from lerobot.policies.pi05.modeling_pi05 import PI05Policy
+    policy = PI05Policy.from_pretrained(args.policy_path)
+    policy.to(device)
+    policy.eval()
+
+    from lerobot.policies.factory import make_pre_post_processors
+    preprocessor, postprocessor = make_pre_post_processors(
+        policy.config,
+        pretrained_path=args.policy_path,
+    )
+    print("  Preprocessor steps:")
+    for s in preprocessor.steps:
+        print(f"    {type(s).__name__}")
+    print("  Postprocessor steps:")
+    for s in postprocessor.steps:
+        print(f"    {type(s).__name__}")
+
+    # [2] Load TRT engine
+    print("\n[2/5] Loading TRT engine...")
+    from lerobot.policies.pi05.trt_expert_decoder import TRTExpertDecoder
+    trt_decoder = TRTExpertDecoder(args.engine_path, device=args.device)
+
+    # [3] Load recorded data
+    print("\n[3/5] Loading recorded observations...")
+    ds_path = Path(args.dataset_path)
+    table = pq.read_table(str(ds_path / "data/chunk-000/file-000.parquet"))
+    states = np.stack(table.column("observation.state").to_numpy().tolist())
+    recorded_actions = np.stack(table.column("action").to_numpy().tolist())
+    total_frames = min(args.num_frames, len(states))
+    print(f"  Frames available: {len(states)}, using: {total_frames}")
+
+    cam_names = ["head_cam", "left_cam", "right_cam"]
+    videos = {}
+    for cam in cam_names:
+        key = f"observation.images.{cam}"
+        vp = str(ds_path / f"videos/{key}/chunk-000/file-000.mp4")
+        videos[key] = load_video_frames(vp, total_frames)
+        print(f"  {cam}: {len(videos[key])} frames loaded")
+
+    # [4] Build observations (same format as robot sends)
+    print("\n[4/5] Building observations...")
+
+    def make_observation(frame_idx):
+        """构建与机器人采集时格式一致的 observation dict."""
+        obs = {}
+        for cam in cam_names:
+            key = f"observation.images.{cam}"
+            obs[key] = videos[key][frame_idx]
+        obs["observation.state"] = states[frame_idx].astype(np.float32)
+        obs["task"] = args.task
+        return obs
+
+    # [5] Run inference
+    print(f"\n[5/5] Running PyTorch vs TRT inference on {total_frames} frames...")
+    results = []
+
+    # Warm up (both paths)
+    dummy_obs = make_observation(0)
+    _ = predict_action_raw(dummy_obs, policy, device, preprocessor, postprocessor)
+    policy._action_queue.clear()
+
+    # Enable TRT for warmup
+    policy.config.use_tensorrt = True
+    policy.config.tensorrt_engine_path = args.engine_path
+    policy.model._trt_engine = trt_decoder
+    _ = predict_action_raw(dummy_obs, policy, device, preprocessor, postprocessor)
+    policy._action_queue.clear()
+
+    py_times = []
+    trt_times = []
+
+    for i in range(total_frames):
+        obs = make_observation(i)
+
+        # --- PyTorch path ---
+        policy.config.use_tensorrt = False
+        policy.model._trt_engine = None
+        policy._action_queue.clear()
+        for k in list(policy._queues.keys()):
+            policy._queues[k].clear()
+
+        t0 = time.perf_counter()
+        py_action = predict_action_raw(obs, policy, device, preprocessor, postprocessor)
+        py_time = (time.perf_counter() - t0) * 1000
+        py_times.append(py_time)
+
+        # --- TRT path ---
+        policy.config.use_tensorrt = True
+        policy.config.tensorrt_engine_path = args.engine_path
+        policy.model._trt_engine = trt_decoder
+        policy._queues["action"].clear()
+        for k in list(policy._queues.keys()):
+            if k != "action":
+                policy._queues[k].clear()
+
+        t0 = time.perf_counter()
+        trt_action = predict_action_raw(obs, policy, device, preprocessor, postprocessor)
+        trt_time = (time.perf_counter() - t0) * 1000
+        trt_times.append(trt_time)
+
+        py_np = py_action.numpy()
+        trt_np = trt_action.numpy()
+
+        diff = np.abs(py_np - trt_np)
+        norm_py = np.linalg.norm(py_np)
+        norm_trt = np.linalg.norm(trt_np)
+        cos_sim = np.dot(py_np, trt_np) / (norm_py * norm_trt + 1e-8) if norm_py > 1e-8 and norm_trt > 1e-8 else 1.0
+        rel_l2 = np.linalg.norm(py_np - trt_np) / (norm_py + 1e-8)
+
+        result = {
+            "frame": i,
+            "cosine_similarity": float(cos_sim),
+            "relative_l2": float(rel_l2),
+            "max_abs_diff": float(diff.max()),
+            "mean_abs_diff": float(diff.mean()),
+            "py_action_range": [float(py_np.min()), float(py_np.max())],
+            "trt_action_range": [float(trt_np.min()), float(trt_np.max())],
+            "py_time_ms": float(py_time),
+            "trt_time_ms": float(trt_time),
+            "per_joint_diff": [float(d) for d in diff],
+        }
+        results.append(result)
+
+        print(f"  Frame {i:3d}: cos_sim={cos_sim:.6f}, rel_l2={rel_l2:.6f}, "
+              f"max_diff={diff.max():.4f}, mean_diff={diff.mean():.4f} | "
+              f"py=[{py_np.min():.1f},{py_np.max():.1f}] trt=[{trt_np.min():.1f},{trt_np.max():.1f}] | "
+              f"time: py={py_time:.0f}ms trt={trt_time:.0f}ms")
+
+    # Summary
+    print("\n" + "=" * 70)
+    print("SUMMARY")
+    print("=" * 70)
+
+    cos_sims = [r["cosine_similarity"] for r in results]
+    rel_l2s = [r["relative_l2"] for r in results]
+    max_diffs = [r["max_abs_diff"] for r in results]
+    mean_diffs = [r["mean_abs_diff"] for r in results]
+
+    print(f"\n  Frames tested: {total_frames}")
+    print(f"  Cosine Similarity: mean={np.mean(cos_sims):.6f}, worst={np.min(cos_sims):.6f}")
+    print(f"  Relative L2:       mean={np.mean(rel_l2s):.6f}, worst={np.max(rel_l2s):.6f}")
+    print(f"  Max Abs Diff:      mean={np.mean(max_diffs):.4f}, worst={np.max(max_diffs):.4f}")
+    print(f"  Mean Abs Diff:     mean={np.mean(mean_diffs):.4f}, worst={np.max(mean_diffs):.4f}")
+
+    print(f"\n  PyTorch time: mean={np.mean(py_times):.0f}ms")
+    print(f"  TRT time:     mean={np.mean(trt_times):.0f}ms")
+    print(f"  Speedup: {np.mean(py_times)/np.mean(trt_times):.1f}x")
+
+    # Per-joint analysis
+    joint_names = [
+        "left_shoulder_pan", "left_shoulder_lift", "left_elbow_flex",
+        "left_wrist_flex", "left_wrist_roll", "left_gripper",
+        "right_shoulder_pan", "right_shoulder_lift", "right_elbow_flex",
+        "right_wrist_flex", "right_wrist_roll", "right_gripper",
+    ]
+    print(f"\n  Per-joint mean abs diff (across all frames):")
+    for j in range(min(12, len(joint_names))):
+        if j < len(results[0]["per_joint_diff"]):
+            j_diffs = [r["per_joint_diff"][j] for r in results]
+            print(f"    {joint_names[j]:>22s}: {np.mean(j_diffs):.4f} (worst: {np.max(j_diffs):.4f})")
+
+    cos_pass = np.min(cos_sims) > 0.99
+    l2_pass = np.max(rel_l2s) < 0.05
+    print(f"\n  Cosine similarity > 0.99: {'✅ PASS' if cos_pass else '❌ FAIL'}")
+    print(f"  Relative L2 < 0.05:       {'✅ PASS' if l2_pass else '❌ FAIL'}")
+    print(f"  Overall: {'✅ PASS' if (cos_pass and l2_pass) else '⚠️  FAIL - investigate differences'}")
+
+    # Save
+    output = {
+        "config": {
+            "policy_path": args.policy_path,
+            "engine_path": args.engine_path,
+            "dataset_path": args.dataset_path,
+            "task": args.task,
+            "num_frames": total_frames,
+        },
+        "summary": {
+            "cosine_similarity": {"mean": float(np.mean(cos_sims)), "worst": float(np.min(cos_sims))},
+            "relative_l2": {"mean": float(np.mean(rel_l2s)), "worst": float(np.max(rel_l2s))},
+            "max_abs_diff": {"mean": float(np.mean(max_diffs)), "worst": float(np.max(max_diffs))},
+            "mean_abs_diff": {"mean": float(np.mean(mean_diffs)), "worst": float(np.max(mean_diffs))},
+            "py_time_ms": float(np.mean(py_times)),
+            "trt_time_ms": float(np.mean(trt_times)),
+            "speedup": float(np.mean(py_times) / np.mean(trt_times)),
+            "cos_pass": bool(cos_pass),
+            "l2_pass": bool(l2_pass),
+        },
+        "per_frame": results,
+    }
+
+    import os
+    if args.output is None:
+        engine_dir = os.path.dirname(os.path.abspath(args.engine_path))
+        args.output = os.path.join(engine_dir, "verify_real_data_results.json")
+    os.makedirs(os.path.dirname(args.output) if os.path.dirname(args.output) else ".", exist_ok=True)
+    with open(args.output, "w") as f:
+        json.dump(output, f, indent=2, ensure_ascii=False)
+    print(f"\n  Results saved to: {args.output}")
+
+
+if __name__ == "__main__":
+    main()
