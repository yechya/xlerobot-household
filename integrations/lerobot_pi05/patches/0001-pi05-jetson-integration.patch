+    print()
+
+    if not has_gui:
+        print("无GUI支持，将静默录制5秒...")
+        print()
+    else:
+        response = input("是否开始录制？(y/N): ")
+        if response.lower() != 'y':
+            print("测试已取消")
+            return
+        print()
+
+    # 创建结果队列
+    result_queue = Queue()
+
+    # 使用传入的停止事件，如果没有则创建一个
+    if stop_event is None:
+        stop_event = threading.Event()
+
+    # 创建并启动线程
+    threads = []
+
+    print("启动录制线程...")
+    for i, cam in enumerate(available_cameras[:6], 1):  # 最多录6个摄像头
+        # 添加名称
+        cam["name"] = f"camera_{cam['index']}"
