diff --git a/scripts/async_inference_smooth.sh b/scripts/async_inference_smooth.sh
new file mode 100644
index 000000000..033ac0f87
--- /dev/null
+++ b/scripts/async_inference_smooth.sh
@@ -0,0 +1,63 @@
+#!/bin/bash
+
+source envs.sh
+export TORCHDYNAMO_DISABLE=1
+
+# 优化的异步推理脚本 - 平缓运动版本
+# 针对机械臂运动剧烈问题的解决方案
+
+echo "=== 启动策略服务器 ==="
+# 在后台启动策略服务器
+nohup python -m lerobot.async_inference.policy_server \
+    --host=127.0.0.1 \
+    --port=8080 \
+    --fps=15 \
+    --inference_latency=0.05 \
+    --obs_queue_timeout=1 \
+> /tmp/policy_server.log 2>&1 &
+
+SERVER_PID=$!
+echo "策略服务器 PID: $SERVER_PID"
+
+# 等待服务器启动
+sleep 5
+
+# 检查服务器是否正常启动
+if netstat -tuln | grep -q 8080; then
+    echo "✅ 策略服务器启动成功"
+else
+    echo "❌ 策略服务器启动失败"
+    kill $SERVER_PID 2>/dev/null
+    exit 1
+fi
+
+echo ""
+echo "=== 启动机器人客户端 (平缓运动模式) ==="
+python -m lerobot.async_inference.robot_client \
+    --server_address=127.0.0.1:8080 \
+    --robot.type=bi_so100_follower \
+    --robot.left_arm_port=/dev/ttyACM0 \
+    --robot.left_arm_max_relative_target=0.3 \
+    --robot.right_arm_port=/dev/ttyACM1 \
+    --robot.right_arm_max_relative_target=0.3 \
+    --robot.id=bimanual_follower0 \
+    --robot.cameras='{
+      "head_cam": {"type": "opencv", "index_or_path": 4, "width": 640, "height": 480, "fps": 15},
+      "left_cam": {"type": "opencv", "index_or_path": 0, "width": 640, "height": 480, "fps": 15},
+      "right_cam": {"type": "opencv", "index_or_path": 2, "width": 640, "height": 480, "fps": 15}
+    }' \
+    --task="fold the flattened rag" \
+    --policy.path=${LEROBOT_POLICY_ROOT:-$HOME/project/lerobot_0.3.3_pzy}/outputs/train/pi05_fold_simple/pretrained_model \
+    --policy.type=pi05 \
+    --policy.device=cuda \
+    --actions_per_chunk=50 \
+    --chunk_size_threshold=0.3 \
+    --aggregate_fn_name=conservative \
+    --fps=15 \
+    --debug_visualize_queue_size=True
+
+# 清理：停止策略服务器
+echo ""
+echo "=== 清理：停止策略服务器 ==="
+kill $SERVER_PID 2>/dev/null
+echo "策略服务器已停止"
diff --git a/scripts/build_trt_pi05_engine.sh b/scripts/build_trt_pi05_engine.sh
new file mode 100755
index 000000000..206cd179c
--- /dev/null
+++ b/scripts/build_trt_pi05_engine.sh
@@ -0,0 +1,188 @@
+#!/bin/bash
+# Build TensorRT Engine for Pi0.5 model
+#
+# Modes:
+#   --bf16    (default) Build BF16 engine (~819 MB, 10.1ms/step trtexec)
+#   --int8    Build INT8 engine from QDQ ONNX (requires calibration data)
+#
+# Output structure:
+#   outputs/trt_engines/<model_name>/
+#     pi05_expert_decode.onnx
+#     pi05_expert_decode.engine   (BF16)
+#     pi05_expert_decode_int8.onnx
+#     pi05_expert_decode_int8.engine   (INT8)
+#
+# Usage:
+#   bash scripts/build_trt_pi05_engine.sh           # BF16
+#   bash scripts/build_trt_pi05_engine.sh --int8    # INT8 (needs calibration dataset)
+#
+# IMPORTANT: Run from lerobot_ycy conda environment!
+
+set -e
+
+MODE="bf16"
+if [ "$1" == "--int8" ]; then
+  MODE="int8"
+  echo "===== Mode: INT8 (QDQ quantization) ====="
+else
+  echo "===== Mode: BF16 ====="
+fi
+
+# ===== Configuration =====
+POLICY_PATH="${LEROBOT_POLICY_ROOT:-$HOME/project/lerobot_0.3.3_pzy}/outputs/train/test/pi05_pick_up_bottle_three_pi_fixed/checkpoints/030000/pretrained_model"
+MODEL_NAME="pi05_pick_up_bottle_three_pi_fixed"
+TRT_DIR="outputs/trt_engines/${MODEL_NAME}"
+ONNX_PATH="${TRT_DIR}/pi05_expert_decode.onnx"
+
+if [ "$MODE" == "int8" ]; then
+  ENGINE_PATH="${TRT_DIR}/pi05_expert_decode_int8.engine"
+  INT8_ONNX_PATH="${TRT_DIR}/pi05_expert_decode_int8.onnx"
+
+  # INT8 mode requires calibration dataset
+  DATASET_PATH="${DATASET_PATH:-}"
+  TASK="${TASK:-put the bottle into the basket in front of you}"
+  NUM_FRAMES="${NUM_FRAMES:-20}"
+
+  if [ -z "$DATASET_PATH" ]; then
+    echo "Error: INT8 mode requires --dataset_path."
+    echo "Usage: DATASET_PATH=<path> bash scripts/build_trt_pi05_engine.sh --int8"
+    exit 1
+  fi
+else
+  ENGINE_PATH="${TRT_DIR}/pi05_expert_decode.engine"
+fi
+
+# ===== Python paths =====
+export PYTHONPATH="src:${LEROBOT_POLICY_ROOT:-$HOME/project/lerobot_0.3.3_pzy}/thrid-party/XLeRobot/software/src:$PYTHONPATH"
+
+# ===== Check prerequisites =====
+if [ ! -d "$POLICY_PATH" ]; then
+  echo "Error: Model not found at $POLICY_PATH"
+  exit 1
+fi
+
+if [ -f "$ENGINE_PATH" ]; then
+  echo "Engine already exists: $ENGINE_PATH"
+  echo "To rebuild: rm $ENGINE_PATH"
+  exit 0
+fi
+
+# ===== Ensure ONNX exists =====
+if [ ! -f "$ONNX_PATH" ]; then
+  echo "===== [0] ONNX Export (required) ====="
+  mkdir -p "$TRT_DIR"
+
+  python scripts/export_trt_pi05_engine.py \
+    --policy_path "$POLICY_PATH" \
+    --output_dir "$TRT_DIR"
+
+  if [ ! -f "$ONNX_PATH" ]; then
+    echo "Error: ONNX export failed, file not created: $ONNX_PATH"
+    exit 1
+  fi
+else
+  echo "===== [0] ONNX already exists: $ONNX_PATH ====="
+fi
+
+# ===== Branch by mode =====
+if [ "$MODE" == "int8" ]; then
+  # ===== INT8: Run quantize_onnx_int8_pi05.py =====
+  echo ""
+  echo "===== [1/1] INT8 Quantization + Engine Build ====="
+  echo "  Dataset: $DATASET_PATH"
+  echo "  Task: $TASK"
+  echo "  Frames: $NUM_FRAMES"
+
+  LD_PRELOAD="${LD_PRELOAD:-/usr/lib/aarch64-linux-gnu/libnvinfer.so.10}" \
+  python scripts/quantize_onnx_int8_pi05.py \
+    --policy_path "$POLICY_PATH" \
+    --onnx_path "$ONNX_PATH" \
+    --dataset_path "$DATASET_PATH" \
+    --task "$TASK" \
+    --num_frames "$NUM_FRAMES"
+
+  echo ""
+  echo "===== Done ====="
+  echo "INT8 ONNX:  $INT8_ONNX_PATH ($(du -h "$INT8_ONNX_PATH" | cut -f1))"
+  echo "INT8 engine: $ENGINE_PATH ($(du -h "$ENGINE_PATH" | cut -f1))"
+  echo ""
+  echo "To verify accuracy:"
+  echo "  python scripts/verify_trt_with_real_data_pi05.py \\"
+  echo "    --policy_path $POLICY_PATH \\"
+  echo "    --engine_path $ENGINE_PATH \\"
+  echo "    --dataset_path $DATASET_PATH \\"
+  echo '    --task "'"$TASK"'"'
+  echo ""
+  echo "To use in eval, add to lerobot-record command:"
+  echo "  --policy.use_tensorrt=true"
+  echo "  --policy.tensorrt_engine_path=${ENGINE_PATH}"
+else
+  # ===== BF16: Direct trtexec build =====
+  echo ""
+  echo "===== [1/2] BF16 TRT Engine Build ====="
+
+  # Auto-detect shapes from ONNX model and config
+  SHAPES=$(python -c "
+import onnx, json
+model = onnx.load('$ONNX_PATH')
+with open('$POLICY_PATH/config.json') as f:
+    cfg = json.load(f)
+chunk_size = cfg['chunk_size']
+prefix_len = None
+kv_head_dim = None
+num_kv_heads = None
+for inp in model.graph.input:
+    if inp.name == 'kv_layer0_key':
+        dims = [d.dim_value for d in inp.type.tensor_type.shape.dim]
+        num_kv_heads = dims[1]
+        prefix_len = dims[2]
+        kv_head_dim = dims[3]
+        break
+    elif inp.name == 'suffix_embs':
+        dims = [d.dim_value for d in inp.type.tensor_type.shape.dim]
+        hidden_size = dims[2] if dims[2] > 0 else 1024
+
+num_layers = sum(1 for inp in model.graph.input if inp.name.startswith('kv_layer'))
+num_layers = num_layers // 2
+
+total_len = prefix_len + chunk_size
+print(f'{prefix_len} {chunk_size} {total_len} {num_kv_heads} {kv_head_dim} {num_layers} {hidden_size}')
+")
+
+  PREFIX_LEN=$(echo $SHAPES | awk '{print $1}')
+  CHUNK_SIZE=$(echo $SHAPES | awk '{print $2}')
+  ATT_TOTAL=$(echo $SHAPES | awk '{print $3}')
+  NUM_KV_HEADS=$(echo $SHAPES | awk '{print $4}')
+  KV_HEAD_DIM=$(echo $SHAPES | awk '{print $5}')
+  NUM_LAYERS=$(echo $SHAPES | awk '{print $6}')
+  HIDDEN_SIZE=$(echo $SHAPES | awk '{print $7}')
+
+  echo "  prefix_len=$PREFIX_LEN, chunk_size=$CHUNK_SIZE, total_len=$ATT_TOTAL"
+  echo "  num_layers=$NUM_LAYERS, kv_heads=$NUM_KV_HEADS, head_dim=$KV_HEAD_DIM"
+  echo "  hidden_size=$HIDDEN_SIZE"
+
+  KV_SHAPES=""
+  for i in $(seq 0 $((NUM_LAYERS - 1))); do
+    KV_SHAPES="${KV_SHAPES},kv_layer${i}_key:1x${NUM_KV_HEADS}x${PREFIX_LEN}x${KV_HEAD_DIM},kv_layer${i}_value:1x${NUM_KV_HEADS}x${PREFIX_LEN}x${KV_HEAD_DIM}"
+  done
+
+  ADARMS_SHAPE="adarms_cond:1x${HIDDEN_SIZE}"
+
+  echo "  Building TRT engine with trtexec --bf16..."
+  echo "  This may take several minutes..."
+
+  /usr/src/tensorrt/bin/trtexec \
+    --onnx="$ONNX_PATH" --saveEngine="$ENGINE_PATH" \
+    --bf16 --memPoolSize=workspace:2048 \
+    --minShapes="suffix_embs:1x${CHUNK_SIZE}x${HIDDEN_SIZE},attention_mask:1x1x${CHUNK_SIZE}x${ATT_TOTAL},position_ids:1x${CHUNK_SIZE},${ADARMS_SHAPE}${KV_SHAPES}" \
+    --optShapes="suffix_embs:1x${CHUNK_SIZE}x${HIDDEN_SIZE},attention_mask:1x1x${CHUNK_SIZE}x${ATT_TOTAL},position_ids:1x${CHUNK_SIZE},${ADARMS_SHAPE}${KV_SHAPES}" \
+    --maxShapes="suffix_embs:1x${CHUNK_SIZE}x${HIDDEN_SIZE},attention_mask:1x1x${CHUNK_SIZE}x${ATT_TOTAL},position_ids:1x${CHUNK_SIZE},${ADARMS_SHAPE}${KV_SHAPES}"
+
+  echo ""
+  echo "===== Done ====="
+  echo "Engine: $ENGINE_PATH ($(du -h "$ENGINE_PATH" | cut -f1))"
+  echo ""
+  echo "To use in eval, add to lerobot-record command:"
+  echo "  --policy.use_tensorrt=true"
+  echo "  --policy.tensorrt_engine_path=outputs/trt_engines/${MODEL_NAME}/pi05_expert_decode.engine"
+fi
diff --git a/scripts/capture_calib_samples_pi05.py b/scripts/capture_calib_samples_pi05.py
new file mode 100644
index 000000000..64b2c8547
--- /dev/null
+++ b/scripts/capture_calib_samples_pi05.py
@@ -0,0 +1,131 @@
+#!/usr/bin/env python3
+"""Capture calibration samples from Pi0.5 policy using recorded dataset.
+Saves to .npz for later INT8 quantization.
+"""
+import argparse
+import logging
+import os
+import time
+import numpy as np
+import torch
+import av
+import pyarrow.parquet as pq
+from pathlib import Path
+
+logging.basicConfig(level=logging.INFO, format="%(asctime)s %(levelname)s %(message)s")
+logger = logging.getLogger(__name__)
+
+
+def main():
+    p = argparse.ArgumentParser()
+    p.add_argument("--policy_path", type=str, required=True)
+    p.add_argument("--dataset_path", type=str, required=True)
+    p.add_argument("--task", type=str, default="put the bottle into the basket in front of you")
+    p.add_argument("--num_frames", type=int, default=20)
+    p.add_argument("--output", type=str, default=None)
+    args = p.parse_args()
+
+    ds_path = Path(args.dataset_path)
+    device = torch.device("cuda")
+
+    # [1] Load model
+    print("[1] Loading model...", flush=True)
+    t0 = time.time()
+    from lerobot.policies.pi05.modeling_pi05 import PI05Policy
+    from lerobot.policies.factory import make_pre_post_processors
+    from lerobot.policies.pi05.modeling_pi05 import make_att_2d_masks
+
+    policy = PI05Policy.from_pretrained(args.policy_path)
+    print(f"    Model loaded in {time.time() - t0:.1f}s", flush=True)
+    policy.to(device)
+    policy.eval()
+
+    preprocessor, _ = make_pre_post_processors(policy.config, pretrained_path=None)
+    print(f"    Preprocessor: {[type(s).__name__ for s in preprocessor.steps]}", flush=True)
+
+    # [2] Load dataset
+    print("[2] Loading dataset...", flush=True)
+    table = pq.read_table(str(ds_path / "data/chunk-000/file-000.parquet"))
+    states = np.stack(table.column("observation.state").to_numpy().tolist())
+    total_frames = min(args.num_frames, len(states))
+    print(f"    {total_frames} frames", flush=True)
+
+    cam_names = ["head_cam", "left_cam", "right_cam"]
+    videos = {}
+    for cam in cam_names:
+        key = f"observation.images.{cam}"
+        vp = str(ds_path / f"videos/{key}/chunk-000/file-000.mp4")
+        container = av.open(vp)
+        stream = container.streams.video[0]
+        frames = [np.array(f.to_ndarray(format="rgb24")) for i, f in enumerate(container.decode(stream)) if i < total_frames]
+        container.close()
+        videos[key] = frames
+        print(f"    {cam}: {len(frames)} frames", flush=True)
+
+    num_layers = policy.model.paligemma_with_expert.gemma_expert.config.num_hidden_layers
+    print(f"    Expert layers: {num_layers}", flush=True)
+
+    # [3] Capture calibration samples
+    print("[3] Capturing calibration samples...", flush=True)
+    captured = []
+    orig_fn = policy.model.denoise_step
+
+    def cap_fn(prefix_pad_masks, past_key_values, x_t, timestep):
+        sembs, spm, sam, adarms = policy.model.embed_suffix(x_t, timestep)
+        slen, bsz, plen = spm.shape[1], prefix_pad_masks.shape[0], prefix_pad_masks.shape[1]
+        ppm2d = prefix_pad_masks[:, None, :].expand(bsz, slen, plen)
+        sam2d = make_att_2d_masks(spm, sam)
+        fam = torch.cat([ppm2d, sam2d], dim=2)
+        pids = torch.sum(prefix_pad_masks, dim=-1)[:, None] + torch.cumsum(spm, dim=1) - 1
+        fam4d = policy.model._prepare_attention_masks_4d(fam)
+        s = {
+            "suffix_embs": sembs.detach().cpu().float().numpy(),
+            "attention_mask": fam4d.detach().cpu().float().numpy(),
+            "position_ids": pids.detach().cpu().long().numpy(),
+            "adarms_cond": adarms.detach().cpu().float().numpy(),
+        }
+        for i in range(num_layers):
+            s[f"kv_layer{i}_key"] = past_key_values.key_cache[i].detach().cpu().float().numpy()
+            s[f"kv_layer{i}_value"] = past_key_values.value_cache[i].detach().cpu().float().numpy()
+        captured.append(s)
+        return orig_fn(prefix_pad_masks, past_key_values, x_t, timestep)
+
+    policy.model.denoise_step = cap_fn
+    try:
+        for fi in range(total_frames):
+            obs = {}
+            for cam in cam_names:
+                obs[f"observation.images.{cam}"] = videos[cam][fi]
+            obs["observation.state"] = states[fi].astype(np.float32)
+            obs["task"] = args.task
+            obs["robot_type"] = ""
+            with torch.inference_mode():
+                for name in obs:
+                    if name in ("task", "robot_type"):
+                        continue
+                    obs[name] = torch.from_numpy(obs[name])
+                    if "image" in name:
+                        obs[name] = obs[name].type(torch.float32) / 255
+                        obs[name] = obs[name].permute(2, 0, 1).contiguous()
+                    obs[name] = obs[name].unsqueeze(0).to(device)
+                obs = preprocessor(obs)
+                policy._action_queue.clear()
+                for k in list(policy._queues.keys()):
+                    policy._queues[k].clear()
+                _ = policy.select_action(obs)
+            print(f"    Frame {fi+1}/{total_frames}: {len(captured)} samples", flush=True)
+    finally:
+        policy.model.denoise_step = orig_fn
+
+    # [4] Save
+    if args.output is None:
+        outdir = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
+        outdir = os.path.join(outdir, "outputs", "trt_engines", "pi05_pick_up_bottle_three_pi_fixed")
+        args.output = os.path.join(outdir, "calib_samples.npz")
+    os.makedirs(os.path.dirname(args.output), exist_ok=True)
+    np.savez_compressed(args.output, *captured)
+    print(f"DONE: {len(captured)} samples -> {args.output} ({os.path.getsize(args.output)/1024/1024:.1f}MB)", flush=True)
+
+
+if __name__ == "__main__":
+    main()
