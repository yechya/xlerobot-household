+++ b/scripts/keyboard_control.sh
@@ -0,0 +1,280 @@
+#!/bin/bash
+# SO100 Network Keyboard Control Script
+# This script allows you to control SO100 robot via network keyboard
+# Run on either Jetson (server) or PC (client)
+
+# Load environment
+source envs.sh
+
+echo "=========================================================================="
+echo "SO100 Network Keyboard Control"
+echo "=========================================================================="
+echo ""
+
+# Check if we're on Jetson or PC
+# Method 1: Check for NVIDIA chip
+IS_JETSON=false
+if lspci | grep -i "nvidia" >/dev/null 2>&1; then
+    IS_JETSON=true
+    DEVICE_TYPE="Jetson (Robot Server)"
+    echo "Detected Jetson via NVIDIA GPU"
+
+# Method 2: Check for ARM architecture (common on Jetson)
+elif grep -q "aarch64" /proc/cpuinfo 2>/dev/null || grep -q "arm" /proc/cpuinfo 2>/dev/null; then
+    IS_JETSON=true
+    DEVICE_TYPE="Jetson (Robot Server)"
+    echo "Detected Jetson via ARM architecture"
+
+# Method 3: Check for tegra in cpuinfo
+elif grep -qi "tegra" /proc/cpuinfo 2>/dev/null; then
+    IS_JETSON=true
+    DEVICE_TYPE="Jetson (Robot Server)"
+    echo "Detected Jetson via CPU info"
+
+# Method 4: Check hostname
+elif hostname | grep -qi "jetson" 2>/dev/null; then
+    IS_JETSON=true
+    DEVICE_TYPE="Jetson (Robot Server)"
+    echo "Detected Jetson via hostname"
+
+# Method 5: Check for JetPack installation
+elif [ -d "/usr/local/cuda" ] && [ -f "/etc/nv_tegra_release" ]; then
+    IS_JETSON=true
+    DEVICE_TYPE="Jetson (Robot Server)"
+    echo "Detected Jetson via JetPack"
+
+# Method 6: Ask user if auto-detection failed
+else
+    echo "Auto-detection failed. Please select your device type manually:"
+    echo "  1) Jetson (Robot Server)"
+    echo "  2) PC (Keyboard Client)"
+    echo ""
+    read -p "Select device type [1-2]: " -n 1 -r
+    echo
+
+    case $REPLY in
+        1)
+            IS_JETSON=true
+            DEVICE_TYPE="Jetson (Robot Server)"
+            echo "Manual mode: Jetson"
+            ;;
+        2)
+            IS_JETSON=false
+            DEVICE_TYPE="PC (Keyboard Client)"
+            echo "Manual mode: PC"
+            ;;
+        *)
+            echo "Invalid option. Exiting."
+            exit 1
+            ;;
+    esac
+fi
+
+echo "Device type: $DEVICE_TYPE"
+echo ""
+
+# Debug info (only shown if IS_JETSON is false)
+if [ "$IS_JETSON" = false ]; then
+    echo "Debug info:"
+    echo "  Architecture: $(uname -m)"
+    echo "  CPU info: $(head -n 1 /proc/cpuinfo)"
+    echo "  Hostname: $(hostname)"
+    echo "  GPU: $(lspci | grep -i nvidia || echo 'No NVIDIA GPU')"
+    echo ""
+fi
+
+# Function to check if a port is open
+check_port() {
+    local host=$1
+    local port=$2
+    timeout 1 bash -c "echo >/dev/tcp/$host/$port" 2>/dev/null
+    return $?
+}
+
+# Function to test network connectivity
+test_network() {
+    local jetson_ip=$1
+    echo "Testing network connectivity to $jetson_ip..."
+    if ping -c 1 -W 2 "$jetson_ip" >/dev/null 2>&1; then
+        echo "✓ Network connection successful"
+        if check_port "$jetson_ip" 9999; then
+            echo "✓ Port 9999 is open - SO100 server is running!"
+            return 0
+        else
+            echo "✗ Port 9999 is closed - SO100 server is not running"
+            return 1
+        fi
+    else
+        echo "✗ Cannot ping $jetson_ip - check network connection"
+        return 1
+    fi
+}
+
+# Function to start Jetson server
+start_jetson_server() {
+    echo "=========================================================================="
+    echo "Starting SO100 Network Server on Jetson"
+    echo "=========================================================================="
+    echo ""
+    echo "This will:"
+    echo "  1. Connect to SO100 robot via USB"
+    echo "  2. Start network server on port 9999"
+    echo "  3. Wait for keyboard commands from PC"
+    echo ""
+    echo "Press Ctrl+C to stop"
+    echo ""
+
+    # Check if SO100 is connected
+    if ! ls /dev/ttyACM* >/dev/null 2>&1; then
+        echo "⚠ Warning: SO100 robot not detected on /dev/ttyACM*"
+        echo "Make sure the robot is connected via USB before continuing."
+        echo ""
+        read -p "Continue anyway? (y/N): " -n 1 -r
+        echo
+        if [[ ! $REPLY =~ ^[Yy]$ ]]; then
+            echo "Aborted."
+            exit 1
+        fi
+    fi
+
+    echo "Starting server..."
+    # Use the FIXED version which has command debouncing and action throttling
+    python examples/1_so100_keyboard_network_control_FIXED.py
+}
+
+# Function to start PC client
+start_pc_client() {
+    echo "=========================================================================="
+    echo "Starting Keyboard Client on PC"
+    echo "=========================================================================="
+    echo ""
+
+    # Ask for Jetson IP
+    read -p "Enter Jetson IP address: " JETSON_IP
+
+    if [ -z "$JETSON_IP" ]; then
+        echo "✗ Invalid IP address"
+        exit 1
+    fi
+
+    echo ""
+    echo "Testing connection to $JETSON_IP..."
+
+    # Test network
+    MAX_RETRIES=3
+    RETRY=0
+    while [ $RETRY -lt $MAX_RETRIES ]; do
+        if test_network "$JETSON_IP"; then
+            break
+        fi
+
+        RETRY=$((RETRY + 1))
+        if [ $RETRY -lt $MAX_RETRIES ]; then
+            echo ""
+            echo "Connection failed. Retrying in 2 seconds... ($RETRY/$MAX_RETRIES)"
+            sleep 2
+        else
+            echo ""
+            echo "✗ Could not connect to SO100 server"
+            echo ""
+            echo "Please make sure:"
+            echo "  1. Jetson is running this script in server mode"
+            echo "  2. The IP address $JETSON_IP is correct"
+            echo "  3. Both devices are on the same network"
+            echo ""
+            echo "You can also run this script directly on Jetson to start the server."
+            exit 1
+        fi
+    done
+
+    echo ""
+    echo "Starting keyboard client..."
+    echo "You can now send keyboard commands to control the robot!"
+    echo ""
+    echo "Example commands:"
+    echo '  {"key": "w"} - Move forward'
+    echo '  {"key": "a"} - Joint 1 +'
+    echo '  {"key": "x"} - Exit'
+    echo ""
+
+    # Check if simple client exists in py_scripts
+    if [ -f "py_scripts/simple_keyboard_client.py" ]; then
+        echo "Using lightweight client (no lerobot dependencies needed)"
+        python py_scripts/simple_keyboard_client.py "$JETSON_IP"
+    elif [ -f "simple_keyboard_client.py" ]; then
+        echo "Using lightweight client (no lerobot dependencies needed)"
+        python simple_keyboard_client.py "$JETSON_IP"
+    else
+        echo "Using full client (requires lerobot environment)"
+        python examples/network_keyboard_client.py "$JETSON_IP" 9999
+    fi
+}
+
+# Main menu
+if [ "$IS_JETSON" = true ]; then
+    echo "Jetson Mode Detected"
+    echo "This device will act as the robot server."
+    echo ""
+    echo "Choose an option:"
+    echo "  1) Start SO100 Network Server (run robot server)"
+    echo "  2) Connect to remote Jetson as client (control another robot)"
+    echo ""
+    read -p "Select option [1-2]: " -n 1 -r
+    echo
+    echo
+
+    case $REPLY in
+        1)
+            start_jetson_server
+            ;;
+        2)
+            start_pc_client
+            ;;
+        *)
+            echo "Invalid option"
+            exit 1
+            ;;
+    esac
+else
+    echo "PC Mode Detected"
+    echo "This device will act as the keyboard client."
+    echo ""
+    read -p "Enter Jetson IP address to connect: " JETSON_IP
+
+    if [ -z "$JETSON_IP" ]; then
+        echo "✗ Invalid IP address"
+        exit 1
+    fi
+
+    echo ""
+    test_network "$JETSON_IP"
+    if [ $? -eq 0 ]; then
+        echo ""
+        echo "Starting keyboard client..."
+
+        # Check if simple client exists in py_scripts
+        if [ -f "py_scripts/simple_keyboard_client.py" ]; then
+            echo "Using lightweight client (no lerobot dependencies needed)"
+            python py_scripts/simple_keyboard_client.py "$JETSON_IP"
+        elif [ -f "simple_keyboard_client.py" ]; then
+            echo "Using lightweight client (no lerobot dependencies needed)"
+            python simple_keyboard_client.py "$JETSON_IP"
+        else
+            echo "Using full client (requires lerobot environment)"
+            python examples/network_keyboard_client.py "$JETSON_IP" 9999
+        fi
+    else
+        echo ""
+        echo "✗ Cannot connect to SO100 server at $JETSON_IP"
+        echo ""
+        echo "Troubleshooting:"
+        echo "  1. Make sure the Jetson is running this script in server mode"
+        echo "  2. Check that the IP address is correct"
+        echo "  3. Ensure both devices are on the same network"
+        exit 1
+    fi
+fi
+
+echo ""
+echo "Session ended."
+
diff --git a/scripts/quantize_onnx_int8_pi05.py b/scripts/quantize_onnx_int8_pi05.py
new file mode 100644
index 000000000..cf36e0311
--- /dev/null
+++ b/scripts/quantize_onnx_int8_pi05.py
@@ -0,0 +1,569 @@
+#!/usr/bin/env python3
+"""
+对 Pi0.5 expert decode ONNX 模型做选择性 INT8 量化。
+
+只对 MatMul（Linear）层做 INT8 量化，其余层保持 FP16。
+使用 onnxruntime.quantization 的 QDQ 模式（插入 QuantizeLinear/DequantizeLinear 节点）。
+
+流程：
+  BF16 ONNX → onnxruntime quantize_static（校准 + 量化）→ INT8 ONNX → trtexec → INT8 engine
+
+基于 SmolVLA 的 quantize_onnx_int8.py 适配，Pi0.5 关键差异：
+  - 40 个输入（4 普通 + 36 KV），多了 adarms_cond
+  - attention_mask 为 BF16 4D（非 bool 3D）
+  - KV cache 使用 DynamicCache 格式（非 dict）
+  - Gemma 300M: 18 层, hidden=1024, kv_heads=1, head_dim=256
+  - 每层 7 个 MatMul（q/k/v/o/up/gate/down）共 126 个
+
+用法:
+  cd /path/to/lerobot_ycy
+  source /path/to/miniconda3/etc/profile.d/conda.sh
+  conda activate lerobot_ycy
+
+  PYTHONPATH="src:/path/to/lerobot_0.3.3_pzy/thrid-party/XLeRobot/software/src:$PYTHONPATH" \
+  LD_PRELOAD=/usr/lib/aarch64-linux-gnu/libnvinfer.so.10 \
+  python scripts/quantize_onnx_int8_pi05.py \
+    --policy_path <训练后模型路径> \
+    --onnx_path outputs/trt_engines/pi05_pick_up_bottle_three_pi_fixed/pi05_expert_decode.onnx \
+    --dataset_path <录制数据集路径> \
+    --task "put the bottle into the basket in front of you" \
+    --num_frames 20
+"""
+
+import argparse
+import json
+import logging
+import os
+import time
+
+import numpy as np
+import onnx
+import torch
+
+logging.basicConfig(level=logging.INFO, format="%(asctime)s %(levelname)s %(message)s")
+logger = logging.getLogger(__name__)
+
+
+def parse_args():
+    p = argparse.ArgumentParser(description="Selective INT8 quantization for Pi0.5 expert decode ONNX")
+    p.add_argument("--policy_path", type=str, required=True)
+    p.add_argument("--onnx_path", type=str, required=True, help="BF16 ONNX input")
+    p.add_argument("--dataset_path", type=str, required=True, help="Dataset for calibration data")
+    p.add_argument("--task", type=str, default="put the bottle into the basket in front of you")
+    p.add_argument("--num_frames", type=int, default=20)
+    p.add_argument("--device", type=str, default="cuda")
+    p.add_argument("--output_dir", type=str, default=None,
+                   help="Output dir (default: same dir as onnx_path)")
+    return p.parse_args()
+
+
+def load_video_frames(video_path, num_frames):
+    import av
+    frames = []
+    container = av.open(video_path)
+    stream = container.streams.video[0]
+    for i, frame in enumerate(container.decode(stream)):
+        if i >= num_frames:
+            break
+        frames.append(np.array(frame.to_ndarray(format="rgb24")))
+    container.close()
+    return frames
+
+
+def make_observation(frame_idx, states, videos, task):
+    obs = {}
+    for cam in ["head_cam", "left_cam", "right_cam"]:
+        key = f"observation.images.{cam}"
+        obs[key] = videos[key][frame_idx]
+    obs["observation.state"] = states[frame_idx].astype(np.float32)
+    obs["task"] = task
+    return obs
+
+
+def capture_calib_samples(policy, device, observations):
+    """
+    Run full inference pipeline, monkey-patch denoise_step to capture
+    expert decode inputs for Pi0.5.
+
+    Pi0.5 differences from SmolVLA:
+      - embed_suffix returns 4 values (suffix_embs, pad_masks, att_masks, adarms_cond)
+      - attention_mask is BF16 4D (not bool 3D)
+      - KV cache is DynamicCache (has key_cache/value_cache attributes)
+      - 18 layers (not 16)
+
+    Returns list of {input_name: numpy_array} dicts.
+    """
+    from lerobot.policies.factory import make_pre_post_processors
+    from lerobot.policies.pi05.modeling_pi05 import make_att_2d_masks
+    import copy
+
+    preprocessor, _ = make_pre_post_processors(policy.config, pretrained_path=None)
+
+    # Discover num_layers from model
+    expert_cfg = policy.model.paligemma_with_expert.gemma_expert.config
+    num_layers = expert_cfg.num_hidden_layers
+    logger.info(f"  Expert layers: {num_layers}")
+
+    samples = []
+    captured_tensors = []
+    original_denoise_step = policy.model.denoise_step
+
+    def capturing_denoise_step(prefix_pad_masks, past_key_values, x_t, timestep):
+        # Pi0.5: embed_suffix returns 4 values (includes adarms_cond)
+        suffix_embs, suffix_pad_masks, suffix_att_masks, adarms_cond = \
+            policy.model.embed_suffix(x_t, timestep)
+
+        suffix_len = suffix_pad_masks.shape[1]
+        batch_size = prefix_pad_masks.shape[0]
+        prefix_len = prefix_pad_masks.shape[1]
+
+        prefix_pad_2d_masks = prefix_pad_masks[:, None, :].expand(batch_size, suffix_len, prefix_len)
+        suffix_att_2d_masks = make_att_2d_masks(suffix_pad_masks, suffix_att_masks)
+        full_att_2d_masks = torch.cat([prefix_pad_2d_masks, suffix_att_2d_masks], dim=2)
+        prefix_offsets = torch.sum(prefix_pad_masks, dim=-1)[:, None]
+        position_ids = prefix_offsets + torch.cumsum(suffix_pad_masks, dim=1) - 1
+
+        # Prepare 4D attention mask (BF16, same as model._prepare_attention_masks_4d)
+        full_att_2d_masks_4d = policy.model._prepare_attention_masks_4d(full_att_2d_masks)
+
+        # Capture as numpy. attention_mask: keep as float32 (ORT expects float32 after BF16→FP32 conversion)
+        sample = {
+            "suffix_embs": suffix_embs.detach().cpu().float().numpy(),
+            "attention_mask": full_att_2d_masks_4d.detach().cpu().float().numpy(),
+            "position_ids": position_ids.detach().cpu().long().numpy(),
+            "adarms_cond": adarms_cond.detach().cpu().float().numpy(),
+        }
+
+        # DynamicCache format: key_cache and value_cache are lists indexed by layer
+        if hasattr(past_key_values, "key_cache"):
+            for i in range(num_layers):
+                sample[f"kv_layer{i}_key"] = past_key_values.key_cache[i].detach().cpu().float().numpy()
+                sample[f"kv_layer{i}_value"] = past_key_values.value_cache[i].detach().cpu().float().numpy()
+        else:
+            # Fallback: dict format
+            for i in range(num_layers):
+                sample[f"kv_layer{i}_key"] = past_key_values[i]["key_states"].detach().cpu().float().numpy()
+                sample[f"kv_layer{i}_value"] = past_key_values[i]["value_states"].detach().cpu().float().numpy()
+
+        captured_tensors.append(sample)
+        return original_denoise_step(prefix_pad_masks, past_key_values, x_t, timestep)
+
+    policy.model.denoise_step = capturing_denoise_step
+
+    try:
+        for frame_idx, obs in enumerate(observations):
+            obs_copy = copy.copy(obs)
+            task = obs_copy.pop("task", None)
+
+            with torch.inference_mode():
+                for name in obs_copy:
+                    obs_copy[name] = torch.from_numpy(obs_copy[name])
+                    if "image" in name:
+                        obs_copy[name] = obs_copy[name].type(torch.float32) / 255
+                        obs_copy[name] = obs_copy[name].permute(2, 0, 1).contiguous()
+                    obs_copy[name] = obs_copy[name].unsqueeze(0).to(device)
+
+                obs_copy["task"] = task if task else ""
+                obs_copy["robot_type"] = ""
+                obs_copy = preprocessor(obs_copy)
+
+                # Clear action queue and any other queues to force fresh inference each frame
+                # Pi0.5 uses self._action_queue (deque), not self._queues["action"]
+                policy._action_queue.clear()
+                for k in list(policy._queues.keys()):
+                    policy._queues[k].clear()
+
+                _ = policy.select_action(obs_copy)
+
+            logger.info(f"  Frame {frame_idx+1}/{len(observations)}: "
+                       f"captured {len(captured_tensors)} samples total")
+    finally:
+        policy.model.denoise_step = original_denoise_step
+
+    return captured_tensors
+
+
+class Pi05CalibrationReader:
+    """Calibration data reader for onnxruntime quantization (Pi0.5)."""
+
+    def __init__(self, samples):
+        self.samples = samples
+        self.index = 0
+
+    def get_next(self):
+        if self.index >= len(self.samples):
+            return None
+        sample = self.samples[self.index]
+        self.index += 1
+        # Keep original dtypes matching ONNX input specs
+        result = {}
+        for k, v in sample.items():
+            if k == "position_ids":
+                result[k] = v.astype(np.int64)
+            elif k == "attention_mask":
+                # attention_mask is already float32 from capture
+                # ONNX expects float32 after _convert_bf16_to_fp32
+                result[k] = v.astype(np.float32)
+            else:
+                result[k] = v  # float32 for embs, adarms_cond, and kv_cache
+        return result
+
+    def rewind(self):
+        self.index = 0
+
+
+def _convert_bf16_to_fp32(input_onnx, output_onnx):
+    """Convert all BF16 tensors to FP32 for ORT CPU compatibility.
+
+    Pi0.5 ONNX ~1039 MB → FP32 ONNX ~2 GB.
+    Four places to fix:
+    1. Initializers (weights) - data type
+    2. Constant node attributes (TensorProto values) - data type
+    3. Cast nodes that output BF16 - change to FP32
+    4. value_info / input / output type declarations
+    """
+    import onnx
+    import numpy as np
+    from onnx import numpy_helper, TensorProto
+
+    model = onnx.load(input_onnx)
+
+    # 1. Convert BF16 initializers to FP32
+    init_converted = 0
+    for init in model.graph.initializer:
+        if init.data_type == TensorProto.BFLOAT16:
+            bf16_raw = np.frombuffer(init.raw_data, dtype=np.uint16).copy()
+            fp32_raw = bf16_raw.astype(np.uint32) << 16
+            fp32_arr = fp32_raw.view(np.float32).reshape(list(init.dims))
+            new_init = numpy_helper.from_array(fp32_arr, name=init.name)
+            init.CopyFrom(new_init)
+            init_converted += 1
+
+    # 2. Convert BF16 Constant node attributes (TensorProto values) to FP32
+    #    Pi0.5 attention uses constants like OPENPI_ATTENTION_MASK_VALUE
+    #    stored as BF16 TensorProto in Constant node attributes
+    const_converted = 0
+    for node in model.graph.node:
+        for attr in node.attribute:
+            if attr.type == onnx.AttributeProto.TENSOR and attr.t.data_type == TensorProto.BFLOAT16:
+                t = attr.t
+                bf16_raw = np.frombuffer(t.raw_data, dtype=np.uint16).copy()
+                fp32_raw = bf16_raw.astype(np.uint32) << 16
+                fp32_arr = fp32_raw.view(np.float32).reshape(list(t.dims))
+                new_t = numpy_helper.from_array(fp32_arr, name=t.name)
+                attr.t.CopyFrom(new_t)
+                const_converted += 1
+            elif attr.type == onnx.AttributeProto.TENSORS:
+                for t in attr.tensors:
+                    if t.data_type == TensorProto.BFLOAT16:
+                        bf16_raw = np.frombuffer(t.raw_data, dtype=np.uint16).copy()
+                        fp32_raw = bf16_raw.astype(np.uint32) << 16
+                        fp32_arr = fp32_raw.view(np.float32).reshape(list(t.dims))
+                        new_t = numpy_helper.from_array(fp32_arr, name=t.name)
+                        t.CopyFrom(new_t)
+                        const_converted += 1
+
+    # 3. Convert Cast nodes that output BF16 to FP32
+    cast_converted = 0
+    for node in model.graph.node:
+        if node.op_type == 'Cast':
+            for attr in node.attribute:
+                if attr.name == 'to' and attr.i == TensorProto.BFLOAT16:
+                    attr.i = TensorProto.FLOAT
+                    cast_converted += 1
+
+    # 4. Convert BF16 value_info / input / output to FP32
+    vi_converted = 0
+    for vi in model.graph.value_info:
+        if vi.type.tensor_type.elem_type == TensorProto.BFLOAT16:
+            vi.type.tensor_type.elem_type = TensorProto.FLOAT
+            vi_converted += 1
+    for inp in model.graph.input:
+        if inp.type.tensor_type.elem_type == TensorProto.BFLOAT16:
+            inp.type.tensor_type.elem_type = TensorProto.FLOAT
+    for out in model.graph.output:
+        if out.type.tensor_type.elem_type == TensorProto.BFLOAT16:
+            out.type.tensor_type.elem_type = TensorProto.FLOAT
+
+    logger.info(f"  BF16→FP32: {init_converted} initializers, {const_converted} constant attrs, "
+                f"{cast_converted} Cast nodes, {vi_converted} value_info")
+    onnx.save(model, output_onnx)
+    logger.info(f"  Saved: {output_onnx} ({os.path.getsize(output_onnx)/1024/1024:.1f} MB)")
+    return output_onnx
+
+
+def analyze_onnx(onnx_path):
+    """List MatMul nodes (INT8 candidates) and non-quantizable nodes."""
+    from collections import Counter
+    model = onnx.load(onnx_path)
+
+    ops = Counter()
+    matmul_names = []
+    for node in model.graph.node:
+        ops[node.op_type] += 1
+        if node.op_type == "MatMul":
+            matmul_names.append(node.name)
+
+    logger.info(f"ONNX model: {len(model.graph.node)} nodes, {len(matmul_names)} MatMul (INT8 candidates)")
+    logger.info(f"Top ops: {ops.most_common(10)}")
+
+    # Pi0.5 Gemma 300M: 18 layers × 7 MatMul/layer = 126 MatMul nodes
+    expected = 126
+    if len(matmul_names) != expected:
+        logger.warning(f"  Expected {expected} MatMul nodes (18 layers × 7), got {len(matmul_names)}")
+    else:
+        logger.info(f"  MatMul count matches expectation ({expected})")
+
+    return matmul_names
+
+
+def quantize_onnx(input_onnx, output_onnx, calib_reader, matmul_node_names, nodes_to_exclude=None):
+    """Quantize ONNX model: only specified MatMul layers get INT8.
+
+    After QDQ quantization, keeps the ONNX in FP32+QDQ format.
+    TRT with --fp16 --int8 handles FP32+QDQ natively (standard QDQ format).
+    """
+    from onnxruntime.quantization import quantize_static, QuantFormat, QuantType
+
+    # Step 1: Convert BF16 weights to FP32 (ORT CPU doesn't support BF16 MatMul)
+    logger.info("Converting BF16 weights to FP32 for ORT compatibility...")
+    fp32_onnx = input_onnx.replace(".onnx", "_fp32.onnx")
+    _convert_bf16_to_fp32(input_onnx, fp32_onnx)
+    actual_input = fp32_onnx
+
+    # Step 2: QDQ quantize (only MatMul nodes)
+    logger.info(f"Quantizing: {actual_input} → {output_onnx}")
+    logger.info(f"  Format: QDQ (only {len(matmul_node_names)} MatMul nodes)")
+    logger.info(f"  Weight type: QInt8, Per-channel: True")
+
+    t0 = time.perf_counter()
+    quantize_static(
+        model_input=actual_input,
+        model_output=output_onnx,
+        calibration_data_reader=calib_reader,
+        quant_format=QuantFormat.QDQ,
+        weight_type=QuantType.QInt8,
+        activation_type=QuantType.QInt8,
+        per_channel=True,
+        nodes_to_exclude=nodes_to_exclude or [],
+        nodes_to_quantize=matmul_node_names,
+        extra_options={
+            "ActivationSymmetric": True,
+            "WeightSymmetric": True,
+        },
+    )
+    t1 = time.perf_counter()
+    logger.info(f"  Quantization done in {t1-t0:.1f}s")
+
+    # Verify output
+    qmodel = onnx.load(output_onnx)
+    from collections import Counter
+    qops = Counter(node.op_type for node in qmodel.graph.node)
+    logger.info(f"  Quantized ONNX: {len(qmodel.graph.node)} nodes")
+    logger.info(f"  QuantizeLinear: {qops.get('QuantizeLinear', 0)}")
+    logger.info(f"  DequantizeLinear: {qops.get('DequantizeLinear', 0)}")
+    logger.info(f"  MatMul: {qops.get('MatMul', 0)}")
+    logger.info(f"  Size: {os.path.getsize(output_onnx)/1024/1024:.1f} MB")
+
+    logger.info(f"  Final FP32+QDQ ONNX: {output_onnx} "
+                f"({os.path.getsize(output_onnx)/1024/1024:.1f} MB)")
+
+    return output_onnx
+
+
+def build_trt_engine(onnx_path, engine_path, policy_path):
+    """Build TRT engine from INT8 ONNX using trtexec.
+
+    Pi0.5 specifics:
+      - 40 inputs: suffix_embs, attention_mask, position_ids, adarms_cond, + 36 KV (18 layers × 2)
+      - hidden_size=1024, kv_heads=1, head_dim=256
+    """
+    import subprocess
+
+    logger.info(f"Building TRT engine: {onnx_path} → {engine_path}")
+
+    # Read chunk_size from policy config for shape specification
+    with open(os.path.join(policy_path, "config.json")) as f:
+        cfg = json.load(f)
+    chunk_size = cfg.get("chunk_size", 50)
+
+    # Read prefix_len from original BF16 ONNX (not the INT8 one)
+    orig_onnx = onnx_path.replace("_int8.onnx", ".onnx")
+    import onnx as onnx_mod
+    orig_model = onnx_mod.load(orig_onnx)
+    prefix_len = None
+    hidden_size = None
+    kv_head_dim = None
+    num_kv_heads = None
+    for inp in orig_model.graph.input:
+        if inp.name == "kv_layer0_key":
+            dims = [d.dim_value for d in inp.type.tensor_type.shape.dim]
+            # Pi0.5 GQA: (B, 1, prefix_len, 256)
+            num_kv_heads = dims[1] if dims[1] > 0 else 1
+            prefix_len = dims[2]
+            kv_head_dim = dims[3] if dims[3] > 0 else 256
+            break
+        elif inp.name == "suffix_embs":
+            dims = [d.dim_value for d in inp.type.tensor_type.shape.dim]
+            hidden_size = dims[2] if dims[2] > 0 else 1024
+
+    if prefix_len is None:
+        raise RuntimeError("Cannot determine prefix_len from original ONNX")
+    if hidden_size is None:
+        hidden_size = 1024
+    if num_kv_heads is None:
+        num_kv_heads = 1
+    if kv_head_dim is None:
+        kv_head_dim = 256
+
+    total_len = prefix_len + chunk_size
+
+    # Count KV layers from original ONNX
+    num_layers = sum(1 for inp in orig_model.graph.input if inp.name.startswith("kv_layer")) // 2
+
+    logger.info(f"  prefix_len={prefix_len}, chunk_size={chunk_size}, total_len={total_len}")
+    logger.info(f"  num_layers={num_layers}, hidden={hidden_size}, kv_heads={num_kv_heads}, head_dim={kv_head_dim}")
+
+    # Build KV cache shape strings for all layers
+    kv_shapes = ""
+    for i in range(num_layers):
+        kv_shapes += f",kv_layer{i}_key:1x{num_kv_heads}x{prefix_len}x{kv_head_dim}"
+        kv_shapes += f",kv_layer{i}_value:1x{num_kv_heads}x{prefix_len}x{kv_head_dim}"
+
+    # Build trtexec command
+    shape_spec = (f"suffix_embs:1x{chunk_size}x{hidden_size},"
+                  f"attention_mask:1x1x{chunk_size}x{total_len},"
+                  f"position_ids:1x{chunk_size},"
+                  f"adarms_cond:1x{hidden_size}")
+
+    cmd = [
+        "/usr/src/tensorrt/bin/trtexec",
+        "--onnx=" + onnx_path,
+        "--saveEngine=" + engine_path,
+        "--fp16",
+        "--int8",
+        "--memPoolSize=workspace:2048",
+        f"--minShapes={shape_spec}{kv_shapes}",
+        f"--optShapes={shape_spec}{kv_shapes}",
+        f"--maxShapes={shape_spec}{kv_shapes}",
+    ]
+
+    logger.info(f"  Running trtexec with --fp16 --int8 (QDQ mode)...")
+    logger.info(f"  This may take 10-30 minutes...")
+    t0 = time.perf_counter()
+    result = subprocess.run(cmd, capture_output=True, text=True, timeout=1800)
+    t1 = time.perf_counter()
+
+    if result.returncode != 0:
+        logger.error(f"trtexec failed (exit {result.returncode}):")
+        stderr_tail = result.stderr[-3000:] if len(result.stderr) > 3000 else result.stderr
+        logger.error(stderr_tail)
+        raise RuntimeError("trtexec failed")
+
+    # Log last few lines of stdout for useful info
+    stdout_lines = result.stdout.strip().split("\n")
+    for line in stdout_lines[-10:]:
+        logger.info(f"  trtexec: {line}")
+
+    engine_size = os.path.getsize(engine_path) / 1024 / 1024
+    logger.info(f"  Engine built in {t1-t0:.1f}s, size: {engine_size:.1f} MB")
+    return engine_path
+
+
+def main():
+    args = parse_args()
+    device = torch.device(args.device)
+
+    if args.output_dir is None:
+        args.output_dir = os.path.dirname(os.path.abspath(args.onnx_path))
+
+    print("=" * 70)
+    print("Pi0.5 Selective INT8 Quantization (MatMul only, ONNX QDQ)")
+    print("=" * 70)
+
+    # [1] Analyze ONNX
+    print("\n[1/5] Analyzing ONNX model...")
+    matmul_names = analyze_onnx(args.onnx_path)
+
+    # [2] Load model
+    print("\n[2/5] Loading model for calibration data...")
+    from lerobot.policies.pi05.modeling_pi05 import PI05Policy
+    policy = PI05Policy.from_pretrained(args.policy_path)
+    policy.to(device)
+    policy.eval()
+
+    # [3] Load dataset
+    print(f"\n[3/5] Loading {args.num_frames} frames from dataset...")
+    import pyarrow.parquet as pq
+    from pathlib import Path
+
+    ds_path = Path(args.dataset_path).expanduser()
+    parquet_path = ds_path / "data/chunk-000/file-000.parquet"
+    if not parquet_path.exists():
+        raise FileNotFoundError(f"Parquet file not found: {parquet_path}")
+
+    table = pq.read_table(str(parquet_path))
+    states = np.stack(table.column("observation.state").to_numpy().tolist())
+    total_frames = min(args.num_frames, len(states))
+    logger.info(f"  Total frames available: {len(states)}, using: {total_frames}")
+
+    cam_names = ["head_cam", "left_cam", "right_cam"]
+    videos = {}
+    for cam in cam_names:
+        key = f"observation.images.{cam}"
+        vp = str(ds_path / f"videos/{key}/chunk-000/file-000.mp4")
+        if not os.path.exists(vp):
+            raise FileNotFoundError(f"Video file not found: {vp}")
+        videos[key] = load_video_frames(vp, total_frames)
+        logger.info(f"  {cam}: {len(videos[key])} frames loaded")
+
+    observations = [make_observation(i, states, videos, args.task) for i in range(total_frames)]
+
+    # [4] Capture calibration data + Quantize ONNX
+    print(f"\n[4/5] Capturing calibration data + Quantizing ONNX...")
+    samples = capture_calib_samples(policy, device, observations)
+    logger.info(f"Total calibration samples: {len(samples)}")
+
+    if len(samples) == 0:
+        print("ERROR: No calibration samples captured!")
+        print("Check that the dataset contains valid frames and the policy can run inference.")
+        return 1
+
+    # Quantize - pass explicit MatMul node names to only quantize those
+    int8_onnx_path = args.onnx_path.replace(".onnx", "_int8.onnx")
+    calib_reader = Pi05CalibrationReader(samples)
+    quantize_onnx(args.onnx_path, int8_onnx_path, calib_reader, matmul_names)
+
+    # [5] Build TRT engine
+    print(f"\n[5/5] Building TRT engine from INT8 ONNX...")
+    int8_engine_path = args.onnx_path.replace(".onnx", "_int8.engine")
+    build_trt_engine(int8_onnx_path, int8_engine_path, args.policy_path)
+
+    engine_size = os.path.getsize(int8_engine_path) / 1024 / 1024
+    fp32_onnx = args.onnx_path.replace(".onnx", "_fp32.onnx")
+
+    print("\n" + "=" * 70)
+    print("DONE!")
+    print("=" * 70)
+    print(f"  FP32 ONNX (temp): {fp32_onnx} ({os.path.getsize(fp32_onnx)/1024/1024:.1f} MB)")
+    print(f"  INT8 ONNX:  {int8_onnx_path} ({os.path.getsize(int8_onnx_path)/1024/1024:.1f} MB)")
+    print(f"  INT8 engine: {int8_engine_path} ({engine_size:.1f} MB)")
+    print(f"\n后续步骤:")
+    print(f"  1. 用 Netron 检查 INT8 ONNX: netron {int8_onnx_path}")
+    print(f"  2. 合成数据验证:")
+    print(f"     python scripts/verify_pi05_trt.py \\")
+    print(f"       --policy_path {args.policy_path} \\")
+    print(f"       --engine_path {int8_engine_path}")
+    print(f"  3. 真实数据验证:")
+    print(f"     python scripts/verify_trt_with_real_data_pi05.py \\")
+    print(f"       --policy_path {args.policy_path} \\")
+    print(f"       --engine_path {int8_engine_path} \\")
+    print(f"       --dataset_path {args.dataset_path} \\")
+    print(f'       --task "{args.task}"')
+    print(f"  4. 清理临时文件: rm {fp32_onnx}")
+
+    return 0
+
+
+if __name__ == "__main__":
+    exit(main())
