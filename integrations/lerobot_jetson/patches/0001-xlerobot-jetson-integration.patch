+#!/usr/bin/env bash
+set -euo pipefail
+
+# Start the LeRobot development container with host cameras and robot serial
+# devices exposed inside the container. Run this script on the host machine,
+# not from an already-running container.
+#
+# Usage:
+#   scripts/docker_run_lerobot_devices.sh
+#   scripts/docker_run_lerobot_devices.sh lerobot-record --robot.type=...
+#
+# Optional:
+#   LEROBOT_IMAGE=my-image scripts/docker_run_lerobot_devices.sh
+#   LEROBOT_MOUNT_REPO=1 scripts/docker_run_lerobot_devices.sh bash
+
+IMAGE="${LEROBOT_IMAGE:-lerobot-user}"
+
+if [[ $# -eq 0 ]]; then
+  CMD=(bash)
+else
+  CMD=("${@}")
+fi
+
+REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+
+required_devices=(
+  /dev/video0
+  /dev/video2
+  /dev/video4
+)
+
+optional_devices=(
+  /dev/ttyACM0
+  /dev/ttyACM1
+  /dev/ttyACM2
+  /dev/ttyACM3
+)
+
+docker_devices=()
+missing_devices=()
+
+for dev in "${required_devices[@]}"; do
+  if [[ -e "${dev}" ]]; then
+    docker_devices+=(--device "${dev}:${dev}")
+  else
+    missing_devices+=("${dev}")
+  fi
+done
+
+for dev in "${optional_devices[@]}"; do
+  if [[ -e "${dev}" ]]; then
+    docker_devices+=(--device "${dev}:${dev}")
+  fi
+done
+
+if (( ${#missing_devices[@]} > 0 )); then
+  printf 'Missing required camera device(s): %s\n' "${missing_devices[*]}" >&2
+  printf 'Check them on the host with: ls -l /dev/video*\n' >&2
+  exit 1
+fi
+
+x11_args=()
+if [[ -n "${DISPLAY:-}" ]]; then
+  x11_args=(-e DISPLAY="${DISPLAY}" -v /tmp/.X11-unix:/tmp/.X11-unix:rw)
+fi
+
+group_args=()
+declare -A added_gids=()
+for dev in "${required_devices[@]}" "${optional_devices[@]}"; do
+  if [[ -e "${dev}" ]]; then
+    device_gid="$(stat -c '%g' "${dev}" 2>/dev/null || true)"
+    if [[ -n "${device_gid}" && -z "${added_gids[${device_gid}]:-}" ]]; then
+      group_args+=(--group-add "${device_gid}")
+      added_gids["${device_gid}"]=1
+    fi
+  fi
+done
+
+workdir_args=(-w /lerobot)
+if [[ "${LEROBOT_MOUNT_REPO:-0}" == "1" ]]; then
+  workdir_args=(
+    -v "${REPO_DIR}:/workspace/lerobot"
+    -w /workspace/lerobot
+    -e PYTHONPATH=/workspace/lerobot/src:/workspace/lerobot/thrid-party/XLeRobot/software/src
+  )
+fi
+
+docker run --rm -it \
+  --name lerobot-devices \
+  "${group_args[@]}" \
+  "${docker_devices[@]}" \
+  "${x11_args[@]}" \
+  "${workdir_args[@]}" \
+  "${IMAGE}" \
+  "${CMD[@]}"
