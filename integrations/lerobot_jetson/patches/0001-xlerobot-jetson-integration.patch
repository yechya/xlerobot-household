new file mode 100755
index 000000000..2a279cf52
--- /dev/null
+++ b/scripts/build_trt_engine.sh
@@ -0,0 +1,158 @@
+#!/bin/bash
+# 为 SmolVLA 模型构建 TensorRT Engine
+#
+# 产物结构（与 outputs/train/ 保持一致）：
+#   outputs/trt_engines/<model_name>/<model_name>.onnx
+#   outputs/trt_engines/<model_name>/<model_name>.engine         (FP16)
+#   outputs/trt_engines/<model_name>/<model_name>_int8.engine    (INT8, 需 --int8)
+#
+# 用法:
+#   bash scripts/build_trt_engine.sh smolvla_pick_up_bottle          # FP16
+#   bash scripts/build_trt_engine.sh smolvla_pick_up_bottle --int8   # INT8 (需先采集校准数据)
+
+set -e
+
+# ===== 换模型改这里 =====
+# 支持: 最后一个参数是模型名，--int8 可出现在任意位置
+INT8=false
+MODEL_NAME=""
+for arg in "$@"; do
+  case "$arg" in
+    --int8) INT8=true ;;
+    *) MODEL_NAME="$arg" ;;
+  esac
+done
+MODEL_NAME="${MODEL_NAME:-smolvla_pick_up_bottle}"
+
+POLICY_PATH="outputs/train/${MODEL_NAME}/checkpoints/last/pretrained_model"
+TRT_DIR="outputs/trt_engines/${MODEL_NAME}"
+ONNX_PATH="${TRT_DIR}/${MODEL_NAME}.onnx"
+
+if [ "$INT8" = true ]; then
+  ENGINE_PATH="${TRT_DIR}/${MODEL_NAME}_int8.engine"
+else
+  ENGINE_PATH="${TRT_DIR}/${MODEL_NAME}.engine"
+fi
+
+if [ ! -d "$POLICY_PATH" ]; then
+  echo "模型不存在: $POLICY_PATH"
+  ls outputs/train/ 2>/dev/null | grep smolvla | sed 's/^/  /'
+  exit 1
+fi
+
+if [ -f "$ENGINE_PATH" ]; then
+  echo "已存在: $ENGINE_PATH (重编: rm $ENGINE_PATH)"
+  exit 0
+fi
+
+if [ "$INT8" = true ]; then
+  echo "===== INT8 模式 ====="
+  if [ ! -f "$ONNX_PATH" ]; then
+    echo "错误: INT8 需要 ONNX 文件 ($ONNX_PATH)"
+    echo "请先不带 --int8 运行一次以生成 ONNX"
+    exit 1
+  fi
+
+  CALIB_CACHE="${TRT_DIR}/calibration_cache.bin"
+  if [ ! -f "$CALIB_CACHE" ]; then
+    echo "错误: INT8 需要校准缓存 ($CALIB_CACHE)"
+    echo "请先运行 collect_calib_data.py 采集校准数据:"
+    echo "  PYTHONPATH=\"src:thrid-party/XLeRobot/software/src:\$PYTHONPATH\" \\"
+    echo "  LD_PRELOAD=/usr/lib/aarch64-linux-gnu/libnvinfer.so.10 \\"
+    echo "  python scripts/collect_calib_data.py \\"
+    echo "    --policy_path $POLICY_PATH \\"
+    echo "    --onnx_path $ONNX_PATH \\"
+    echo "    --dataset_path <数据集路径> \\"
+    echo '    --task "put the bottle into the basket in front of you"'
+    exit 1
+  fi
+
+  echo "ONNX: $ONNX_PATH"
+  echo "Calibration: $CALIB_CACHE"
+  echo "Engine: $ENGINE_PATH"
+  echo ""
+
+  # 读取 shape 参数
+  PYTHON="${PYTHON:-python}"
+  SHAPES=$($PYTHON -c "
+import onnx, json
+model = onnx.load('$ONNX_PATH')
+with open('$POLICY_PATH/config.json') as f:
+    cfg = json.load(f)
+chunk_size = cfg['chunk_size']
+prefix_len = None
+for inp in model.graph.input:
+    if inp.name == 'kv_layer0_key':
+        dims = [d.dim_value for d in inp.type.tensor_type.shape.dim]
+        prefix_len = dims[1]
+        break
+total_len = prefix_len + chunk_size
+print(f'{prefix_len} {chunk_size} {total_len}')
+")
+  PREFIX_LEN=$(echo $SHAPES | awk '{print $1}')
+  CHUNK_SIZE=$(echo $SHAPES | awk '{print $2}')
+  ATT_TOTAL=$(echo $SHAPES | awk '{print $3}')
+
+  echo "  prefix_len=$PREFIX_LEN, chunk_size=$CHUNK_SIZE, attention_mask total_len=$ATT_TOTAL"
+
+  # 构建 KV cache 的 shape 字符串（所有层都是 1x{prefix_len}x5x64）
+  KV_SHAPES=""
+  for i in $(seq 0 15); do
+    KV_SHAPES="${KV_SHAPES},kv_layer${i}_key:1x${PREFIX_LEN}x5x64,kv_layer${i}_value:1x${PREFIX_LEN}x5x64"
+  done
+
+  echo "[INT8] trtexec 编译 (--fp16 --int8 --calib)..."
+  /usr/src/tensorrt/bin/trtexec \
+    --onnx="$ONNX_PATH" --saveEngine="$ENGINE_PATH" \
+    --fp16 --int8 --calib="$CALIB_CACHE" \
+    --memPoolSize=workspace:1024 \
+    --minShapes="suffix_embs:1x${CHUNK_SIZE}x720,attention_mask:1x${CHUNK_SIZE}x${ATT_TOTAL},position_ids:1x${CHUNK_SIZE}${KV_SHAPES}" \
+    --optShapes="suffix_embs:1x${CHUNK_SIZE}x720,attention_mask:1x${CHUNK_SIZE}x${ATT_TOTAL},position_ids:1x${CHUNK_SIZE}${KV_SHAPES}" \
+    --maxShapes="suffix_embs:1x${CHUNK_SIZE}x720,attention_mask:1x${CHUNK_SIZE}x${ATT_TOTAL},position_ids:1x${CHUNK_SIZE}${KV_SHAPES}"
+
+  echo "完成: $ENGINE_PATH ($(du -h "$ENGINE_PATH" | cut -f1))"
+  exit 0
+fi
+
+# ===== FP16 构建 =====
+
+export PYTHONPATH="src:thrid-party/XLeRobot/software/src:$PYTHONPATH"
+PYTHON="${PYTHON:-python}"
+echo "[1/2] ONNX 导出..."
+mkdir -p "$TRT_DIR"
+$PYTHON scripts/export_trt_engine.py --policy_path "$POLICY_PATH" --output_dir "$TRT_DIR"
+# export_trt_engine.py 输出固定名 smolvla_expert_decode.onnx，重命名为模型名
+mv "${TRT_DIR}/smolvla_expert_decode.onnx" "$ONNX_PATH"
+
+# prefix_len 从 ONNX 的 kv_layer0_key 静态 dim 读取
+# chunk_size 从模型 config.json 读取（ONNX 里是动态维度，dim_value=0）
+SHAPES=$($PYTHON -c "
+import onnx, json
+model = onnx.load('$ONNX_PATH')
+with open('$POLICY_PATH/config.json') as f:
+    cfg = json.load(f)
+chunk_size = cfg['chunk_size']
+prefix_len = None
+for inp in model.graph.input:
+    if inp.name == 'kv_layer0_key':
+        dims = [d.dim_value for d in inp.type.tensor_type.shape.dim]
+        prefix_len = dims[1]
+        break
+total_len = prefix_len + chunk_size
+print(f'{prefix_len} {chunk_size} {total_len}')
+")
+PREFIX_LEN=$(echo $SHAPES | awk '{print $1}')
+CHUNK_SIZE=$(echo $SHAPES | awk '{print $2}')
+ATT_TOTAL=$(echo $SHAPES | awk '{print $3}')
+
+echo "[2/2] trtexec 编译 (FP16)..."
+echo "  prefix_len=$PREFIX_LEN, chunk_size=$CHUNK_SIZE, attention_mask total_len=$ATT_TOTAL"
+
+/usr/src/tensorrt/bin/trtexec \
+  --onnx="$ONNX_PATH" --saveEngine="$ENGINE_PATH" \
+  --fp16 --memPoolSize=workspace:1024 \
+  --minShapes="suffix_embs:1x${CHUNK_SIZE}x720,attention_mask:1x${CHUNK_SIZE}x${ATT_TOTAL},position_ids:1x${CHUNK_SIZE}" \
+  --optShapes="suffix_embs:1x${CHUNK_SIZE}x720,attention_mask:1x${CHUNK_SIZE}x${ATT_TOTAL},position_ids:1x${CHUNK_SIZE}" \
+  --maxShapes="suffix_embs:1x${CHUNK_SIZE}x720,attention_mask:1x${CHUNK_SIZE}x${ATT_TOTAL},position_ids:1x${CHUNK_SIZE}"
+
+echo "完成: $ENGINE_PATH ($(du -h "$ENGINE_PATH" | cut -f1))"
