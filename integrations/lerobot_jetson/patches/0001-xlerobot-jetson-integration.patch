+#!/usr/bin/env python3
+"""
+TRT vs PyTorch 确定性验证。
+
+目的：验证 TRT FP16 engine 在 expert decode 路径上与 PyTorch BF16/FP32 的数值一致性。
+不使用硬阈值 PASS/FAIL，而是统计多组输入下的误差分布。
+
+用法:
+  export LD_PRELOAD=/usr/lib/aarch64-linux-gnu/libnvinfer.so.10
+  PYTHONPATH="src:thrid-party/XLeRobot/software/src:$PYTHONPATH" \
+  python scripts/verify_trt_deterministic.py \
+    --policy_path outputs/train/smolvla_pick_up_bottle/checkpoints/last/pretrained_model \
+    --engine_path outputs/trt_engines/smolvla_pick_up_bottle/smolvla_pick_up_bottle.engine \
+    --num_trials 20
+"""
+
+import argparse
+import json
+import torch
+import torch.nn.functional as F
+import numpy as np
+from collections import defaultdict
+
+
+def parse_args():
+    p = argparse.ArgumentParser()
+    p.add_argument("--policy_path", type=str, required=True)
+    p.add_argument("--engine_path", type=str, required=True)
+    p.add_argument("--device", type=str, default="cuda")
+    p.add_argument("--num_trials", type=int, default=20, help="Number of random input trials")
+    return p.parse_args()
+
+
+def compute_metrics(pred: torch.Tensor, ref: torch.Tensor) -> dict:
+    """Compute numerical accuracy metrics between prediction and reference."""
+    diff = (pred - ref).abs()
+    # Cosine similarity (flatten to 1D)
+    cos_sim = F.cosine_similarity(pred.flatten().unsqueeze(0), ref.flatten().unsqueeze(0)).item()
+    # Relative L2 error: ||pred - ref|| / ||ref||
+    rel_l2 = (pred - ref).norm().item() / (ref.norm().item() + 1e-8)
+    # Max / mean absolute error
+    max_abs = diff.max().item()
+    mean_abs = diff.mean().item()
+    # Percentile errors
+    flat_diff = diff.flatten()
+    p95 = torch.quantile(flat_diff, 0.95).item()
+    p99 = torch.quantile(flat_diff, 0.99).item()
+    return {
+        "cos_sim": cos_sim,
+        "rel_l2": rel_l2,
+        "max_abs": max_abs,
+        "mean_abs": mean_abs,
+        "p95_abs": p95,
+        "p99_abs": p99,
+    }
+
+
+def main():
+    args = parse_args()
+    device = args.device
+
+    print("=" * 70)
+    print("TRT vs PyTorch 确定性验证")
+    print(f"模型: {args.policy_path}")
+    print(f"Engine: {args.engine_path}")
+    print(f"试验次数: {args.num_trials}")
+    print("=" * 70)
+
+    # Load model and TRT engine
+    from lerobot.policies.smolvla.modeling_smolvla import SmolVLAPolicy, make_att_2d_masks
+    from lerobot.policies.smolvla.trt_expert_decoder import TRTExpertDecoder
+    from transformers import AutoTokenizer
+
+    print("\n[1/3] 加载模型和 TRT engine...")
+    policy = SmolVLAPolicy.from_pretrained(args.policy_path)
+    policy.to(device)
+    policy.eval()
+    model = policy.model
+    cfg = model.config
+
+    trt = TRTExpertDecoder(args.engine_path)
+    tokenizer = AutoTokenizer.from_pretrained("HuggingFaceTB/SmolVLM2-500M-Video-Instruct")
+
+    # Prepare fixed text input
+    tokens = tokenizer(
+        "put the bottle into the basket",
+        max_length=512, truncation=True, padding="max_length", return_tensors="pt",
+    )
+    lang_tokens = tokens["input_ids"].to(device)
+    lang_masks = tokens["attention_mask"].to(device).bool()
+
+    # Pruning parameters (same as sample_actions)
+    ee_coords_2d = torch.tensor(cfg.ee_coords_2d_default, dtype=torch.float32, device=device)
+    actual_grid_area = 64
+    image_keys = [k for k in cfg.input_features if "image" in k]
+    num_images = len(image_keys)
+
+    print(f"  num_steps={cfg.num_steps}, chunk_size={cfg.chunk_size}, max_action_dim={cfg.max_action_dim}")
+    print(f"  num_images={num_images}, grid_area={actual_grid_area}")
+
+    # Storage for per-trial metrics
+    all_step_metrics = defaultdict(list)  # step -> list of metrics dicts
+    all_final_metrics = []
+
+    print(f"\n[2/3] 运行 {args.num_trials} 次随机输入验证...")
+
+    for trial_idx in range(args.num_trials):
+        seed = 42 + trial_idx
+        torch.manual_seed(seed)
+        np.random.seed(seed)
+
+        # Construct batch and use policy.prepare_images for proper resize/pad
+        batch = {}
+        for key in image_keys:
+            feat = cfg.input_features[key]
+            batch[key] = torch.rand(1, 3, feat.shape[1], feat.shape[2], device=device)
+        batch["observation.state"] = torch.rand(1, cfg.input_features["observation.state"].shape[0], device=device)
+        batch["observation.language.tokens"] = lang_tokens
+        batch["observation.language.attention_mask"] = lang_masks
+
+        images, img_masks = policy.prepare_images(batch)
+        state = policy.prepare_state(batch)
+
+        # embed_prefix
+        prefix_embs, prefix_pad_masks, prefix_att_masks = model.embed_prefix(
+            images, img_masks, lang_tokens, lang_masks, state=state
+        )
+        prefix_att_2d_masks = make_att_2d_masks(prefix_pad_masks, prefix_att_masks)
+        prefix_position_ids = torch.cumsum(prefix_pad_masks, dim=1) - 1
+
+        # Pruning setup
+        num_visual_tokens = actual_grid_area * 2
+        lang_start = actual_grid_area * num_images
+        suffix_embs_temp, _, _ = model.embed_suffix(
+            torch.zeros(1, cfg.chunk_size, cfg.max_action_dim, device=device),
+            torch.ones(1, device=device, dtype=torch.float32) * 0.5,
+        )
+        suffix_len = suffix_embs_temp.shape[1]
+        total_seq_len = prefix_embs.shape[1] + suffix_len
+        prompt_abs_indices = torch.arange(lang_start, total_seq_len, device=device, dtype=torch.long)
+
+        # Prefill
+        _, past_key_values = model.vlm_with_expert.forward(
+            attention_mask=prefix_att_2d_masks,
+            position_ids=prefix_position_ids,
+            past_key_values=None,
+            inputs_embeds=[prefix_embs, None],
+            use_cache=cfg.use_cache,
+            fill_kv_cache=True,
+            prune_config=cfg.prune_config if cfg.enable_token_pruning else None,
+            grid_shape=cfg.grid_shape,
+            image_shape=cfg.image_shape,
+            ee_coords_2d=ee_coords_2d,
+            num_visual_tokens=num_visual_tokens,
+            visual_abs_indices=torch.arange(num_visual_tokens, device=device, dtype=torch.long),
+            prompt_abs_indices=prompt_abs_indices,
+            lang_start=lang_start,
+        )
+
+        # Denoise loop with dual tracking
+        bsize = 1
+        dt = torch.tensor(-1.0 / cfg.num_steps, dtype=torch.float32, device=device)
+        actions_shape = (bsize, cfg.chunk_size, cfg.max_action_dim)
+        noise = model.sample_noise(actions_shape, device)
+
+        x_t_pt = noise.clone()
+        x_t_trt = noise.clone()
+        time_val = torch.tensor(1.0, dtype=torch.float32, device=device)
+
+        for step in range(cfg.num_steps):
+            expanded_time = time_val.expand(bsize)
+
+            # PyTorch path: use x_t_pt to generate its own suffix_embs
+            suffix_embs_pt, suffix_pad_masks_pt, suffix_att_masks_pt = model.embed_suffix(x_t_pt, expanded_time)
+            s_len = suffix_pad_masks_pt.shape[1]
+            p_len = prefix_pad_masks.shape[1]
+            p2d = prefix_pad_masks[:, None, :].expand(bsize, s_len, p_len)
+
+            # Pruning mask (shared, deterministic from prefill)
+            if past_key_values is not None and "pruned_indices" in past_key_values:
+                pruned_indices = past_key_values["pruned_indices"]
+                pmask = pruned_indices < p_len
+                pi = pruned_indices[pmask]
+                if pi.numel() < p_len and pi.numel() > 0:
+                    prune_m = torch.ones(bsize, 1, p_len, dtype=torch.bool, device=device)
+                    is_kept = torch.zeros(p_len, dtype=torch.bool, device=device)
+                    is_kept[pi] = True
+                    pp = torch.arange(p_len, device=device, dtype=torch.long)[~is_kept]
+                    if pp.numel() > 0:
+                        prune_m.scatter_(2, pp.view(1, 1, -1).expand(bsize, 1, -1), False)
+                        p2d = p2d & prune_m
+
+            s2d = make_att_2d_masks(suffix_pad_masks_pt, suffix_att_masks_pt)
+            full_mask = torch.cat([p2d, s2d], dim=2)
+            offsets = torch.sum(prefix_pad_masks, dim=-1)[:, None]
+            pos_ids = offsets + torch.cumsum(suffix_pad_masks_pt, dim=1) - 1
+
+            # PyTorch forward
+            with torch.no_grad():
+                pt_out, _ = model.vlm_with_expert.forward(
+                    attention_mask=full_mask,
+                    position_ids=pos_ids,
+                    past_key_values=past_key_values,
+                    inputs_embeds=[None, suffix_embs_pt],
+                    use_cache=cfg.use_cache,
+                    fill_kv_cache=False,
+                )
+            pt_suffix_out = pt_out[1][:, -cfg.chunk_size:].to(dtype=torch.float32)
+            v_t_pt = model.action_out_proj(pt_suffix_out)
+
+            # TRT path: use x_t_trt to generate its OWN suffix_embs (independent feedback loop)
+            suffix_embs_trt, suffix_pad_masks_trt, suffix_att_masks_trt = model.embed_suffix(x_t_trt, expanded_time)
+            s_len_t = suffix_pad_masks_trt.shape[1]
+            p2d_t = prefix_pad_masks[:, None, :].expand(bsize, s_len_t, p_len)
+
+            if past_key_values is not None and "pruned_indices" in past_key_values:
+                pruned_indices = past_key_values["pruned_indices"]
+                pmask = pruned_indices < p_len
+                pi = pruned_indices[pmask]
+                if pi.numel() < p_len and pi.numel() > 0:
+                    prune_m = torch.ones(bsize, 1, p_len, dtype=torch.bool, device=device)
+                    is_kept = torch.zeros(p_len, dtype=torch.bool, device=device)
+                    is_kept[pi] = True
+                    pp = torch.arange(p_len, device=device, dtype=torch.long)[~is_kept]
+                    if pp.numel() > 0:
+                        prune_m.scatter_(2, pp.view(1, 1, -1).expand(bsize, 1, -1), False)
+                        p2d_t = p2d_t & prune_m
+
+            s2d_t = make_att_2d_masks(suffix_pad_masks_trt, suffix_att_masks_trt)
+            full_mask_t = torch.cat([p2d_t, s2d_t], dim=2)
+            offsets_t = torch.sum(prefix_pad_masks, dim=-1)[:, None]
+            pos_ids_t = offsets_t + torch.cumsum(suffix_pad_masks_trt, dim=1) - 1
+
+            trt_suffix_out = trt.run(suffix_embs_trt, full_mask_t, pos_ids_t, past_key_values)
+            trt_suffix_out = trt_suffix_out[:, -cfg.chunk_size:]
+            v_t_trt = model.action_out_proj(trt_suffix_out.to(dtype=torch.float32))
+
+            # Per-step metrics
+            step_metrics = compute_metrics(v_t_trt, v_t_pt)
+            all_step_metrics[step].append(step_metrics)
+
+            # Euler step
+            x_t_pt = x_t_pt + dt * v_t_pt
+            x_t_trt = x_t_trt + dt * v_t_trt
+            time_val = time_val + dt
+
+        # Final action output metrics
+        final_metrics = compute_metrics(x_t_trt, x_t_pt)
+        all_final_metrics.append(final_metrics)
+
+        if (trial_idx + 1) % 5 == 0:
+            print(f"  Trial {trial_idx + 1}/{args.num_trials} done")
+
+    # ============================================================
+    # Report
+    # ============================================================
+    print("\n" + "=" * 70)
+    print("[3/3] 统计报告")
+    print("=" * 70)
+
+    # --- Per-step summary ---
+    print(f"\n{'='*70}")
+    print("单步 v_t 误差统计 (across {} trials)".format(args.num_trials))
+    print(f"{'='*70}")
+    header = f"{'Step':>4s}  {'cos_sim':>8s}  {'rel_l2':>8s}  {'max_abs':>9s}  {'mean_abs':>10s}  {'p95_abs':>9s}  {'p99_abs':>9s}"
+    print(header)
+    print("-" * len(header))
+
+    for step in range(cfg.num_steps):
+        metrics_list = all_step_metrics[step]
+        keys = ["cos_sim", "rel_l2", "max_abs", "mean_abs", "p95_abs", "p99_abs"]
+        # Report mean across trials, except max_abs report worst-case (max across trials)
+        agg = {}
+        for k in keys:
+            vals = [m[k] for m in metrics_list]
+            if k == "max_abs":
+                agg[k] = max(vals)  # worst case
+            elif k == "cos_sim":
+                agg[k] = min(vals)  # worst case (lowest similarity)
+            else:
+                agg[k] = sum(vals) / len(vals)  # mean
+
+        print(
+            f"{step+1:>4d}  {agg['cos_sim']:>8.4f}  {agg['rel_l2']:>8.4f}  "
+            f"{agg['max_abs']:>9.4f}  {agg['mean_abs']:>10.6f}  "
+            f"{agg['p95_abs']:>9.4f}  {agg['p99_abs']:>9.4f}"
+        )
+
+    # --- Final action summary ---
+    print(f"\n{'='*70}")
+    print("最终动作输出 x_t 误差统计 (across {} trials)".format(args.num_trials))
+    print(f"{'='*70}")
+
+    keys = ["cos_sim", "rel_l2", "max_abs", "mean_abs", "p95_abs", "p99_abs"]
+    for k in keys:
+        vals = [m[k] for m in all_final_metrics]
+        lo = min(vals)
+        hi = max(vals)
+        mean = sum(vals) / len(vals)
+        if k == "cos_sim":
+            print(f"  {k:>10s}:  mean={mean:.6f}  worst(min)={lo:.6f}  best={hi:.6f}")
+        else:
+            print(f"  {k:>10s}:  mean={mean:.6f}  worst(max)={hi:.6f}  best={lo:.6f}")
+
+    # --- Deterministic verdict ---
+    print(f"\n{'='*70}")
+    print("确定性判定")
+    print(f"{'='*70}")
+
+    # Check per-step worst-case cosine similarity
+    worst_step_cos = 1.0
+    worst_step_idx = -1
+    for step in range(cfg.num_steps):
+        vals = [m["cos_sim"] for m in all_step_metrics[step]]
+        step_min = min(vals)
+        if step_min < worst_step_cos:
+            worst_step_cos = step_min
+            worst_step_idx = step
+
+    final_cos_vals = [m["cos_sim"] for m in all_final_metrics]
+    final_cos_worst = min(final_cos_vals)
+    final_cos_mean = sum(final_cos_vals) / len(final_cos_vals)
+
+    # Check per-step worst-case relative L2
+    worst_step_rel2 = 0.0
+    worst_step_rel2_idx = -1
+    for step in range(cfg.num_steps):
+        vals = [m["rel_l2"] for m in all_step_metrics[step]]
+        step_max = max(vals)
+        if step_max > worst_step_rel2:
+            worst_step_rel2 = step_max
+            worst_step_rel2_idx = step
+
+    final_rel2_vals = [m["rel_l2"] for m in all_final_metrics]
+    final_rel2_worst = max(final_rel2_vals)
+    final_rel2_mean = sum(final_rel2_vals) / len(final_rel2_vals)
+
+    # Worst-case max abs diff across all steps and trials
+    worst_vt_abs = 0.0
+    worst_vt_step = -1
+    for step in range(cfg.num_steps):
+        vals = [m["max_abs"] for m in all_step_metrics[step]]
+        step_max = max(vals)
+        if step_max > worst_vt_abs:
+            worst_vt_abs = step_max
+            worst_vt_step = step
+
+    final_abs_vals = [m["max_abs"] for m in all_final_metrics]
+    final_abs_worst = max(final_abs_vals)
+    final_abs_mean = sum(final_abs_vals) / len(final_abs_vals)
+
+    print(f"\n  单步 v_t:")
+    print(f"    worst cosine similarity = {worst_step_cos:.6f} (step {worst_step_idx + 1})")
+    print(f"    worst relative L2       = {worst_step_rel2:.6f} (step {worst_step_rel2_idx + 1})")
+    print(f"    worst max_abs_diff      = {worst_vt_abs:.6f} (step {worst_vt_step + 1})")
+
