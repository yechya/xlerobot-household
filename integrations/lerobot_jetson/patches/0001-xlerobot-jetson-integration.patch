+"""推理后端抽象基类和工厂函数。"""
+
+import os
+import logging
+from abc import ABC, abstractmethod
+from typing import Optional
+from dataclasses import dataclass
+
+logger = logging.getLogger("inference")
+
+# 默认后端：从环境变量读取，默认为 pytorch
+DEFAULT_BACKEND = os.environ.get("INFERENCE_BACKEND", "pytorch")
+
+
+@dataclass
+class InferenceResult:
+    """推理结果"""
+    success: bool
+    stdout: str = ""
+    stderr: str = ""
+    returncode: int = 0
+    error: str = ""
+
+
+class InferenceBackend(ABC):
+    """推理后端抽象基类"""
+
+    @property
+    @abstractmethod
+    def name(self) -> str:
+        """后端名称"""
+        pass
+
+    @abstractmethod
+    def execute(self, task_id: str, model_path: str, **kwargs) -> InferenceResult:
+        """
+        执行推理任务。
+
+        Args:
+            task_id: 任务ID
+            model_path: 模型路径
+            **kwargs: 后端特定参数
+
+        Returns:
+            InferenceResult
+        """
+        pass
+
+    def health_check(self) -> bool:
+        """健康检查"""
+        return True
+
+
+_BACKENDS = {}
+
+
+def register_backend(name: str):
+    """装饰器：注册推理后端"""
+    def decorator(cls):
+        _BACKENDS[name] = cls
+        logger.debug(f"[InferenceBackend] 注册后端: {name}")
+        return cls
+    return decorator
+
+
+def create_backend(name: Optional[str] = None) -> InferenceBackend:
+    """
+    工厂函数：根据名称创建推理后端。
+
+    Args:
+        name: 后端名称，默认从 INFERENCE_BACKEND 环境变量读取
+
+    Returns:
+        InferenceBackend 实例
+    """
+    backend_name = name or DEFAULT_BACKEND
+
+    if backend_name not in _BACKENDS:
+        available = list(_BACKENDS.keys())
+        raise ValueError(
+            f"未知推理后端: {backend_name}，可用: {available}"
+        )
+
+    cls = _BACKENDS[backend_name]
+    logger.info(f"[InferenceBackend] 创建后端: {backend_name}")
+    return cls()
+
+
+# 延迟注册：导入子模块时自动注册
+from .pytorch_backend import PyTorchBackend
+from .tensorrt_backend import TensorRTBackend
