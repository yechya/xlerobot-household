+#!/usr/bin/env python3
+"""
+SmolVLA 精确 Profiling 工具
+
+逐行计时 sample_actions 的每个子步骤，找出精确瓶颈。
+
+用法:
+  PYTHONPATH="src:thrid-party/XLeRobot/software/src:$PYTHONPATH" \
+  python scripts/profile_smolvla_v2.py \
+    --policy_path outputs/train/smolvla_pick_up_bottle/checkpoints/last/pretrained_model
+
+  # 加上优化选项:
+  ... --use_torch_compile --use_amp
+"""
+
+import argparse
+import time
+import torch
+import numpy as np
+
+
+def parse_args():
+    p = argparse.ArgumentParser()
+    p.add_argument("--policy_path", type=str, required=True)
+    p.add_argument("--num_warmup", type=int, default=5)
+    p.add_argument("--num_profile", type=int, default=10)
+    p.add_argument("--use_torch_compile", action="store_true")
+    p.add_argument("--use_amp", action="store_true")
+    p.add_argument("--use_tensorrt", action="store_true")
+    p.add_argument("--tensorrt_engine_path", type=str, default="outputs/trt_engines/smolvla_expert_decode.engine")
+    p.add_argument("--device", type=str, default="cuda")
+    return p.parse_args()
+
+
+def sync():
+    if torch.cuda.is_available():
+        torch.cuda.synchronize()
+
+
+class Timer:
+    """累积多次运行的各阶段计时."""
+
+    def __init__(self):
+        self.stages = {}  # name -> [ms1, ms2, ...]
+        self._t0 = None
+
+    def start(self):
+        sync()
+        self._t0 = time.perf_counter()
+
+    def mark(self, name):
+        sync()
+        ms = (time.perf_counter() - self._t0) * 1000
+        self._t0 = time.perf_counter()
+        self.stages.setdefault(name, []).append(ms)
+
+    def report(self, use_trt=False):
+        print(f"\n  {'阶段':<45s} {'平均':>8s} {'最小':>8s} {'最大':>8s} {'占比':>6s}")
+        print("  " + "-" * 75)
+
+        # 计算总时间（用 sample_actions_total 的平均）
+        total_key = "sample_actions_total"
+        total_avg = np.mean(self.stages.get(total_key, [1]))
+
+        transformer_label = "   3c. ★ TensorRT expert decode (核心)" if use_trt else "   3c. ★ Transformer forward (核心)"
+
+        order = [
+            ("1_prepare_noise", "1. 初始化噪声"),
+            ("2_embed_prefix_siglip", "   1a. 图像编码 (SigLIP)"),
+            ("2_embed_prefix_lang", "   1b. 语言 token embedding"),
+            ("2_embed_prefix_state", "   1c. 状态投影"),
+            ("2_embed_prefix_cat", "   1d. 拼接 prefix"),
+            ("3_pruning_params", "2. Token pruning 参数准备"),
+            ("3_dummy_suffix", "   2a. 构造 dummy suffix (测长度)"),
+            ("3_att_masks", "   2b. 构建 attention mask"),
+            ("3_prefill_transformer", "   2c. Prefill transformer forward (KV cache)"),
+            ("4_loop_overhead", "3. Denoise 循环开销 (10步)"),
+            ("4a_embed_suffix", "   3a. embed_suffix (动作+时间编码)"),
+            ("4b_mask_construct", "   3b. 拼接 attention mask"),
+            ("4c_transformer", transformer_label),
+            ("4d_output_proj", "   3d. action_out_proj + dtype转换"),
+            ("sample_actions_total", "TOTAL: sample_actions"),
+        ]
+
+        for key, label in order:
+            if key not in self.stages:
+                continue
+            times = self.stages[key]
+            avg = np.mean(times)
+            mn = np.min(times)
+            mx = np.max(times)
+            pct = avg / total_avg * 100 if total_avg > 0 else 0
+            print(f"  {label:<45s} {avg:7.1f}ms {mn:7.1f}ms {mx:7.1f}ms {pct:5.1f}%")
+
+        # 无法归类的开销
+        accounted = sum(np.mean(self.stages[k]) for k in self.stages if k != "sample_actions_total")
+        unaccounted = total_avg - accounted
+        print(f"  {'未归类的其他开销':<45s} {unaccounted:7.1f}ms {'':>8s} {'':>8s} {unaccounted/total_avg*100:5.1f}%")
+        print()
+
+
+def make_batch(policy, device):
+    cfg = policy.config
+    batch = {}
+
+    image_keys = [k for k in cfg.input_features if "image" in k]
+    for key in image_keys:
+        feat = cfg.input_features[key]
+        batch[key] = torch.rand(1, 3, feat.shape[1], feat.shape[2], device=device)
+
+    state_key = "observation.state"
+    if state_key in cfg.input_features:
+        batch[state_key] = torch.rand(1, cfg.input_features[state_key].shape[0], device=device)
+
+    from transformers import AutoTokenizer
+    tokenizer = AutoTokenizer.from_pretrained("HuggingFaceTB/SmolVLM2-500M-Video-Instruct")
+    tokens = tokenizer("put the bottle into the basket", max_length=512, truncation=True, padding="max_length", return_tensors="pt")
+    batch["observation.language.tokens"] = tokens["input_ids"].to(device)
+    batch["observation.language.attention_mask"] = tokens["attention_mask"].to(device).bool()
+
+    return batch
+
+
+def profile_one_step(model, images, img_masks, lang_tokens, lang_masks, state, timer):
+    """精确计时 sample_actions 的每个子步骤."""
+
+    cfg = model.config
+    device = state.device
+    bsize = state.shape[0]
+
+    # === 1. 初始化噪声 ===
+    timer.start()
+    actions_shape = (bsize, cfg.chunk_size, cfg.max_action_dim)
+    noise = model.sample_noise(actions_shape, device)
+    timer.mark("1_prepare_noise")
+
+    # === 2. embed_prefix ===
+    timer.start()
+    # 2a: 图像编码 (SigLIP)
+    embs, pad_masks, att_masks = [], [], []
+    for img_idx, (img, img_mask) in enumerate(zip(images, img_masks)):
+        if model.add_image_special_tokens:
+            image_start_token = (
+                model.vlm_with_expert.embed_language_tokens(
+                    model.global_image_start_token.to(device=model.vlm_with_expert.vlm.device)
+                ).unsqueeze(0).expand(img.shape[0], -1, -1)
+            )
+            embs.append(image_start_token)
+            pad_masks.append(torch.ones_like(image_start_token[:, :, 0], dtype=torch.bool))
+            att_masks += [0] * pad_masks[-1].shape[-1]
+    timer.mark("2_embed_prefix_siglip_before")  # placeholder
+
+    # 用 embed_prefix 整体计时，再单独拆
+    timer.start()
+    # SigLIP 部分
+    img_embs_list = []
+    for img_idx, (img, img_mask) in enumerate(zip(images, img_masks)):
+        img_emb = model.vlm_with_expert.embed_image(img)
+        img_emb = img_emb * (img_emb.shape[-1] ** 0.5)
+        img_embs_list.append(img_emb)
+    timer.mark("2_embed_prefix_siglip")
+
+    timer.start()
+    # 语言 embedding
+    lang_emb = model.vlm_with_expert.embed_language_tokens(lang_tokens)
+    timer.mark("2_embed_prefix_lang")
+
+    timer.start()
+    # 状态投影
+    state_emb = model.state_proj(state.to(dtype=model.state_proj.weight.dtype))
+    timer.mark("2_embed_prefix_state")
+
+    timer.start()
+    # 完整的 embed_prefix（用原方法）
+    prefix_embs, prefix_pad_masks, prefix_att_masks = model.embed_prefix(
+        images, img_masks, lang_tokens, lang_masks, state=state
+    )
+    timer.mark("2_embed_prefix_cat")
+
+    # === 3. Prefill (KV cache) ===
+    timer.start()
+    ee_coords_2d = torch.tensor(cfg.ee_coords_2d_default, dtype=torch.float32, device=device)
+    actual_grid_area = 64
+    num_images = len(images)
+    num_images_for_pruning = 2
+    num_visual_tokens = actual_grid_area * num_images_for_pruning
+    lang_start = actual_grid_area * num_images
+    timer.mark("3_pruning_params")
+
+    timer.start()
+    suffix_embs_temp, _, _ = model.embed_suffix(
+        torch.zeros(bsize, cfg.chunk_size, cfg.max_action_dim, device=device),
+        torch.ones(bsize, device=device, dtype=torch.float32) * 0.5
+    )
+    suffix_len = suffix_embs_temp.shape[1]
+    total_seq_len = prefix_embs.shape[1] + suffix_len
+    prompt_abs_indices = torch.arange(lang_start, total_seq_len, device=device, dtype=torch.long)
+    timer.mark("3_dummy_suffix")
+
+    timer.start()
+    from lerobot.policies.smolvla.modeling_smolvla import make_att_2d_masks
+    prefix_att_2d_masks = make_att_2d_masks(prefix_pad_masks, prefix_att_masks)
+    prefix_position_ids = torch.cumsum(prefix_pad_masks, dim=1) - 1
+    timer.mark("3_att_masks")
+
+    timer.start()
+    _, past_key_values = model.vlm_with_expert.forward(
+        attention_mask=prefix_att_2d_masks,
+        position_ids=prefix_position_ids,
+        past_key_values=None,
+        inputs_embeds=[prefix_embs, None],
+        use_cache=cfg.use_cache,
+        fill_kv_cache=True,
+        prune_config=cfg.prune_config if cfg.enable_token_pruning else None,
+        grid_shape=cfg.grid_shape,
+        image_shape=cfg.image_shape,
+        ee_coords_2d=ee_coords_2d,
+        num_visual_tokens=num_visual_tokens,
+        visual_abs_indices=torch.arange(num_visual_tokens, device=device, dtype=torch.long),
+        prompt_abs_indices=prompt_abs_indices,
+        lang_start=lang_start,
+    )
+    timer.mark("3_prefill_transformer")
+
+    # === 4. Denoise loop ===
+    dt_val = -1.0 / cfg.num_steps
+    dt = torch.tensor(dt_val, dtype=torch.float32, device=device)
+    x_t = noise
+    time_val = torch.tensor(1.0, dtype=torch.float32, device=device)
+
+    loop_embed_suffix = []
+    loop_mask = []
+    loop_transformer = []
+    loop_proj = []
+
+    while time_val >= -dt / 2:
+        expanded_time = time_val.expand(bsize)
+
+        t0 = time.perf_counter(); sync(); t0 = time.perf_counter()
+        suffix_embs, suffix_pad_masks, suffix_att_masks = model.embed_suffix(x_t, expanded_time)
+        sync(); loop_embed_suffix.append((time.perf_counter() - t0) * 1000)
+
+        t0 = time.perf_counter(); sync(); t0 = time.perf_counter()
+        suffix_len_local = suffix_pad_masks.shape[1]
+        batch_size = prefix_pad_masks.shape[0]
+        prefix_len = prefix_pad_masks.shape[1]
+        prefix_pad_2d_masks = prefix_pad_masks[:, None, :].expand(batch_size, suffix_len_local, prefix_len)
+
+        if past_key_values is not None and "pruned_indices" in past_key_values:
+            pruned_indices = past_key_values["pruned_indices"]
+            prefix_mask = pruned_indices < prefix_len
+            pruned_indices_prefix = pruned_indices[prefix_mask]
+            if pruned_indices_prefix.numel() < prefix_len and pruned_indices_prefix.numel() > 0:
+                prune_mask = torch.ones(batch_size, 1, prefix_len, dtype=torch.bool, device=prefix_pad_masks.device)
+                all_indices = torch.arange(prefix_len, device=prefix_pad_masks.device, dtype=torch.long)
+                is_kept = torch.zeros(prefix_len, dtype=torch.bool, device=prefix_pad_masks.device)
+                is_kept[pruned_indices_prefix] = True
+                pruned_positions = all_indices[~is_kept]
+                if pruned_positions.numel() > 0:
+                    prune_mask.scatter_(2, pruned_positions.view(1, 1, -1).expand(batch_size, 1, -1), False)
+                    prefix_pad_2d_masks = prefix_pad_2d_masks & prune_mask
+
+        suffix_att_2d_masks = make_att_2d_masks(suffix_pad_masks, suffix_att_masks)
+        full_att_2d_masks = torch.cat([prefix_pad_2d_masks, suffix_att_2d_masks], dim=2)
+        prefix_offsets = torch.sum(prefix_pad_masks, dim=-1)[:, None]
+        position_ids = prefix_offsets + torch.cumsum(suffix_pad_masks, dim=1) - 1
+        sync(); loop_mask.append((time.perf_counter() - t0) * 1000)
+
+        t0 = time.perf_counter(); sync(); t0 = time.perf_counter()
+        outputs_embeds, _ = model.vlm_with_expert.forward(
+            attention_mask=full_att_2d_masks,
+            position_ids=position_ids,
+            past_key_values=past_key_values,
+            inputs_embeds=[None, suffix_embs],
+            use_cache=cfg.use_cache,
+            fill_kv_cache=False,
+        )
+        sync(); loop_transformer.append((time.perf_counter() - t0) * 1000)
+
+        t0 = time.perf_counter(); sync(); t0 = time.perf_counter()
+        suffix_out = outputs_embeds[1]
+        suffix_out = suffix_out[:, -cfg.chunk_size:]
+        suffix_out = suffix_out.to(dtype=torch.float32)
+        v_t = model.action_out_proj(suffix_out)
+        x_t = x_t + dt * v_t
+        time_val = time_val + dt
+        sync(); loop_proj.append((time.perf_counter() - t0) * 1000)
+
+    # 记录 denoise 循环的汇总
+    timer.stages.setdefault("4a_embed_suffix", []).append(sum(loop_embed_suffix))
+    timer.stages.setdefault("4b_mask_construct", []).append(sum(loop_mask))
+    timer.stages.setdefault("4c_transformer", []).append(sum(loop_transformer))
+    timer.stages.setdefault("4d_output_proj", []).append(sum(loop_proj))
+
+    return x_t
+
+
+def main():
+    args = parse_args()
+
+    print("=" * 80)
+    print("SmolVLA 精确 Profiling v2")
+    print("=" * 80)
+    print(f"  Policy: {args.policy_path}")
+    print(f"  torch.compile: {args.use_torch_compile}  |  AMP: {args.use_amp}  |  TensorRT: {args.use_tensorrt}")
+    if args.use_tensorrt:
+        print(f"  TRT engine: {args.tensorrt_engine_path}")
+    print(f"  Warmup: {args.num_warmup}  |  Profile: {args.num_profile}")
+    print()
+
+    # 加载模型
+    from lerobot.policies.smolvla.modeling_smolvla import SmolVLAPolicy
+    policy = SmolVLAPolicy.from_pretrained(args.policy_path)
+    policy.to(args.device)
+    policy.eval()
+    if args.use_torch_compile:
+        policy = torch.compile(policy, mode="reduce-overhead", dynamic=True)
+
+    # 构造输入
+    batch = make_batch(policy, args.device)
+    print(f"输入: {len([k for k in batch if 'image' in k])} 个相机, "
+          f"state dim={batch['observation.state'].shape[-1]}, "
+          f"lang tokens={batch['observation.language.tokens'].shape[1]}")
+
+    # 准备 model 级别的输入
+    model = policy.model if hasattr(policy, "model") else policy
+    images, img_masks = policy.prepare_images(batch)
+    state = policy.prepare_state(batch)
+    lang_tokens = batch["observation.language.tokens"]
+    lang_masks = batch["observation.language.attention_mask"]
+
+    # TensorRT engine init
+    trt_engine = None
+    if args.use_tensorrt:
+        from lerobot.policies.smolvla.trt_expert_decoder import TRTExpertDecoder
+        trt_engine = TRTExpertDecoder(args.tensorrt_engine_path)
+        print(f"  TRT engine loaded: {trt_engine._num_layers} KV layers")
+
+    # Warmup（通过外层 policy，让 torch.compile 充分编译）
+    print(f"\nWarmup ({args.num_warmup} 次)...")
+    for i in range(args.num_warmup):
+        policy.reset()
+        sync(); t0 = time.perf_counter()
+        policy.predict_action_chunk(batch)
+        sync()
+        print(f"  warmup {i+1}: {(time.perf_counter()-t0)*1000:.1f} ms")
+
+    # Profile
+    timer = Timer()
+    print(f"\nProfiling ({args.num_profile} 次)...")
+
+    for run in range(args.num_profile):
+        model.eval()
+        bsize = state.shape[0]
+        device = state.device
+        cfg = model.config
+
+        sync(); total_t0 = time.perf_counter()
+
+        # === 全量 sample_actions（通过 model 直接调用）===
+        sync(); t0 = time.perf_counter()
+
+        noise = model.sample_noise((bsize, cfg.chunk_size, cfg.max_action_dim), device)
+        sync(); timer.stages.setdefault("1_prepare_noise", []).append((time.perf_counter()-t0)*1000)
+        timer._t0 = time.perf_counter()
+
+        # embed_prefix
+        sync(); t0 = time.perf_counter()
+        prefix_embs, prefix_pad_masks, prefix_att_masks = model.embed_prefix(
+            images, img_masks, lang_tokens, lang_masks, state=state
+        )
+        sync(); timer.stages.setdefault("2_embed_prefix_cat", []).append((time.perf_counter()-t0)*1000)
+
+        # pruning params + masks
+        sync(); t0 = time.perf_counter()
+        ee_coords_2d = torch.tensor(cfg.ee_coords_2d_default, dtype=torch.float32, device=device)
+        actual_grid_area = 64
+        num_images = len(images)
+        num_visual_tokens = actual_grid_area * 2
+        lang_start = actual_grid_area * num_images
+
+        suffix_embs_temp, _, _ = model.embed_suffix(
+            torch.zeros(bsize, cfg.chunk_size, cfg.max_action_dim, device=device),
+            torch.ones(bsize, device=device, dtype=torch.float32) * 0.5
+        )
+        suffix_len = suffix_embs_temp.shape[1]
+        total_seq_len = prefix_embs.shape[1] + suffix_len
+        prompt_abs_indices = torch.arange(lang_start, total_seq_len, device=device, dtype=torch.long)
+
+        prefix_att_2d_masks = make_att_2d_masks(prefix_pad_masks, prefix_att_masks)
+        prefix_position_ids = torch.cumsum(prefix_pad_masks, dim=1) - 1
+        sync(); timer.stages.setdefault("3_att_masks", []).append((time.perf_counter()-t0)*1000)
+
+        # prefill transformer
+        sync(); t0 = time.perf_counter()
+        _, past_key_values = model.vlm_with_expert.forward(
+            attention_mask=prefix_att_2d_masks,
+            position_ids=prefix_position_ids,
+            past_key_values=None,
+            inputs_embeds=[prefix_embs, None],
+            use_cache=cfg.use_cache,
+            fill_kv_cache=True,
+            prune_config=cfg.prune_config if cfg.enable_token_pruning else None,
+            grid_shape=cfg.grid_shape,
+            image_shape=cfg.image_shape,
+            ee_coords_2d=ee_coords_2d,
+            num_visual_tokens=num_visual_tokens,
+            visual_abs_indices=torch.arange(num_visual_tokens, device=device, dtype=torch.long),
+            prompt_abs_indices=prompt_abs_indices,
+            lang_start=lang_start,
+        )
+        sync(); timer.stages.setdefault("3_prefill_transformer", []).append((time.perf_counter()-t0)*1000)
+
+        # denoise loop
+        dt = torch.tensor(-1.0 / cfg.num_steps, dtype=torch.float32, device=device)
+        x_t = noise
+        time_val = torch.tensor(1.0, dtype=torch.float32, device=device)
+
+        loop_suffix = []; loop_mask = []; loop_transformer = []; loop_proj = []
+
+        while time_val >= -dt / 2:
+            expanded_time = time_val.expand(bsize)
+
+            sync(); t0 = time.perf_counter()
+            suffix_embs, suffix_pad_masks, suffix_att_masks = model.embed_suffix(x_t, expanded_time)
+            sync(); loop_suffix.append((time.perf_counter()-t0)*1000)
+
+            sync(); t0 = time.perf_counter()
+            s_len = suffix_pad_masks.shape[1]
+            bsz = prefix_pad_masks.shape[0]
+            p_len = prefix_pad_masks.shape[1]
+            p2d = prefix_pad_masks[:, None, :].expand(bsz, s_len, p_len)
+
+            if past_key_values is not None and "pruned_indices" in past_key_values:
+                pruned_indices = past_key_values["pruned_indices"]
+                pmask = pruned_indices < p_len
+                pi = pruned_indices[pmask]
+                if pi.numel() < p_len and pi.numel() > 0:
+                    prune_m = torch.ones(bsz, 1, p_len, dtype=torch.bool, device=device)
+                    is_kept = torch.zeros(p_len, dtype=torch.bool, device=device)
+                    is_kept[pi] = True
+                    pp = torch.arange(p_len, device=device, dtype=torch.long)[~is_kept]
+                    if pp.numel() > 0:
+                        prune_m.scatter_(2, pp.view(1,1,-1).expand(bsz,1,-1), False)
+                        p2d = p2d & prune_m
+
+            s2d = make_att_2d_masks(suffix_pad_masks, suffix_att_masks)
+            full_mask = torch.cat([p2d, s2d], dim=2)
+            offsets = torch.sum(prefix_pad_masks, dim=-1)[:, None]
+            pos_ids = offsets + torch.cumsum(suffix_pad_masks, dim=1) - 1
+            sync(); loop_mask.append((time.perf_counter()-t0)*1000)
+
+            sync(); t0 = time.perf_counter()
+            if trt_engine is not None:
+                suffix_out = trt_engine.run(
+                    suffix_embs, full_mask, pos_ids, past_key_values
+                )
+                suffix_out = suffix_out[:, -cfg.chunk_size:]
+            else:
+                out, _ = model.vlm_with_expert.forward(
+                    attention_mask=full_mask,
+                    position_ids=pos_ids,
+                    past_key_values=past_key_values,
+                    inputs_embeds=[None, suffix_embs],
+                    use_cache=cfg.use_cache,
+                    fill_kv_cache=False,
+                )
+                suffix_out = out[1][:, -cfg.chunk_size:].to(dtype=torch.float32)
+            sync(); loop_transformer.append((time.perf_counter()-t0)*1000)
+
+            sync(); t0 = time.perf_counter()
+            suffix_out = suffix_out.to(dtype=torch.float32)
+            v_t = model.action_out_proj(suffix_out)
+            x_t = x_t + dt * v_t
+            time_val = time_val + dt
+            sync(); loop_proj.append((time.perf_counter()-t0)*1000)
+
+        sync()
+        total_ms = (time.perf_counter() - total_t0) * 1000
+        timer.stages.setdefault("sample_actions_total", []).append(total_ms)
+
+        timer.stages.setdefault("2_embed_prefix_siglip", []).append(0)  # placeholder
+        timer.stages.setdefault("2_embed_prefix_lang", []).append(0)
+        timer.stages.setdefault("2_embed_prefix_state", []).append(0)
+        timer.stages.setdefault("3_pruning_params", []).append(0)
+        timer.stages.setdefault("3_dummy_suffix", []).append(0)
+        timer.stages.setdefault("4a_embed_suffix", []).append(sum(loop_suffix))
+        timer.stages.setdefault("4b_mask_construct", []).append(sum(loop_mask))
+        timer.stages.setdefault("4c_transformer", []).append(sum(loop_transformer))
+        timer.stages.setdefault("4d_output_proj", []).append(sum(loop_proj))
+
+    # 输出结果
+    print("\n" + "=" * 80)
+    print(f"结果 (每步denoise展开, 共{model.config.num_steps}步)")
+    print("=" * 80)
+    timer.report(use_trt=trt_engine is not None)
+
+    # denoise 每步明细
+    if loop_transformer:
+        print(f"  Denoise 单步明细 (最后1次运行):")
+        print(f"    {'步数':>4s}  {'suffix编码':>10s}  {'mask构造':>10s}  {'transformer':>12s}  {'输出投影':>10s}  {'合计':>10s}")
+        for i in range(len(loop_transformer)):
+            step_total = loop_suffix[i] + loop_mask[i] + loop_transformer[i] + loop_proj[i]
+            print(f"    {i+1:>4d}  {loop_suffix[i]:>9.1f}ms  {loop_mask[i]:>9.1f}ms  {loop_transformer[i]:>11.1f}ms  {loop_proj[i]:>9.1f}ms  {step_total:>9.1f}ms")
+
+    print("Done.")
+
+
+if __name__ == "__main__":
+    from lerobot.policies.smolvla.modeling_smolvla import make_att_2d_masks
+    main()
