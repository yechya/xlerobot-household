diff --git a/scripts/export_trt_engine.py b/scripts/export_trt_engine.py
new file mode 100644
index 000000000..5f6e00663
--- /dev/null
+++ b/scripts/export_trt_engine.py
@@ -0,0 +1,420 @@
+#!/usr/bin/env python3
+"""
+Step 1: 尝试将 SmolVLA expert decode 路径导出为 ONNX。
+
+这个脚本会：
+1. 加载模型，做一次完整推理拿到真实的 KV cache
+2. 将 vlm_with_expert.forward() 的 decode 路径导出为 ONNX
+3. 验证 ONNX 模型的数值正确性
+
+用法:
+  PYTHONPATH="src:thrid-party/XLeRobot/software/src:$PYTHONPATH" \
+  python scripts/export_trt_engine.py \
+    --policy_path outputs/train/smolvla_pick_up_bottle/checkpoints/last/pretrained_model
+"""
+
+import argparse
+import time
+import torch
+import numpy as np
+
+
+def parse_args():
+    p = argparse.ArgumentParser()
+    p.add_argument("--policy_path", type=str, required=True)
+    p.add_argument("--device", type=str, default="cuda")
+    p.add_argument("--output_dir", type=str, default="outputs/trt_engines")
+    return p.parse_args()
+
+
+def make_batch(policy, device):
+    cfg = policy.config
+    batch = {}
+    image_keys = [k for k in cfg.input_features if "image" in k]
+    for key in image_keys:
+        feat = cfg.input_features[key]
+        batch[key] = torch.rand(1, 3, feat.shape[1], feat.shape[2], device=device)
+    batch["observation.state"] = torch.rand(1, cfg.input_features["observation.state"].shape[0], device=device)
+    from transformers import AutoTokenizer
+    tokenizer = AutoTokenizer.from_pretrained("HuggingFaceTB/SmolVLM2-500M-Video-Instruct")
+    tokens = tokenizer("put the bottle into the basket", max_length=cfg.tokenizer_max_length, truncation=True, padding="max_length", return_tensors="pt")
+    batch["observation.language.tokens"] = tokens["input_ids"].to(device)
+    batch["observation.language.attention_mask"] = tokens["attention_mask"].to(device).bool()
+    return batch
+
+
+class ExpertDecodeWrapper(torch.nn.Module):
+    """
+    包装 vlm_with_expert 的 decode 路径 (inputs_embeds=[None, suffix_embs])。
+    将 KV cache 展平为多个输入张量，方便 ONNX 导出。
+    """
+
+    def __init__(self, vlm_with_expert, num_vlm_layers):
+        super().__init__()
+        self.vlm_with_expert = vlm_with_expert
+        self.num_vlm_layers = num_vlm_layers
+        # 复用原始模型的子模块引用
+        self._original_forward = vlm_with_expert.forward
+
+    def forward(
+        self,
+        suffix_embs: torch.Tensor,
+        attention_mask: torch.Tensor,
+        position_ids: torch.LongTensor,
+        # 展平的 KV cache: 每层一对 (key, value)
+        *kv_tensors: torch.Tensor,
+    ) -> torch.Tensor:
+        # 重建 past_key_values dict
+        past_key_values = {}
+        for i in range(self.num_vlm_layers):
+            past_key_values[i] = {
+                "key_states": kv_tensors[i * 2],
+                "value_states": kv_tensors[i * 2 + 1],
+            }
+
+        # 确保 attention_mask 是 bool（ONNX 对 torch.where 要求 bool 条件）
+        if attention_mask.dtype != torch.bool:
+            attention_mask = attention_mask.to(torch.bool)
+
+        outputs_embeds, _ = self._original_forward(
+            attention_mask=attention_mask,
+            position_ids=position_ids,
+            past_key_values=past_key_values,
+            inputs_embeds=[None, suffix_embs],
+            use_cache=True,
+            fill_kv_cache=False,
+        )
+        # 返回 expert 输出
+        suffix_out = outputs_embeds[1]
+        return suffix_out
+
+
+def main():
+    args = parse_args()
+
+    print("=" * 70)
+    print("SmolVLA ONNX Export (Expert Decode Path)")
+    print("=" * 70)
+
+    # 加载模型
+    print("\n[1/5] 加载模型...")
+    from lerobot.policies.smolvla.modeling_smolvla import SmolVLAPolicy
+    policy = SmolVLAPolicy.from_pretrained(args.policy_path)
+    policy.to(args.device)
+    policy.eval()
+
+    model = policy.model
+    cfg = model.config
+    device = args.device
+
+    # 构造输入并做一次完整推理，拿到真实 KV cache
+    print("\n[2/5] 构造输入 + Prefill (获取真实 KV cache)...")
+    batch = make_batch(policy, args.device)
+    images, img_masks = policy.prepare_images(batch)
+    state = policy.prepare_state(batch)
+    lang_tokens = batch["observation.language.tokens"]
+    lang_masks = batch["observation.language.attention_mask"]
+
+    from lerobot.policies.smolvla.modeling_smolvla import make_att_2d_masks
+
+    # embed_prefix
+    prefix_embs, prefix_pad_masks, prefix_att_masks = model.embed_prefix(
+        images, img_masks, lang_tokens, lang_masks, state=state
+    )
+    prefix_att_2d_masks = make_att_2d_masks(prefix_pad_masks, prefix_att_masks)
+    prefix_position_ids = torch.cumsum(prefix_pad_masks, dim=1) - 1
+
+    # prefill
+    ee_coords_2d = torch.tensor(cfg.ee_coords_2d_default, dtype=torch.float32, device=device)
+    actual_grid_area = 64
+    num_images = len(images)
+    num_visual_tokens = actual_grid_area * 2
+    lang_start = actual_grid_area * num_images
+
+    suffix_embs_temp, _, _ = model.embed_suffix(
+        torch.zeros(1, cfg.chunk_size, cfg.max_action_dim, device=device),
+        torch.ones(1, device=device, dtype=torch.float32) * 0.5
+    )
+    suffix_len = suffix_embs_temp.shape[1]
+    total_seq_len = prefix_embs.shape[1] + suffix_len
+    prompt_abs_indices = torch.arange(lang_start, total_seq_len, device=device, dtype=torch.long)
+
+    _, past_key_values = model.vlm_with_expert.forward(
+        attention_mask=prefix_att_2d_masks,
+        position_ids=prefix_position_ids,
+        past_key_values=None,
+        inputs_embeds=[prefix_embs, None],
+        use_cache=True,
+        fill_kv_cache=True,
+        prune_config=cfg.prune_config if cfg.enable_token_pruning else None,
+        grid_shape=cfg.grid_shape,
+        image_shape=cfg.image_shape,
+        ee_coords_2d=ee_coords_2d,
+        num_visual_tokens=num_visual_tokens,
+        visual_abs_indices=torch.arange(num_visual_tokens, device=device, dtype=torch.long),
+        prompt_abs_indices=prompt_abs_indices,
+        lang_start=lang_start,
+    )
+
+    print(f"  prefix_embs shape: {prefix_embs.shape}")
+    print(f"  prefix_pad_masks shape: {prefix_pad_masks.shape}")
+    print(f"  KV cache layers: {len([k for k in past_key_values if isinstance(k, int)])}")
+    for k in sorted([k for k in past_key_values if isinstance(k, int)]):
+        print(f"    layer {k}: key {past_key_values[k]['key_states'].shape}, value {past_key_values[k]['value_states'].shape}")
+
+    # 构造 denoise_step 的输入
+    x_t = torch.randn(1, cfg.chunk_size, cfg.max_action_dim, device=device)
+    timestep = torch.ones(1, device=device)
+    suffix_embs, suffix_pad_masks, suffix_att_masks = model.embed_suffix(x_t, timestep)
+
+    # 构建 attention mask (简化版，不做 pruning mask)
+    s_len = suffix_pad_masks.shape[1]
+    bsz = prefix_pad_masks.shape[0]
+    p_len = prefix_pad_masks.shape[1]
+    p2d = prefix_pad_masks[:, None, :].expand(bsz, s_len, p_len)
+    s2d = make_att_2d_masks(suffix_pad_masks, suffix_att_masks)
+    full_mask = torch.cat([p2d, s2d], dim=2)
+    offsets = torch.sum(prefix_pad_masks, dim=-1)[:, None]
+    pos_ids = offsets + torch.cumsum(suffix_pad_masks, dim=1) - 1
+
+    print(f"\n  suffix_embs shape: {suffix_embs.shape}")
+    print(f"  attention_mask shape: {full_mask.shape}")
+    print(f"  position_ids shape: {pos_ids.shape}")
+
+    # PyTorch baseline
+    print("\n[3/5] PyTorch baseline 推理...")
+    with torch.no_grad():
+        baseline_out, _ = model.vlm_with_expert.forward(
+            attention_mask=full_mask,
+            position_ids=pos_ids,
+            past_key_values=past_key_values,
+            inputs_embeds=[None, suffix_embs],
+            use_cache=True,
+            fill_kv_cache=False,
+        )
+    baseline_result = baseline_out[1][:, -cfg.chunk_size:]
+    print(f"  输出 shape: {baseline_result.shape}, dtype: {baseline_result.dtype}")
+    print(f"  输出统计: mean={baseline_result.mean():.6f}, std={baseline_result.std():.6f}")
+
+    # 尝试 ONNX 导出
+    print("\n[4/5] 尝试 ONNX 导出...")
+
+    num_layers = len([k for k in past_key_values if isinstance(k, int)])
+    wrapper = ExpertDecodeWrapper(model.vlm_with_expert, num_layers)
+    wrapper.eval()
+
+    # 准备输入 (attention_mask 保持 bool)
+    kv_tensors = []
+    for i in range(num_layers):
+        kv_tensors.append(past_key_values[i]["key_states"])
+        kv_tensors.append(past_key_values[i]["value_states"])
+
+    # attention_mask 用 bool 传入，ONNX 需要显式声明
+    all_inputs = [suffix_embs, full_mask, pos_ids] + kv_tensors
+
+    input_names = ["suffix_embs", "attention_mask", "position_ids"]
+    for i in range(num_layers):
+        input_names.append(f"kv_layer{i}_key")
+        input_names.append(f"kv_layer{i}_value")
+    output_names = ["expert_output"]
+
+    # 动态 axes: suffix_embs 的 seq_len, attention_mask 的后两维, position_ids 的 seq_len
+    dynamic_axes = {
+        "suffix_embs": {1: "chunk_size"},
+        "attention_mask": {1: "chunk_size", 2: "total_len"},
+        "position_ids": {1: "chunk_size"},
+        "expert_output": {1: "chunk_size"},
+    }
+
+    onnx_path = f"{args.output_dir}/smolvla_expert_decode.onnx"
+
+    import os
+    os.makedirs(args.output_dir, exist_ok=True)
+
+    try:
+        torch.onnx.export(
+            wrapper,
+            tuple(all_inputs),
+            onnx_path,
+            input_names=input_names,
+            output_names=output_names,
+            dynamic_axes=dynamic_axes,
+            opset_version=17,
+            do_constant_folding=True,
+        )
+        print(f"  ✓ ONNX 导出成功: {onnx_path}")
+
+        # 验证 ONNX
+        print("\n[5/5] 验证 ONNX 模型...")
+        import onnx
+        onnx_model = onnx.load(onnx_path)
+        onnx.checker.check_model(onnx_model)
+        print("  ✓ ONNX 模型检查通过")
+
+        # 用 onnxruntime 对比数值
+        try:
+            import onnxruntime as ort
+            print("  onnxruntime 可用，进行数值对比...")
+            sess = ort.InferenceSession(onnx_path, providers=["CPUExecutionProvider"])
+            ort_inputs = {
+                name: inp.cpu().numpy() if inp.dtype != torch.bfloat16 else inp.float().cpu().numpy()
+                for name, inp in zip(input_names, all_inputs)
+            }
+            ort_out = sess.run(None, ort_inputs)
+            ort_result = torch.from_numpy(ort_out[0])
+            pt_result = baseline_result.float().cpu()
+
+            diff = (ort_result - pt_result).abs()
+            print(f"  最大误差: {diff.max():.6f}")
+            print(f"  平均误差: {diff.mean():.6f}")
+            if diff.max() < 0.01:
+                print("  ✓ 数值对比通过 (误差 < 0.01)")
+            else:
+                print("  ⚠ 误差较大，可能需要检查导出配置")
+        except ImportError:
+            print("  onnxruntime 未安装，跳过数值对比")
+
+        # ====== 构建 TensorRT Engine ======
+        print("\n[Bonus] 构建 TensorRT Engine...")
+        try:
+            import tensorrt as trt
+
+            logger = trt.Logger(trt.Logger.WARNING)
+            builder = trt.Builder(logger)
+            network = builder.create_network(1 << int(trt.NetworkDefinitionCreationFlag.EXPLICIT_BATCH))
+            parser = trt.OnnxParser(network, logger)
+
+            with open(onnx_path, "rb") as f:
+                if not parser.parse(f.read()):
+                    print("  ✗ ONNX 解析失败:")
+                    for i in range(parser.num_errors):
+                        print(f"    {parser.get_error(i)}")
+                    return
+
+            print("  ONNX 解析成功")
+
+            # 配置 builder
+            config = builder.create_builder_config()
+            config.set_memory_pool_limit(trt.MemoryPoolType.WORKSPACE, 1 << 30)  # 1GB
+
+            # FP16 精度
+            if builder.platform_has_fast_fp16:
+                config.set_flag(trt.BuilderFlag.FP16)
+                print("  启用 FP16 精度")
+
+            # 设置输入 shape profile (固定 batch=1)
+            profile = builder.create_optimization_profile()
+            chunk_size = cfg.chunk_size
+            prefix_len = past_key_values[0]["key_states"].shape[1]
+
+            profile.set_shape("suffix_embs", (1, chunk_size, 720), (1, chunk_size, 720), (1, chunk_size, 720))
+            profile.set_shape("attention_mask", (1, chunk_size, prefix_len + chunk_size), (1, chunk_size, prefix_len + chunk_size), (1, chunk_size, prefix_len + chunk_size))
+            profile.set_shape("position_ids", (1, chunk_size), (1, chunk_size), (1, chunk_size))
+
+            for i in range(num_layers):
+                kv_shape = (1, prefix_len, 5, 64)
+                profile.set_shape(f"kv_layer{i}_key", kv_shape, kv_shape, kv_shape)
+                profile.set_shape(f"kv_layer{i}_value", kv_shape, kv_shape, kv_shape)
+
+            config.add_optimization_profile(profile)
+
+            # 构建 engine
+            print("  正在构建 TRT engine (可能需要几分钟)...")
+            t0 = time.perf_counter()
+            engine_bytes = builder.build_serialized_network(network, config)
+            if engine_bytes is None:
+                print("  ✗ TRT engine 构建失败")
+                return
+
+            engine_path = f"{args.output_dir}/smolvla_expert_decode.engine"
+            with open(engine_path, "wb") as f:
+                f.write(engine_bytes)
+            t1 = time.perf_counter()
+            print(f"  ✓ TRT engine 构建成功: {engine_path}")
+            print(f"  构建耗时: {(t1 - t0):.1f}s")
+            print(f"  Engine 大小: {len(engine_bytes) / 1024 / 1024:.1f} MB")
+
+            # 快速验证: 加载 engine 并执行一次推理
+            print("\n  验证 TRT engine 推理...")
+            runtime = trt.Runtime(logger)
+            engine = runtime.deserialize_cuda_engine(engine_bytes)
+            context = engine.create_execution_context()
+
+            # 分配 GPU buffer
+            import numpy as np
+            bindings = []
+            outputs = {}
+            stream = torch.cuda.Stream()
+
+            with torch.cuda.stream(stream):
+                for i in range(engine.num_io_tensors):
+                    name = engine.get_tensor_name(i)
+                    shape = context.get_tensor_shape(name)
+                    dtype_map = {trt.DataType.FLOAT: torch.float32, trt.DataType.HALF: torch.float16, trt.DataType.BF16: torch.bfloat16, trt.DataType.BOOL: torch.bool, trt.DataType.INT32: torch.int32, trt.DataType.INT64: torch.int64}
+                    trt_dtype = engine.get_tensor_dtype(name)
+                    torch_dtype = dtype_map.get(trt_dtype, torch.float32)
+
+                    if engine.get_tensor_mode(name) == trt.TensorIOMode.INPUT:
+                        # 找到对应的输入 tensor
+                        for inp_name, inp_tensor in zip(input_names, all_inputs):
+                            if inp_name == name:
+                                buf = inp_tensor.contiguous().to(torch_dtype).cuda()
+                                break
+                        else:
+                            buf = torch.zeros([s if s > 0 else 1 for s in shape], dtype=torch_dtype, device="cuda")
+                    else:
+                        buf = torch.zeros([s if s > 0 else 1 for s in shape], dtype=torch_dtype, device="cuda")
+                        outputs[name] = buf
+
+                    context.set_tensor_address(name, buf.data_ptr())
+                    bindings.append(buf)
+
+                context.execute_async_v3(stream.cuda_stream)
+
+            torch.cuda.synchronize()
+
+            if "expert_output" in outputs:
+                trt_out = outputs["expert_output"].float()
+                diff = (trt_out.cpu() - baseline_result.cpu().float()).abs()
+                print(f"  TRT 输出 shape: {trt_out.shape}, dtype: {outputs['expert_output'].dtype}")
+                print(f"  vs PyTorch 最大误差: {diff.max():.6f}")
+                print(f"  vs PyTorch 平均误差: {diff.mean():.6f}")
+                if diff.max() < 0.05:
+                    print("  ✓ TRT 数值验证通过")
+                else:
+                    print("  ⚠ 误差较大 (FP16 精度损失)，但对推理通常可接受")
+
+        except ImportError:
+            print("  tensorrt 未安装 (不太可能，因为之前检测到)")
+        except Exception as e:
+            print(f"  ✗ TRT 构建或验证失败: {e}")
+            import traceback
+            traceback.print_exc()
+
+    except Exception as e:
+        print(f"  ✗ ONNX 导出失败: {e}")
+        print(f"\n  错误类型: {type(e).__name__}")
+
+        # 尝试更简单的导出方式
+        print("\n  尝试使用 torch.jit.trace 方式导出...")
+        try:
+            traced = torch.jit.trace(wrapper, tuple(all_inputs))
+            torch.onnx.export(
+                traced,
+                tuple(all_inputs),
+                onnx_path,
+                input_names=input_names,
+                output_names=output_names,
+                opset_version=17,
+                do_constant_folding=True,
+            )
+            print(f"  ✓ torch.jit.trace 导出成功: {onnx_path}")
+        except Exception as e2:
+            print(f"  ✗ torch.jit.trace 也失败: {e2}")
+            print("\n  需要进一步分析哪些操作不可导出。")
+
+    print("\nDone.")
+
+
+if __name__ == "__main__":
+    main()
