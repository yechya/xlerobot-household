+#!/usr/bin/env python
+"""Offline inference script for smolvla model without robot hardware.
+
+Usage:
+    python scripts/inference_offline.py \
+        --policy.path=/path/to/pretrained_model \
+        --output_dir=outputs/inference
+
+Note: This script loads a random observation to initialize the policy,
+then runs inference on random input. Use this for model testing only.
+"""
+
+import argparse
+import json
+from pathlib import Path
+
+import numpy as np
+import torch
+from tqdm import tqdm
+
+from lerobot.configs.policies import PreTrainedConfig
+from lerobot.policies.factory import make_policy
+from lerobot.utils.utils import init_logging
+
+
+def main():
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--policy.path", dest="policy_path", type=str, required=True,
+                        help="Path to pretrained model")
+    parser.add_argument("--output_dir", type=str, default="outputs/inference",
+                        help="Output directory for results")
+    parser.add_argument("--device", type=str, default="cuda",
+                        help="Device to run inference on")
+    parser.add_argument("--num_steps", type=int, default=10,
+                        help="Number of inference steps to run")
+
+    args = parser.parse_args()
+
+    init_logging()
+
+    # Load policy config
+    print(f"Loading policy from {args.policy_path}")
+    policy_cfg = PreTrainedConfig.from_pretrained(args.policy_path)
+    policy_cfg.device = args.device
+
+    # Get input/output features from config
+    input_features = policy_cfg.input_features
+    output_features = policy_cfg.output_features
+
+    print(f"Input features: {list(input_features.keys())}")
+    print(f"Output features: {list(output_features.keys())}")
+
+    # Build features dict - handle both dict and PolicyFeature formats
+    features = {}
+    for key, val in input_features.items():
+        if hasattr(val, 'type'):  # PolicyFeature object
+            if val.type.value == "VISUAL":
+                pass
+            elif val.type.value == "STATE":
+                features[key] = {
+                    "dtype": "float32",
+                    "shape": val.shape
+                }
+        else:  # dict format
+            if val["type"] == "VISUAL":
+                pass
+            elif val["type"] == "STATE":
+                features[key] = {
+                    "dtype": "float32",
+                    "shape": val["shape"]
+                }
+
+    for key, val in output_features.items():
+        if hasattr(val, 'type'):  # PolicyFeature object
+            features[key] = {
+                "dtype": "float32",
+                "shape": val.shape
+            }
+        else:  # dict format
+            features[key] = {
+                "dtype": "float32",
+                "shape": val["shape"]
+            }
+
+    # Create a minimal metadata that has the features we need
+    class MockMetadata:
+        def __init__(self, features_dict):
+            self.features = features_dict
+            self.fps = 30
+
+    mock_meta = MockMetadata(features)
+
+    # Create policy (this works because make_policy accepts ds_meta)
+    policy = make_policy(cfg=policy_cfg, ds_meta=mock_meta)
+    policy.eval()
+
+    print(f"Policy loaded successfully!")
+
+    # Run inference with random data
+    print(f"Running {args.num_steps} inference steps with random input...")
+
+    all_actions = []
+    with torch.inference_mode():
+        for i in tqdm(range(args.num_steps), desc="Running inference"):
+            # Create random observation matching expected shape
+            observation = {}
+
+            # Add state observations
+            if "observation.state" in input_features:
+                shape = input_features["observation.state"]["shape"]
+                observation["observation.state"] = torch.randn(*shape).to(args.device)
+
+            # Add image observations (dummy zeros)
+            for key, val in input_features.items():
+                if "image" in key and val["type"] == "VISUAL":
+                    shape = val["shape"]
+                    # Use zeros for images (model should handle this)
+                    observation[key] = torch.zeros(*shape, dtype=torch.float32).to(args.device)
+
+            # Run inference
+            action = policy.select_action(observation)
+            all_actions.append(action.to("cpu").numpy())
+
+    # Save results
+    output_dir = Path(args.output_dir)
+    output_dir.mkdir(parents=True, exist_ok=True)
+
+    actions_array = np.concatenate(all_actions, axis=0)
+
+    results = {
+        "num_steps": len(all_actions),
+        "action_shape": actions_array.shape,
+        "action_dtype": str(actions_array.dtype),
+        "actions": actions_array.tolist(),
+    }
+
+    output_file = output_dir / "inference_results.json"
+    with open(output_file, "w") as f:
+        json.dump(results, f, indent=2)
+
+    print(f"Results saved to {output_file}")
+    print(f"Action shape: {actions_array.shape}")
+    print(f"Action range: [{actions_array.min():.3f}, {actions_array.max():.3f}]")
+
+
+if __name__ == "__main__":
+    main()
