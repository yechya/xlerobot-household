+#!/bin/bash
+# Installation script for LeRobot on Jetson platform
+
+echo "=== LeRobot Jetson Installation Script ==="
+echo ""
+
+# Define paths to local torch wheels
+TORCH_WHL_PATH="./torch_wheels/torch-2.3.0-cp310-cp310-linux_aarch64.whl"
+TORCHVISION_WHL_PATH="./torch_wheels/torchvision-0.18.0a0+6043bc2-cp310-cp310-linux_aarch64.whl"
+
+# Check if whl files exist
+if [ ! -f "$TORCH_WHL_PATH" ]; then
+    echo "Error: Torch wheel not found at $TORCH_WHL_PATH"
+    echo "Please ensure the torch wheel is placed in the torch_wheels directory"
+    exit 1
+fi
+
+if [ ! -f "$TORCHVISION_WHL_PATH" ]; then
+    echo "Error: TorchVision wheel not found at $TORCHVISION_WHL_PATH"
+    echo "Please ensure the torchvision wheel is placed in the torch_wheels directory"
+    exit 1
+fi
+
+echo "Step 1: Installing PyTorch from local wheel..."
+pip install --no-cache-dir "$TORCH_WHL_PATH"
+
+echo ""
+echo "Step 2: Installing TorchVision from local wheel..."
+pip install --no-cache-dir "$TORCHVISION_WHL_PATH"
+
+echo ""
+echo "Step 3: Installing remaining dependencies..."
+pip install -e . --no-deps
+
+echo ""
+echo "Installation complete!"
+echo "You can now use LeRobot with your Jetson platform."
diff --git a/py_scripts/README.md b/py_scripts/README.md
new file mode 100644
index 000000000..4a71361d7
--- /dev/null
+++ b/py_scripts/README.md
@@ -0,0 +1,170 @@
+# XLerobot XBOX Controller Dataset Recording
+
+This script allows you to control the XLerobot robot using an XBOX controller and record datasets for training policies.
+
+## Features
+
+- **XBOX Controller Control**: Use an XBOX controller to control both arms, head, and base of the XLerobot robot
+- **Dataset Recording**: Record synchronized camera data and robot states to create training datasets
+- **Policy Support**: Optionally use a trained policy to control the robot during recording
+- **Flexible Configuration**: Supports all configuration options from the original `record.py` script
+
+## Installation
+
+Before running the script, ensure you have the XLerobot environment set up and an XBOX controller connected.
+
+### Docker Device Mapping
+
+Build the user image, then run the helper on the host. It maps
+`/dev/video0`, `/dev/video2`, and `/dev/video4` into the container:
+
+```bash
+make build-user
+scripts/docker_run_lerobot_devices.sh lerobot-find-cameras opencv
+```
+
+Open an interactive container shell with:
+
+```bash
+scripts/docker_run_lerobot_devices.sh
+```
+
+## Usage
+
+### Basic Recording with XBOX Controller
+
+```bash
+python py_scripts/xbox_record.py \
+    --robot.type=xlerobot \
+    --robot.cameras="{ head: {type: opencv, index_or_path: '/dev/video4', width: 640, height: 480, fps: 15}, right: {type: opencv, index_or_path: '/dev/video2', width: 640, height: 480, fps: 15}, left: {type: opencv, index_or_path: '/dev/video0', width: 640, height: 480, fps: 15} }" \
+    --dataset.repo_id=your_huggingface_id/clear_table \
+    --dataset.single_task="Clear the table." \
+    --dataset.root=your_dir/clear_table \
+    --dataset.num_episodes=50 \
+    --display_data=true
+```
+
+### Recording with a Policy
+
+You can also combine XBOX controller control with a trained policy:
+
+```bash
+python py_scripts/xbox_record.py \
+    --robot.type=xlerobot \
+    --robot.cameras='{
+        head: {"type": "opencv", "index_or_path": "/dev/video4", "width": 640, "height": 480, "fps": 15},
+        right: {"type": "opencv", "index_or_path": "/dev/video2", "width": 640, "height": 480, "fps": 15},
+        left: {"type": "opencv", "index_or_path": "/dev/video0", "width": 640, "height": 480, "fps": 15}
+    }' \
+    --dataset.repo_id=your_huggingface_id/clear_table \
+    --dataset.single_task="Clear the table." \
+    --dataset.root=your_dir/clear_table \
+    --dataset.num_episodes=50 \
+    --display_data=true \
+    --policy.path=/path/to/your/trained/policy
+```
+
+### Recording with Policy Only (No XBOX Control)
+
+When a policy is provided, it will be used to control the robot. The XBOX controller can still be used for manual intervention if needed.
+
+## XBOX Controller Mapping
+
+### Left Arm Control (Left Joystick)
+- **Left Stick (not pressed)**: Move arm in X/Y plane
+- **Left Stick (pressed)**: Control shoulder_pan (left/right)
+- **LB + Left Stick**: Control pitch (up/down) and wrist_roll (left/right)
+- **Left Trigger**: Control gripper
+
+### Right Arm Control (Right Joystick)
+- **Right Stick (not pressed)**: Move arm in X/Y plane
+- **Right Stick (pressed)**: Control shoulder_pan (left/right)
+- **RB + Right Stick**: Control pitch (up/down) and wrist_roll (left/right)
+- **Right Trigger**: Control gripper
+
+### Head Control (Left Arm Controls)
+- **X Button**: head_motor_1+
+- **B Button**: head_motor_1-
+- **A Button**: head_motor_2+
+- **Y Button**: head_motor_2-
+
+### Base Control (D-Pad)
+- **D-Pad Up**: Move backward
+- **D-Pad Down**: Move forward
+- **D-Pad Left**: Rotate left
+- **D-Pad Right**: Rotate right
+
+### Base Speed Control
+- **LB (alone)**: Decrease base speed
+- **RB (alone)**: Increase base speed
+- Speed levels: 1.0, 2.0, 3.0
+
+### Reset
+- **Back Button**: Reset all components to zero position
+
+## Command Line Options
+
+All options from the original `record.py` script are supported:
+
+- `--robot.type`: Robot type (must be `xlerobot` for XBOX control)
+- `--robot.cameras`: Camera configuration
+- `--dataset.repo_id`: Hugging Face dataset repository ID
+- `--dataset.single_task`: Description of the task
+- `--dataset.root`: Local directory to store dataset
+- `--dataset.num_episodes`: Number of episodes to record
+- `--dataset.episode_time_s`: Duration of each episode (seconds)
+- `--dataset.fps`: Frames per second
+- `--display_data`: Display camera feed and data
+- `--policy.path`: Path to a trained policy model
+- `--play_sounds`: Enable voice feedback
+- And more...
+
+## Keyboard Controls During Recording
+
+While recording, you can use keyboard shortcuts:
+
+- **Ctrl+C**: Stop recording immediately
+- **q**: Quit recording and exit
+
+## Troubleshooting
+
+### No XBOX Controller Detected
+
+If you see "No XBOX controller detected! Please connect an XBOX controller.":
+
+1. Ensure your XBOX controller is connected via USB or Bluetooth
+2. Check that the controller is recognized by your system
+3. Try restarting the script after connecting the controller
+
+### Robot Connection Issues
+
+If the robot fails to connect:
+
+1. Check that the robot is powered on
+2. Verify the network connection (if using networked robot)
+3. Ensure the robot configuration is correct
+
+### Policy Loading Issues
+
+If a policy fails to load:
+
+1. Verify the policy path exists and contains the necessary files
+2. Check that the policy is compatible with your robot configuration
+3. Ensure the policy was trained with compatible input/output features
+
+## Differences from record.py
+
+This script is based on `record.py` but with the following modifications:
+
+1. **XBOX Controller Integration**: The script automatically detects and uses an XBOX controller when available
+2. **XLerobot Specific**: Designed specifically for the XLerobot robot configuration
+3. **Simultaneous Control**: Supports controlling both arms, head, and base simultaneously
+4. **Enhanced Controls**: Includes base speed control and global reset functionality
+
+## Examples
+
+See the `examples/` directory for more usage examples.
+
+## Contributing
+
+If you encounter any issues or have suggestions for improvements, please report them to the project repository.
diff --git a/py_scripts/bimanual_wheel_teleop.py b/py_scripts/bimanual_wheel_teleop.py
new file mode 100644
index 000000000..e7f828fbe
--- /dev/null
+++ b/py_scripts/bimanual_wheel_teleop.py
@@ -0,0 +1,535 @@
+#!/usr/bin/env python3
+"""
+Teleoperate two follower arms and the XLeRobot mobile base together.
+
+The arm path follows ``scripts/record.sh``:
+
+* ``/dev/ttyACM0``: left follower arm plus head motors
+* ``/dev/ttyACM1``: right follower arm plus the three wheels
+* ``/dev/ttyACM2``: left leader arm
+* ``/dev/ttyACM3``: right leader arm
+
+The leader positions are read continuously and sent to the follower in the
+same action as the keyboard-generated wheel velocities.  Base keys match
+``XLeRobot/software/examples/4_xlerobot_teleop_keyboard.py``:
+``i/k`` forward/backward, ``j/l`` strafe, ``u/o`` rotate, ``n/m`` change
+speed, and ``b`` quit.
+
+Run from the repository root with, for example:
+
+    python py_scripts/bimanual_wheel_teleop.py
+
+No camera is opened by this script.  Press ``b`` or ``ESC`` to stop; the base
+is commanded to zero velocity before the serial buses are disconnected.
+"""
+
+from __future__ import annotations
+
+import argparse
+import builtins
+import logging
+import os
+import sys
+import time
+from contextlib import contextmanager
+from pathlib import Path
+from typing import Any, Iterator
+
+import draccus
+import numpy as np
+
+# Make the checkout usable when the script is launched without PYTHONPATH=src.
+REPO_ROOT = Path(__file__).resolve().parents[1]
+SRC_ROOT = REPO_ROOT / "src"
+if str(SRC_ROOT) not in sys.path:
+    sys.path.insert(0, str(SRC_ROOT))
+
+from lerobot.motors import MotorCalibration  # noqa: E402
+from lerobot.robots.xlerobot import XLerobot, XLerobotConfig  # noqa: E402
+from lerobot.teleoperators.bi_so100_leader import BiSO100Leader, BiSO100LeaderConfig  # noqa: E402
+from lerobot.teleoperators.keyboard import KeyboardTeleop, KeyboardTeleopConfig  # noqa: E402
+from lerobot.utils.constants import HF_LEROBOT_CALIBRATION  # noqa: E402
+from lerobot.utils.errors import DeviceNotConnectedError  # noqa: E402
+
+
+LOGGER = logging.getLogger("bimanual_wheel_teleop")
+
+ARM_JOINTS = (
+    "shoulder_pan",
+    "shoulder_lift",
+    "elbow_flex",
+    "wrist_flex",
+    "wrist_roll",
+    "gripper",
+)
+
+BASE_CALIBRATION_KEYS = (
+    "head_motor_1",
+    "head_motor_2",
+    "base_left_wheel",
+    "base_back_wheel",
+    "base_right_wheel",
+)
+
+
+def _load_calibration(path: Path) -> dict[str, MotorCalibration]:
+    """Load one LeRobot calibration JSON file using the project parser."""
+
+    if not path.is_file():
+        raise FileNotFoundError(f"Calibration file not found: {path}")
+
+    with path.open(encoding="utf-8") as calibration_file, draccus.config_type("json"):
+        return draccus.load(dict[str, MotorCalibration], calibration_file)
+
+
+def _calibration_path(root: Path, device_type: str, calibration_id: str) -> Path:
+    return root / device_type / f"{calibration_id}.json"
+
+
+def build_follower_calibration(
+    calibration_root: Path,
+    xlerobot_calibration_id: str,
+    bimanual_follower_id: str,
+) -> tuple[dict[str, MotorCalibration], Path]:
+    """
+    Combine the XLeRobot head/wheel calibration with record.sh arm calibration.
+
+    ``BiSO100Follower`` stores arm names without a side prefix, while
+    ``XLerobot`` uses ``left_arm_*`` and ``right_arm_*``.  The conversion here
+    keeps the calibration values from the bimanual follower files while taking
+    head and wheel values from the XLeRobot file.
+    """
+
+    xlerobot_path = _calibration_path(
+        calibration_root / "robots", "xlerobot", xlerobot_calibration_id
+    )
+    left_path = _calibration_path(
+        calibration_root / "robots", "so100_follower", f"{bimanual_follower_id}_left"
+    )
+    right_path = _calibration_path(
+        calibration_root / "robots", "so100_follower", f"{bimanual_follower_id}_right"
+    )
+
+    merged = _load_calibration(xlerobot_path)
+    left_calibration = _load_calibration(left_path)
+    right_calibration = _load_calibration(right_path)
+
+    for side, source in (("left", left_calibration), ("right", right_calibration)):
+        missing = [joint for joint in ARM_JOINTS if joint not in source]
+        if missing:
+            raise ValueError(
+                f"{side} follower calibration {left_path if side == 'left' else right_path} "
+                f"is missing joints: {', '.join(missing)}"
+            )
+        for joint in ARM_JOINTS:
+            merged[f"{side}_arm_{joint}"] = source[joint]
+
+    required = [
+        *(f"left_arm_{joint}" for joint in ARM_JOINTS),
+        *(f"right_arm_{joint}" for joint in ARM_JOINTS),
+        *BASE_CALIBRATION_KEYS,
+    ]
+    missing = [name for name in required if name not in merged]
+    if missing:
+        raise ValueError(
+            f"XLeRobot calibration {xlerobot_path} is missing: {', '.join(missing)}"
+        )
+
+    return merged, xlerobot_path
+
+
+def install_follower_calibration(
+    robot: XLerobot, calibration: dict[str, MotorCalibration]
+) -> None:
+    """Install a merged calibration into the robot and both motor buses."""
+
+    missing_bus_motors = [
+        name
+        for bus in (robot.bus1, robot.bus2)
+        for name in bus.motors
+        if name not in calibration
+    ]
+    if missing_bus_motors:
+        raise ValueError(
+            "Merged calibration does not cover all XLeRobot motors: "
+            + ", ".join(missing_bus_motors)
+        )
+
+    robot.calibration = calibration
+    robot.bus1.calibration = {
+        name: calibration[name] for name in robot.bus1.motors
+    }
+    robot.bus2.calibration = {
+        name: calibration[name] for name in robot.bus2.motors
+    }
+
+
+def translate_arm_action(action: dict[str, Any]) -> dict[str, Any]:
+    """Translate BiSO100Leader keys to XLerobot follower keys."""
+
+    translated: dict[str, Any] = {}
+    for key, value in action.items():
+        if key.startswith("left_arm_") or key.startswith("right_arm_"):
+            # This also makes the helper safe if it is passed an already
+            # translated action.
+            translated[key] = value
+        elif key.startswith("left_"):
+            translated[f"left_arm_{key.removeprefix('left_')}"] = value
+        elif key.startswith("right_"):
+            translated[f"right_arm_{key.removeprefix('right_')}"] = value
+        else:
+            LOGGER.warning("Ignoring unsupported leader action key: %s", key)
+    return translated
+
+
+def keyboard_base_action(robot: XLerobot, pressed_keys: set[str]) -> dict[str, float]:
+    """Use the XLeRobot implementation for keyboard-to-base conversion."""
+
+    keys = np.asarray(sorted(pressed_keys), dtype=str)
+    return robot._from_keyboard_to_base_action(keys) or {}
+
+
+def validate_serial_ports(ports: list[str]) -> None:
+    """Fail before connecting motors when a configured serial port is unusable."""
+
+    if len(set(ports)) != len(ports):
+        raise ValueError(
+            "Follower and leader serial ports must be distinct; sharing one port "
+            "would create competing motor-bus connections."
+        )
+
+    missing = [port for port in ports if not Path(port).exists()]
+    if missing:
+        raise FileNotFoundError(
+            "Serial port(s) not found: "
+            + ", ".join(missing)
+            + ". Check the USB connections and port arguments."
+        )
+
+    inaccessible = [
+        port
+        for port in ports
+        if not os.access(port, os.R_OK | os.W_OK)
+    ]
+    if inaccessible:
+        raise PermissionError(
+            "Serial port(s) are not readable/writable for the current user: "
+            + ", ".join(inaccessible)
+            + ". Run `sudo chmod 666 "
+            + " ".join(inaccessible)
+            + "` or add the user to the dialout group."
+        )
+
+
+@contextmanager
+def automatic_restore_input(enabled: bool) -> Iterator[None]:
+    """
+    Accept calibration-file restore prompts without affecting manual mode.
+
+    Some checkout versions of XLerobot prompt even when ``calibrate=False``;
+    this compatibility guard keeps the default path non-interactive.  The
+    caller uses the guard only for the automatic restore path, so existing
+    calibration files are accepted without an interactive prompt.
+    """
+
+    if not enabled:
+        yield
+        return
+
+    original_input = builtins.input
+    builtins.input = lambda _prompt="": ""
+    try:
+        yield
+    finally:
+        builtins.input = original_input
+
+
+def _safe_disconnect_keyboard(keyboard: KeyboardTeleop | None) -> None:
+    if keyboard is None:
+        return
+    try:
+        if keyboard.is_connected:
+            keyboard.disconnect()
+    except Exception as exc:  # cleanup must not hide the original error
+        LOGGER.warning("Keyboard cleanup failed: %s", exc)
+
+
+def _safe_disconnect_leader(leader: BiSO100Leader | None) -> None:
+    if leader is None:
+        return
+    for arm_name in ("left_arm", "right_arm"):
+        arm = getattr(leader, arm_name, None)
+        bus = getattr(arm, "bus", None)
+        if bus is None or not bus.is_connected:
+            continue
+        try:
+            arm.disconnect()
+        except Exception as exc:
+            LOGGER.warning("Leader %s cleanup failed: %s", arm_name, exc)
+
+
+def _safe_disconnect_robot(robot: XLerobot | None) -> None:
+    if robot is None:
+        return
+
+    bus2 = getattr(robot, "bus2", None)
+    if bus2 is not None and bus2.is_connected:
+        try:
+            robot.stop_base()
+        except Exception as exc:
+            LOGGER.warning("Failed to stop the base during cleanup: %s", exc)
+
+    for bus_name in ("bus1", "bus2"):
+        bus = getattr(robot, bus_name, None)
+        if bus is None or not bus.is_connected:
+            continue
+        try:
+            bus.disconnect(robot.config.disable_torque_on_disconnect)
+        except Exception as exc:
+            LOGGER.warning("Follower %s cleanup failed: %s", bus_name, exc)
+
+    for camera in getattr(robot, "cameras", {}).values():
+        try:
+            if camera.is_connected:
+                camera.disconnect()
+        except Exception as exc:
+            LOGGER.warning("Camera cleanup failed: %s", exc)
+
+
+def _build_parser() -> argparse.ArgumentParser:
+    parser = argparse.ArgumentParser(
+        description="Control the bimanual follower arms and XLeRobot wheels together."
+    )
+    parser.add_argument(
+        "--follower-left-port",
+        default="/dev/ttyACM0",
+        help="Follower left bus (left arm and head).",
+    )
+    parser.add_argument(
+        "--follower-right-port",
+        default="/dev/ttyACM1",
+        help="Follower right bus (right arm and wheels).",
+    )
+    parser.add_argument(
+        "--leader-left-port",
+        default="/dev/ttyACM2",
+        help="Leader left arm port.",
+    )
+    parser.add_argument(
+        "--leader-right-port",
+        default="/dev/ttyACM3",
+        help="Leader right arm port.",
+    )
+    parser.add_argument(
+        "--follower-id",
+        default="dachuang_robot",
+        help=(
+            "XLeRobot calibration ID under robots/xlerobot. "
+            "Use 'None' to select None.json."
+        ),
+    )
+    parser.add_argument(
+        "--follower-calibration-id",
+        default="bimanual_follower0",
+        help="SO100 bimanual arm calibration ID used by record.sh.",
+    )
+    parser.add_argument(
+        "--leader-id",
+        default="bimanual_leader0",
+        help="SO100 bimanual leader calibration ID.",
+    )
+    parser.add_argument(
+        "--calibration-root",
+        type=Path,
+        default=HF_LEROBOT_CALIBRATION,
+        help="Root of the LeRobot calibration directory.",
+    )
+    parser.add_argument(
+        "--fps",
+        type=int,
+        default=30,
+        help="Control-loop frequency in Hz (default: 30).",
+    )
+    parser.add_argument(
+        "--max-relative-target",
+        type=float,
+        default=None,
+        help="Optional per-cycle arm position safety limit in normalized units.",
+    )
+    parser.add_argument(
+        "--manual-calibration",
+        action="store_true",
+        help="Allow the device classes to ask for manual calibration.",
+    )
+    parser.add_argument(
+        "--log-level",
+        choices=("DEBUG", "INFO", "WARNING", "ERROR"),
+        default="INFO",
+        help="Logging verbosity.",
+    )
+    return parser
+
+
+def run(args: argparse.Namespace) -> int:
+    if args.fps <= 0:
+        raise ValueError("--fps must be greater than zero")
+    if args.max_relative_target is not None and args.max_relative_target <= 0:
+        raise ValueError("--max-relative-target must be greater than zero")
+
+    validate_serial_ports(
+        [
+            args.follower_left_port,
+            args.follower_right_port,
+            args.leader_left_port,
+            args.leader_right_port,
+        ]
+    )
+
+    calibration_root = args.calibration_root.expanduser().resolve()
+    robot_calibration_dir = calibration_root / "robots" / "xlerobot"
+    leader_calibration_dir = calibration_root / "teleoperators" / "so100_leader"
+
+    merged_calibration: dict[str, MotorCalibration] | None = None
+    xlerobot_calibration_path = (
+        calibration_root / "robots" / "xlerobot" / f"{args.follower_id}.json"
+    )
+    try:
+        merged_calibration, xlerobot_calibration_path = build_follower_calibration(
+            calibration_root=calibration_root,
+            xlerobot_calibration_id=args.follower_id,
+            bimanual_follower_id=args.follower_calibration_id,
+        )
+    except FileNotFoundError:
+        if not args.manual_calibration:
+            raise
+        LOGGER.warning(
+            "One or more follower calibration files are missing; manual calibration will be used."
+        )
+
+    leader_calibration_paths = (
+        leader_calibration_dir / f"{args.leader_id}_left.json",
+        leader_calibration_dir / f"{args.leader_id}_right.json",
+    )
+    missing_leader_calibration = [
+        str(path) for path in leader_calibration_paths if not path.is_file()
+    ]
+    if missing_leader_calibration:
+        if not args.manual_calibration:
+            raise FileNotFoundError(
+                "Leader calibration file(s) not found: "
+                + ", ".join(missing_leader_calibration)
+            )
+        LOGGER.warning(
+            "Leader calibration file(s) are missing; manual calibration will be used: %s",
+            ", ".join(missing_leader_calibration),
+        )
+
+    robot = XLerobot(
+        XLerobotConfig(
+            id=args.follower_id,
+            calibration_dir=robot_calibration_dir,
+            port1=args.follower_left_port,
+            port2=args.follower_right_port,
+            cameras={},
+            max_relative_target=args.max_relative_target,
+        )
+    )
+    if merged_calibration is not None:
+        install_follower_calibration(robot, merged_calibration)
+    elif not args.manual_calibration:
+        raise RuntimeError("Automatic mode requires a complete follower calibration.")
+
+    leader = BiSO100Leader(
+        BiSO100LeaderConfig(
+            id=args.leader_id,
+            calibration_dir=leader_calibration_dir,
+            left_arm_port=args.leader_left_port,
+            right_arm_port=args.leader_right_port,
+        )
+    )
+    keyboard = KeyboardTeleop(KeyboardTeleopConfig())
+
+    if merged_calibration is not None:
+        LOGGER.info("Follower calibration: %s", xlerobot_calibration_path)
+        LOGGER.info(
+            "Arm calibration: %s/%s_{left,right}.json",
+            calibration_root / "robots" / "so100_follower",
+            args.follower_calibration_id,
+        )
+
+    try:
+        # Verify the local keyboard before enabling any motor torque.
+        keyboard.connect()
+        if not keyboard.is_connected:
+            raise RuntimeError(
+                "Keyboard listener is unavailable. Check DISPLAY/pynput before starting the robot."
+            )
+
+        # Passing calibrate=False selects file restoration in XLerobot and
+        # avoids starting a manual routine if a restore fails.  The input
+        # guard handles older XLerobot copies that still display a prompt.
+        with automatic_restore_input(enabled=not args.manual_calibration):
+            robot.connect(calibrate=args.manual_calibration)
+            # SO100Leader only restores its calibration file from inside the
+            # calibrate=True path.  In automatic mode the input guard accepts
+            # that restore prompt; --manual-calibration leaves it interactive.
+            leader.connect(calibrate=True)
+
+        print(
+            "Controls: i/k forward/back, j/l strafe, u/o rotate, "
+            "n/m speed, b quit, ESC quit."
+        )
+        LOGGER.info(
+            "Teleoperation started at %d Hz. Leader arms drive the follower; keyboard drives the base.",
+            args.fps,
+        )
+
+        period = 1.0 / args.fps
+        while True:
+            loop_start = time.perf_counter()
+
+            try:
+                pressed_keys = set(keyboard.get_action().keys())
+            except DeviceNotConnectedError:
+                LOGGER.info("Keyboard listener stopped; ending teleoperation.")
+                break
+
+            if robot.config.teleop_keys["quit"] in pressed_keys:
+                LOGGER.info("Quit key pressed.")
+                break
+
+            arm_action = translate_arm_action(leader.get_action())
+            base_action = keyboard_base_action(robot, pressed_keys)
+            robot.send_action({**arm_action, **base_action})
+
+            remaining = period - (time.perf_counter() - loop_start)
+            if remaining > 0:
+                time.sleep(remaining)
+
+    except KeyboardInterrupt:
+        LOGGER.info("Interrupted by user.")
+    finally:
+        # Stop the mobile base before releasing the other interfaces.
+        _safe_disconnect_robot(robot)
+        _safe_disconnect_keyboard(keyboard)
+        _safe_disconnect_leader(leader)
+
+    return 0
+
+
+def main() -> int:
+    parser = _build_parser()
+    args = parser.parse_args()
+    logging.basicConfig(
+        level=getattr(logging, args.log_level),
+        format="[%(levelname)s] %(message)s",
+    )
+    try:
+        return run(args)
+    except Exception as exc:
+        LOGGER.error("Teleoperation failed: %s", exc)
+        return 1
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
