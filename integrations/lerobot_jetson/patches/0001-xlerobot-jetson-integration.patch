+#!/usr/bin/env python3
+"""
+Profiling script to analyze which compute units are used during SmolVLA inference.
+Run with: python profile_inference.py
+
+This will check:
+1. Device placement of model weights and activations
+2. Timing breakdown of each inference stage
+3. GPU utilization during inference
+"""
+
+import time
+import torch
+import numpy as np
+
+def check_device_info():
+    """Print detailed device information."""
+    print("=" * 60)
+    print("DEVICE INFORMATION")
+    print("=" * 60)
+
+    # CUDA info
+    print(f"\n[CUDA]")
+    print(f"  Available: {torch.cuda.is_available()}")
+    if torch.cuda.is_available():
+        print(f"  Device: {torch.cuda.get_device_name(0)}")
+        print(f"  CUDA Version: {torch.version.cuda}")
+        print(f"  cuDNN Version: {torch.backends.cudnn.version()}")
+        print(f"  cuDNN Benchmark: {torch.backends.cudnn.benchmark}")
+        print(f"  cuDNN Deterministic: {torch.backends.cudnn.deterministic}")
+        print(f"  Total GPU Memory: {torch.cuda.get_device_properties(0).total_memory / 1e9:.1f} GB")
+
+    # CPU info
+    print(f"\n[CPU]")
+    print(f"  Count: {torch.get_num_threads()} threads")
+    print(f"  Name: {torch.get_num_threads()} CPU threads")
+
+    # MPS (Apple Silicon)
+    print(f"\n[MPS]")
+    print(f"  Available: {torch.backends.mps.is_available()}")
+
+def profile_tensor_device(tensor, name):
+    """Check which device a tensor is on."""
+    if isinstance(tensor, torch.Tensor):
+        print(f"  {name}: device={tensor.device}, dtype={tensor.dtype}, shape={tensor.shape}")
+    elif isinstance(tensor, dict):
+        for k, v in tensor.items():
+            profile_tensor_device(v, f"{name}.{k}")
+    elif isinstance(tensor, (list, tuple)):
+        for i, v in enumerate(tensor):
+            profile_tensor_device(v, f"{name}[{i}]")
+
+def check_model_device(model, name="model"):
+    """Check device placement of model parameters."""
+    print(f"\n[{name}] Device Analysis:")
+    devices = {}
+    for n, p in model.named_parameters():
+        d = str(p.device)
+        if d not in devices:
+            devices[d] = []
+        devices[d].append(n)
+
+    for device, params in devices.items():
+        print(f"  Device {device}: {len(params)} parameters")
+        for p in params[:3]:  # Show first 3
+            print(f"    - {p}")
+
+def profile_forward_pass(policy, batch, num_runs=5):
+    """Profile a forward pass and show timing breakdown."""
+    print("\n" + "=" * 60)
+    print("FORWARD PASS PROFILING")
+    print("=" * 60)
+
+    device = next(policy.parameters()).device
+    print(f"\nModel device: {device}")
+
+    # Warmup
+    print("Warming up...")
+    with torch.no_grad():
+        for _ in range(3):
+            _ = policy.predict_action_chunk(batch)
+
+    if torch.cuda.is_available():
+        torch.cuda.synchronize()
+
+    # Profile select_action (single action)
+    print("\n[select_action timing]")
+    times = []
+    for i in range(num_runs):
+        policy.reset()
+        with torch.no_grad():
+            if torch.cuda.is_available():
+                torch.cuda.synchronize()
+            start = time.perf_counter()
+            action = policy.select_action(batch)
+            if torch.cuda.is_available():
+                torch.cuda.synchronize()
+            end = time.perf_counter()
+            times.append((end - start) * 1000)
+            print(f"  Run {i+1}: {times[-1]:.2f} ms")
+
+    print(f"  Average: {np.mean(times):.2f} ms")
+    print(f"  Std: {np.std(times):.2f} ms")
+
+    # Profile predict_action_chunk (full chunk)
+    print("\n[predict_action_chunk timing]")
+    times = []
+    for i in range(num_runs):
+        policy.reset()
+        with torch.no_grad():
+            if torch.cuda.is_available():
+                torch.cuda.synchronize()
+            start = time.perf_counter()
+            actions = policy.predict_action_chunk(batch)
+            if torch.cuda.is_available():
+                torch.cuda.synchronize()
+            end = time.perf_counter()
+            times.append((end - start) * 1000)
+            print(f"  Run {i+1}: {times[-1]:.2f} ms")
+
+    print(f"  Average: {np.mean(times):.2f} ms")
+    print(f"  Std: {np.std(times):.2f} ms")
+
+def check_preprocessor_device(preprocessor):
+    """Check preprocessor device placement."""
+    print("\n" + "=" * 60)
+    print("PREPROCESSOR DEVICE ANALYSIS")
+    print("=" * 60)
+
+    if hasattr(preprocessor, 'steps'):
+        for name, step in preprocessor.steps:
+            print(f"\n[{name}]")
+            if hasattr(step, 'device'):
+                print(f"  Configured device: {step.device}")
+            if hasattr(step, '_tensor_stats'):
+                for k, v in step._tensor_stats.items():
+                    if isinstance(v, dict):
+                        for stat_name, tensor in v.items():
+                            if isinstance(tensor, torch.Tensor):
+                                print(f"  {k}.{stat_name}: {tensor.device}")
+                    elif isinstance(v, torch.Tensor):
+                        print(f"  {k}: {v.device}")
+
+def profile_detailed_inference(policy, batch):
+    """Profile detailed stages of inference."""
+    print("\n" + "=" * 60)
+    print("DETAILED INFERENCE PROFILING")
+    print("=" * 60)
+
+    device = next(policy.parameters()).device
+
+    # Stage 1: Preprocessor
+    print("\n[Stage 1: Preprocessor]")
+    policy.reset()
+    with torch.no_grad():
+        if torch.cuda.is_available():
+            torch.cuda.synchronize()
+        start = time.perf_counter()
+        processed = batch.copy() if isinstance(batch, dict) else {}
+        # Simulate preprocessor
+        if torch.cuda.is_available():
+            torch.cuda.synchronize()
+        end = time.perf_counter()
+        print(f"  Preprocessing: {(end - start) * 1000:.2f} ms")
+
+    # Stage 2: Select action
+    print("\n[Stage 2: select_action]")
+    policy.reset()
+    with torch.no_grad():
+        if torch.cuda.is_available():
+            torch.cuda.synchronize()
+        start = time.perf_counter()
+        action = policy.select_action(batch)
+        if torch.cuda.is_available():
+            torch.cuda.synchronize()
