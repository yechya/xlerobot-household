+"""
+Benchmark: FPS algorithm vs pure Python operations
+Testing 100K ops performance
+"""
+import time
+import numpy as np
+
+
+def pure_python_benchmark():
+    """Test pure Python operation speed for 100K ops"""
+    
+    print("=" * 70)
+    print("Pure Python vs PyTorch Performance Comparison")
+    print("=" * 70)
+    
+    n = 192
+    k = 100
+    total_ops = k * n * 3  # ~100K ops
+    
+    print(f"\nConfiguration:")
+    print(f"  n (candidates): {n}")
+    print(f"  k (iterations): {k}")
+    print(f"  Total ops: {total_ops:,} (~{total_ops/1000:.0f}K)")
+    
+    # Prepare test data
+    coords = [[float(i % 64), float(i // 64)] for i in range(n)]
+    sampled = []
+    min_dist = [float('inf')] * n
+    
+    iterations = 500
+    
+    # Test 1: Pure Python with list operations
+    print(f"\n[Test 1] Pure Python (list operations):")
+    times = []
+    for _ in range(iterations):
+        start = time.perf_counter()
+        
+        sampled = [0]
+        min_dist = [float('inf')] * n
+        
+        for _ in range(k - 1):
+            last = coords[sampled[-1]]
+            
+            # Compute distances
+            dist = []
+            for i in range(n):
+                dx = coords[i][0] - last[0]
+                dy = coords[i][1] - last[1]
+                dist.append(dx*dx + dy*dy)
+            
+            # Update min_dist
+            for i in range(n):
+                if dist[i] < min_dist[i]:
+                    min_dist[i] = dist[i]
+            
+            # Find max of min_dist
+            max_val = max(min_dist)
+            max_idx = min_dist.index(max_val)
+            sampled.append(max_idx)
+        
+        times.append(time.perf_counter() - start)
+    
+    avg_time = np.mean(times) * 1000
+    std_time = np.std(times) * 1000
+    print(f"  Average: {avg_time:.4f} ms")
+    print(f"  Std Dev: {std_time:.4f} ms")
+    
+    # Test 2: Python with numpy
+    print(f"\n[Test 2] Python + NumPy (vectorized):")
+    coords_np = np.array(coords, dtype=np.float32)
+    sampled = [0]
+    min_dist = np.full(n, float('inf'), dtype=np.float32)
+    
+    times = []
+    for _ in range(iterations):
+        start = time.perf_counter()
+        
+        sampled = [0]
+        min_dist = np.full(n, float('inf'), dtype=np.float32)
+        
+        for _ in range(k - 1):
+            last = coords_np[sampled[-1]]
+            
+            # Vectorized distance computation
+            diff = coords_np - last
+            dist = np.sum(diff ** 2, axis=1)
+            
+            # Update min_dist
+            min_dist = np.minimum(min_dist, dist)
+            
+            # Find argmax
+            max_idx = np.argmax(min_dist).item()
+            sampled.append(max_idx)
+        
+        times.append(time.perf_counter() - start)
+    
+    avg_time_numpy = np.mean(times) * 1000
+    std_time_numpy = np.std(times) * 1000
+    print(f"  Average: {avg_time_numpy:.4f} ms")
+    print(f"  Std Dev: {std_time_numpy:.4f} ms")
+    
+    # Test 3: PyTorch (already tested, just reference)
+    print(f"\n[Test 3] PyTorch (CPU tensor operations):")
+    print(f"  Reference: ~13.7 ms")
+    
+    # Summary
+    print("\n" + "=" * 70)
+    print("Summary")
+    print("=" * 70)
+    print(f"\n{'Method':<30} {'Time(ms)':<15} {'Speedup vs PyTorch':<20}")
+    print("-" * 65)
+    print(f"{'Pure Python (list)':<30} {avg_time:<15.4f} {avg_time/13.7:<20.2f}x")
+    print(f"{'Python + NumPy':<30} {avg_time_numpy:<15.4f} {avg_time_numpy/13.7:<20.2f}x")
+    print(f"{'PyTorch (CPU)':<30} {13.7:<15.4f} {'1.00x':<20}")
+    
+    print(f"\n[Analysis]")
+    print(f"  - Pure Python: Slow due to Python loop overhead")
