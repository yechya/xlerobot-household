+#!/usr/bin/env python3
+"""Orbbec 双目摄像头捕获脚本 - 同时获取 RGB 和深度/IR 图像"""
+
+import cv2
+import os
+from datetime import datetime
+
+def capture_orbbec_stereo(
+    rgb_device=1,      # Orbbec RGB
+    depth_device=6,    # Orbbec Depth/IR
+    output_dir="outputs/double_camera"
+):
+    """同时捕获 RGB 和深度/IR 图像"""
+    os.makedirs(output_dir, exist_ok=True)
+    timestamp = datetime.now().strftime("%Y-%m-%d_%H-%M-%S")
+
+    # 打开摄像头
+    cap_rgb = cv2.VideoCapture(rgb_device)
+    cap_depth = cv2.VideoCapture(depth_device)
+
+    if not cap_rgb.isOpened():
+        print(f"❌ 无法打开 RGB 摄像头 /dev/video{rgb_device}")
+        return False
+    if not cap_depth.isOpened():
+        print(f"❌ 无法打开深度摄像头 /dev/video{depth_device}")
+        cap_rgb.release()
+        return False
+
+    print(f"✓ Orbbec 双目摄像头已打开")
+
+    # 设置分辨率
+    cap_rgb.set(cv2.CAP_PROP_FRAME_WIDTH, 640)
+    cap_rgb.set(cv2.CAP_PROP_FRAME_HEIGHT, 480)
+    cap_depth.set(cv2.CAP_PROP_FRAME_WIDTH, 640)
+    cap_depth.set(cv2.CAP_PROP_FRAME_HEIGHT, 480)
+
+    # 捕获图像
+    ret_rgb, frame_rgb = cap_rgb.read()
+    ret_depth, frame_depth = cap_depth.read()
+
+    if ret_rgb and frame_rgb is not None:
+        rgb_path = os.path.join(output_dir, f"rgb_{timestamp}.jpg")
+        cv2.imwrite(rgb_path, frame_rgb)
+        print(f"✓ RGB 图像已保存: {rgb_path}")
+        print(f"  尺寸: {frame_rgb.shape}")
+    else:
+        print("❌ RGB 图像捕获失败")
+
+    if ret_depth and frame_depth is not None:
+        depth_path = os.path.join(output_dir, f"depth_{timestamp}.jpg")
+        cv2.imwrite(depth_path, frame_depth)
+        print(f"✓ 深度/IR 图像已保存: {depth_path}")
+        print(f"  尺寸: {frame_depth.shape}")
+    else:
+        print("❌ 深度/IR 图像捕获失败")
+
+    cap_rgb.release()
+    cap_depth.release()
+
+    return ret_rgb and ret_depth
+
+if __name__ == "__main__":
+    success = capture_orbbec_stereo()
+    if success:
+        print("\n✓ Orbbec 双目图像捕获完成!")
+    else:
+        print("\n❌ 图像捕获失败")
