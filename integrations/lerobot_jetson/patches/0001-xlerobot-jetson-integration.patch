+    engine_dir = os.path.dirname(os.path.abspath(args.engine_path))
+    out_path = os.path.join(engine_dir, "verify_per_joint_results.json")
+    with open(out_path, "w") as f:
+        json.dump(pj_results, f, indent=2, ensure_ascii=False)
+    print(f"\n  详细结果已保存到: {out_path}")
+
+
+if __name__ == "__main__":
+    import sys
+    if "--per-joint" in sys.argv:
+        sys.argv.remove("--per-joint")
