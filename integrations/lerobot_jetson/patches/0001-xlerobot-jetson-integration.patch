@@ -0,0 +1,471 @@
+#!/usr/bin/env python3
+"""
+INT8 校准数据采集 + 校准缓存生成
+
+用已录制的 PyTorch 推理数据集，跑一遍完整的推理流程，
+采集 expert decode 每步去噪的真实输入，然后通过 TRT IInt8EntropyCalibrator2
+生成 INT8 校准缓存（calibration_cache.bin）。
+
+产物：
+  outputs/trt_engines/<model_name>/calibration_cache.bin
+
+用法:
+  PYTHONPATH="src:thrid-party/XLeRobot/software/src:$PYTHONPATH" \
+  LD_PRELOAD=/usr/lib/aarch64-linux-gnu/libnvinfer.so.10 \
+  python scripts/collect_calib_data.py \
+    --policy_path outputs/train/smolvla_pick_up_bottle_three/checkpoints/last/pretrained_model \
+    --onnx_path outputs/trt_engines/smolvla_pick_up_bottle_three/smolvla_pick_up_bottle_three.onnx \
+    --dataset_path ~/.cache/huggingface/lerobot/usrname1/eval_smolvla_pick_up_bottle_three_py_20s \
+    --task "put the bottle into the basket in front of you" \
+    --num_frames 50
+"""
+
+import argparse
+import json
+import logging
+import os
+import time
+
+import numpy as np
+import torch
+
+logging.basicConfig(level=logging.INFO, format="%(asctime)s %(levelname)s %(message)s")
+logger = logging.getLogger(__name__)
+
+import tensorrt as trt
+
+
+def parse_args():
+    p = argparse.ArgumentParser(description="Generate INT8 calibration cache for SmolVLA TRT engine")
+    p.add_argument("--policy_path", type=str, required=True)
+    p.add_argument("--onnx_path", type=str, required=True, help="ONNX model path (from export_trt_engine.py)")
+    p.add_argument("--dataset_path", type=str, required=True)
+    p.add_argument("--task", type=str, default="put the bottle into the basket in front of you")
+    p.add_argument("--num_frames", type=int, default=50, help="Number of frames to use for calibration")
+    p.add_argument("--device", type=str, default="cuda")
+    p.add_argument("--output_dir", type=str, default=None,
+                   help="Output directory for calibration_cache.bin (default: same dir as onnx_path)")
+    return p.parse_args()
+
+
+def load_video_frames(video_path, num_frames):
+    import av
+    frames = []
+    container = av.open(video_path)
+    stream = container.streams.video[0]
+    for i, frame in enumerate(container.decode(stream)):
+        if i >= num_frames:
+            break
+        frames.append(np.array(frame.to_ndarray(format="rgb24")))
+    container.close()
+    return frames
+
+
+def make_observation(frame_idx, states, videos, task):
+    """Build observation dict matching robot eval format."""
+    obs = {}
+    for cam in ["head_cam", "left_cam", "right_cam"]:
+        key = f"observation.images.{cam}"
+        obs[key] = videos[key][frame_idx]
+    obs["observation.state"] = states[frame_idx].astype(np.float32)
+    obs["task"] = task
+    return obs
+
+
+def capture_calib_samples(policy, device, observations, num_steps):
+    """
+    Run full inference pipeline on observations, capture expert decode inputs
+    at each denoise step. Returns list of dicts {input_name: numpy_array}.
+
+    We hook into the denoise_step to capture suffix_embs, attention_mask,
+    position_ids, and all KV cache tensors.
+    """
+    from lerobot.policies.factory import make_pre_post_processors
+    import copy
+
+    preprocessor, _ = make_pre_post_processors(
+        policy.config,
+        pretrained_path=None,
+    )
+
+    samples = []
+    captured_tensors = []
+
+    # Monkey-patch denoise_step to capture inputs
+    original_denoise_step = policy.model.denoise_step
+
+    def capturing_denoise_step(prefix_pad_masks, past_key_values, x_t, timestep):
+        # Build the same inputs as denoise_step does
+        from lerobot.policies.smolvla.modeling_smolvla import make_att_2d_masks
+
+        suffix_embs, suffix_pad_masks, suffix_att_masks = policy.model.embed_suffix(x_t, timestep)
+        suffix_len = suffix_pad_masks.shape[1]
+        batch_size = prefix_pad_masks.shape[0]
+        prefix_len = prefix_pad_masks.shape[1]
+        prefix_pad_2d_masks = prefix_pad_masks[:, None, :].expand(batch_size, suffix_len, prefix_len)
+
+        # Handle pruning mask (same logic as original denoise_step)
+        if past_key_values is not None and "pruned_indices" in past_key_values:
+            pruned_indices = past_key_values["pruned_indices"]
+            prefix_mask = pruned_indices < prefix_len
+            pruned_indices_prefix = pruned_indices[prefix_mask]
+            if pruned_indices_prefix.numel() < prefix_len and pruned_indices_prefix.numel() > 0:
+                prune_mask = torch.ones(batch_size, 1, prefix_len, dtype=torch.bool, device=prefix_pad_masks.device)
+                all_indices = torch.arange(prefix_len, device=prefix_pad_masks.device, dtype=torch.long)
+                is_kept = torch.zeros(prefix_len, dtype=torch.bool, device=prefix_pad_masks.device)
+                is_kept[pruned_indices_prefix] = True
+                pruned_positions = all_indices[~is_kept]
+                if pruned_positions.numel() > 0:
+                    prune_mask.scatter_(2, pruned_positions.view(1, 1, -1).expand(batch_size, 1, -1), False)
+                    prefix_pad_2d_masks = prefix_pad_2d_masks & prune_mask
+
+        suffix_att_2d_masks = make_att_2d_masks(suffix_pad_masks, suffix_att_masks)
+        full_att_2d_masks = torch.cat([prefix_pad_2d_masks, suffix_att_2d_masks], dim=2)
+        prefix_offsets = torch.sum(prefix_pad_masks, dim=-1)[:, None]
+        position_ids = prefix_offsets + torch.cumsum(suffix_pad_masks, dim=1) - 1
+
+        # Capture as numpy
+        num_layers = len([k for k in past_key_values if isinstance(k, int)])
+        sample = {
+            "suffix_embs": suffix_embs.detach().cpu().float().numpy(),
+            "attention_mask": full_att_2d_masks.detach().cpu().to(torch.bool).numpy(),
+            "position_ids": position_ids.detach().cpu().long().numpy(),
+        }
+        for i in range(num_layers):
+            sample[f"kv_layer{i}_key"] = past_key_values[i]["key_states"].detach().cpu().float().numpy()
+            sample[f"kv_layer{i}_value"] = past_key_values[i]["value_states"].detach().cpu().float().numpy()
+
+        captured_tensors.append(sample)
+
+        # Still run the original denoise_step to get proper x_t for next step
+        return original_denoise_step(prefix_pad_masks, past_key_values, x_t, timestep)
+
+    # Temporarily patch
+    policy.model.denoise_step = capturing_denoise_step
+
+    try:
+        for frame_idx, obs in enumerate(observations):
+            obs_copy = copy.copy(obs)
+            task = obs_copy.pop("task", None)
+
+            with torch.inference_mode():
+                for name in obs_copy:
+                    obs_copy[name] = torch.from_numpy(obs_copy[name])
+                    if "image" in name:
+                        obs_copy[name] = obs_copy[name].type(torch.float32) / 255
+                        obs_copy[name] = obs_copy[name].permute(2, 0, 1).contiguous()
+                    obs_copy[name] = obs_copy[name].unsqueeze(0).to(device)
+
+                obs_copy["task"] = task if task else ""
+                obs_copy["robot_type"] = ""
+                obs_copy = preprocessor(obs_copy)
+
+                # Clear queues to force fresh inference
+                policy._queues["action"].clear()
+                for k in list(policy._queues.keys()):
+                    if k != "action":
+                        policy._queues[k].clear()
+
+                # Run full select_action which calls denoise_step num_steps times
+                _ = policy.select_action(obs_copy)
+
+            logger.info(f"  Frame {frame_idx+1}/{len(observations)}: "
+                       f"captured {len(captured_tensors)} denoise steps total")
+
+    finally:
+        # Restore original
+        policy.model.denoise_step = original_denoise_step
+
+    logger.info(f"Total calibration samples: {len(captured_tensors)} "
+                f"({len(observations)} frames x {num_steps} denoise steps)")
+    return captured_tensors
+
+
+class CalibrationDataReader:
+    """Feeds calibration samples to TRT calibrator in order."""
+
+    def __init__(self, samples):
+        self.samples = samples
+        self.current_index = 0
+
+    def reset(self):
+        self.current_index = 0
+
+    def next(self):
+        if self.current_index >= len(self.samples):
+            return None
+        sample = self.samples[self.current_index]
+        self.current_index += 1
+        return sample
+
+
+class EntropyCalibrator2(trt.IInt8EntropyCalibrator2):
+    """TRT IInt8EntropyCalibrator2 implementation using pre-collected numpy samples."""
+
+    def __init__(self, data_reader, cache_file, batch_size=1):
+        import tensorrt as _trt
+
+        self.trt = _trt
+        self.data_reader = data_reader
+        self.cache_file = cache_file
+        self.batch_size = batch_size
+
+        # We need to know input names from the first sample
+        first = data_reader.samples[0]
+        self.input_names = list(first.keys())
+
+        # Pre-allocate device memory for each input (using torch CUDA)
+        self.device_memory = {}
+        for name in self.input_names:
+            shape = first[name].shape
+            self.device_memory[name] = torch.empty(int(np.prod(shape)), dtype=torch.float32, device='cuda')
+
+        self.batch_count = 0
+        _trt.IInt8EntropyCalibrator2.__init__(self)
+
+    def get_batch_size(self):
+        return self.batch_size
+
+    def get_batch(self, names):
+        """Return device pointers for the next batch of inputs."""
+        sample = self.data_reader.next()
+        if sample is None:
+            return None
+
+        import tensorrt as trt
+        pointers = []
+        for name in names:
+            arr = sample[name]
+            # Convert to float32 for calibration (TRT calibrator works in FP32)
+            arr = arr.astype(np.float32)
+            arr = np.ascontiguousarray(arr)
+            # Copy numpy data to pre-allocated torch CUDA tensor
+            torch_tensor = torch.from_numpy(arr).flatten().to('cuda')
+            self.device_memory[name][:torch_tensor.shape[0]].copy_(torch_tensor)
+            pointers.append(int(self.device_memory[name].data_ptr()))
+
+        self.batch_count += 1
+        if self.batch_count % 50 == 0:
+            logger.info(f"  Calibration batch {self.batch_count}/{len(self.data_reader.samples)}")
+
+        return pointers
+
+    def read_calibration_cache(self):
+        if os.path.isfile(self.cache_file):
+            with open(self.cache_file, "rb") as f:
+                return f.read()
+        return None
+
+    def write_calibration_cache(self, cache):
+        with open(self.cache_file, "wb") as f:
+            f.write(cache)
+        logger.info(f"Calibration cache saved: {self.cache_file} ({len(cache)} bytes)")
+
+
+def build_int8_engine(onnx_path, output_engine_path, calibrator, calib_shapes,
+                      selective_int8=True):
+    """Build INT8 TRT engine using Python API with calibrator.
+
+    When selective_int8=True (default), only MatMul layers use INT8 precision;
+    all other layers are forced to FP16. This avoids unnecessary Q/DQ overhead
+    on non-quantizable operations (Range, Expand, ScatterND, Slice, etc.)
+    which caused the previous full-graph INT8 to be slower than FP16.
+    """
+    import tensorrt as trt
+
+    logger.info("Building INT8 engine...")
+    logger.info(f"  ONNX: {onnx_path}")
+    logger.info(f"  Output: {output_engine_path}")
+    logger.info(f"  Selective INT8 (MatMul only): {selective_int8}")
+
+    trt_logger = trt.Logger(trt.Logger.WARNING)
+    builder = trt.Builder(trt_logger)
+    network = builder.create_network(1 << int(trt.NetworkDefinitionCreationFlag.EXPLICIT_BATCH))
+    parser = trt.OnnxParser(network, trt_logger)
+
+    with open(onnx_path, "rb") as f:
+        if not parser.parse(f.read()):
+            logger.error("ONNX parse failed:")
+            for i in range(parser.num_errors):
+                logger.error(f"  {parser.get_error(i)}")
+            raise RuntimeError("ONNX parse failed")
+
+    logger.info("  ONNX parsed successfully")
+
+    # === Selective INT8: set per-layer precision ===
+    if selective_int8:
+        # Layer types that must NOT have their precision changed
+        # (they only support their native precision, typically Int32/Int64/Bool)
+        skip_layer_types = {
+            trt.LayerType.SHAPE,          # Int64 only
+            trt.LayerType.GATHER,         # index is Int32/Int64
+            trt.LayerType.CONSTANT,       # fixed dtype
+            trt.LayerType.IDENTITY,       # passthrough
+            trt.LayerType.SLICE,          # start/size/step are Int64
+            trt.LayerType.CONCATENATION,  # mixed types
+            trt.LayerType.SHUFFLE,        # handles reshape/transpose, shape is Int64
+            trt.LayerType.UNARY,          # may be non-float (e.g. NOT, BITCAST)
+            trt.LayerType.REDUCE,         # may be non-float
+            trt.LayerType.ELEMENTWISE,    # may be comparison (Bool output)
+            trt.LayerType.FILL,           # shape-dependent
+            trt.LayerType.TOPK,           # indices are Int64
+            trt.LayerType.NON_ZERO,       # Int64 output
+            trt.LayerType.SELECT,         # condition is Bool
+            trt.LayerType.CAST,           # explicit dtype conversion
+            trt.LayerType.SCATTER,        # index-based
+            trt.LayerType.CONDITION,      # control flow
+            trt.LayerType.ASSERTION,      # Bool input
+        }
+        matmul_count = 0
+        fp16_count = 0
+        skip_count = 0
+        for i in range(network.num_layers):
+            layer = network[i]
+            if layer.type == trt.LayerType.MATRIX_MULTIPLY:
+                layer.precision = trt.int8
+                matmul_count += 1
+            elif layer.type in skip_layer_types:
+                skip_count += 1
+            else:
+                # Only set FP16 for layers that actually support it
+                # (Softmax, Activation, Scale, etc.)
+                try:
+                    layer.precision = trt.float16
+                    fp16_count += 1
+                except Exception:
+                    skip_count += 1
+        logger.info(f"  Layer precision: {matmul_count} MatMul → INT8, "
+                    f"{fp16_count} → FP16, {skip_count} skipped (native dtype)")
+    else:
+        logger.info("  Full-graph INT8 (legacy mode)")
+
+    # Configure builder
+    config = builder.create_builder_config()
+    config.set_memory_pool_limit(trt.MemoryPoolType.WORKSPACE, 1 << 30)  # 1GB
+
+    # Enable FP16 + INT8 (mixed precision)
+    if builder.platform_has_fast_fp16:
+        config.set_flag(trt.BuilderFlag.FP16)
+        logger.info("  FP16 enabled")
+    if builder.platform_has_fast_int8:
+        config.set_flag(trt.BuilderFlag.INT8)
+        config.int8_calibrator = calibrator
+        logger.info("  INT8 enabled with calibrator")
+
+    # Set optimization profile
+    profile = builder.create_optimization_profile()
+    for name, (min_shape, opt_shape, max_shape) in calib_shapes.items():
+        profile.set_shape(name, min_shape, opt_shape, max_shape)
+    config.add_optimization_profile(profile)
+
+    # Build
+    t0 = time.perf_counter()
+    engine_bytes = builder.build_serialized_network(network, config)
+    t1 = time.perf_counter()
+
+    if engine_bytes is None:
+        raise RuntimeError("TRT engine build failed")
+
+    with open(output_engine_path, "wb") as f:
+        f.write(engine_bytes)
+
+    engine_size = engine_bytes.nbytes / 1024 / 1024
+    logger.info(f"  INT8 engine built in {t1-t0:.1f}s")
+    logger.info(f"  Engine size: {engine_size:.1f} MB")
+    logger.info(f"  Saved to: {output_engine_path}")
+
+    return output_engine_path
+
+
+def main():
+    args = parse_args()
+    device = torch.device(args.device)
+
+    if args.output_dir is None:
+        args.output_dir = os.path.dirname(os.path.abspath(args.onnx_path))
+
+    print("=" * 70)
+    print("INT8 Calibration for SmolVLA TRT Engine")
+    print("=" * 70)
+
+    # [1] Load model
+    print("\n[1/4] Loading model...")
+    from lerobot.policies.smolvla.modeling_smolvla import SmolVLAPolicy
+    policy = SmolVLAPolicy.from_pretrained(args.policy_path)
+    policy.to(device)
+    policy.eval()
+    num_steps = policy.config.num_steps
+    print(f"  num_steps (denoise steps) = {num_steps}")
+    print(f"  chunk_size = {policy.config.chunk_size}")
+
+    # [2] Load dataset observations
+    print(f"\n[2/4] Loading {args.num_frames} frames from dataset...")
+    import pyarrow.parquet as pq
+    from pathlib import Path
+
+    ds_path = Path(args.dataset_path).expanduser()
+    table = pq.read_table(str(ds_path / "data/chunk-000/file-000.parquet"))
+    states = np.stack(table.column("observation.state").to_numpy().tolist())
+    total_frames = min(args.num_frames, len(states))
+    print(f"  Dataset: {total_frames} frames available, using {total_frames}")
+
+    cam_names = ["head_cam", "left_cam", "right_cam"]
+    videos = {}
+    for cam in cam_names:
+        key = f"observation.images.{cam}"
+        vp = str(ds_path / f"videos/{key}/chunk-000/file-000.mp4")
+        videos[key] = load_video_frames(vp, total_frames)
+        print(f"  {cam}: {len(videos[key])} frames")
+
+    observations = [make_observation(i, states, videos, args.task) for i in range(total_frames)]
+
+    # [3] Capture calibration samples
+    print(f"\n[3/4] Capturing calibration data ({total_frames} frames x {num_steps} steps)...")
+    samples = capture_calib_samples(policy, device, observations, num_steps)
+    print(f"  Total samples: {len(samples)}")
+
+    if len(samples) == 0:
+        print("ERROR: No calibration samples captured!")
+        return
+
+    # Print sample shapes
+    print("  Sample tensor shapes:")
+    for name in sorted(samples[0].keys()):
+        print(f"    {name}: {samples[0][name].shape} ({samples[0][name].dtype})")
+
+    # Get shapes for optimization profile from first sample
+    calib_shapes = {}
+    for name, arr in samples[0].items():
+        shape = tuple(arr.shape)
+        calib_shapes[name] = (shape, shape, shape)  # min=opt=max (static shapes)
+
+    # [4] Build INT8 engine
+    print("\n[4/4] Building INT8 engine with calibration...")
+    cache_path = os.path.join(args.output_dir, "calibration_cache.bin")
+    engine_path = args.onnx_path.replace(".onnx", "_int8.engine")
+
+    # Reset data reader
+    data_reader = CalibrationDataReader(samples)
+
+    # Create calibrator
+    calibrator = EntropyCalibrator2(data_reader, cache_path)
+
+    # Build
+    build_int8_engine(args.onnx_path, engine_path, calibrator, calib_shapes)
+
+    print("\n" + "=" * 70)
+    print("DONE!")
+    print("=" * 70)
+    print(f"  Calibration cache: {cache_path}")
+    print(f"  INT8 engine: {engine_path}")
+    print(f"\n下一步: 验证精度")
+    print(f"  PYTHONPATH=\"src:thrid-party/XLeRobot/software/src:$PYTHONPATH\" \\")
+    print(f"  python scripts/verify_trt_with_real_data.py \\")
+    print(f"    --policy_path {args.policy_path} \\")
+    print(f"    --engine_path {engine_path} \\")
+    print(f"    --dataset_path {args.dataset_path} \\")
+    print(f'    --task "{args.task}"')
+
+
+if __name__ == "__main__":
+    main()
