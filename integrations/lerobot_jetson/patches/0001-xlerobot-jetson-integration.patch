+"""PyTorch 推理后端 — 封装现有的 lerobot 执行脚本。"""
+
+import subprocess
+import logging
+from pathlib import Path
+from typing import Optional
+
+from .backends import InferenceBackend, InferenceResult, register_backend
+
+logger = logging.getLogger("inference.pytorch")
+
+# 路径：相对于 scripts/ 的上级目录
+SCRIPTS_DIR = Path(__file__).parent
+# inference/ → scripts/ → lerobot_0.3.3_pzy/ → project_root/
+SKILLS_ROOT = SCRIPTS_DIR.parent.parent.parent / ".claude/skills"
+EXECUTE_TASK_SH = SKILLS_ROOT / "robot-control" / "scripts" / "execute_robot_task.sh"
+
+
+@register_backend("pytorch")
+class PyTorchBackend(InferenceBackend):
+    """
+    PyTorch 推理后端。
+
+    封装现有的 execute_robot_task.sh 脚本，保持原有行为不变。
+    """
+
+    def __init__(self, timeout: int = 360):
+        self.timeout = timeout
+        self._verify_script()
+
+    @property
+    def name(self) -> str:
+        return "pytorch"
+
+    def _verify_script(self) -> None:
+        """检查执行脚本是否存在"""
+        if not EXECUTE_TASK_SH.exists():
+            logger.warning(
+                f"[PyTorchBackend] 执行脚本不存在: {EXECUTE_TASK_SH}，"
+                "将尝试 fallback 到 subprocess 直接调用"
+            )
+
+    def execute(
+        self,
+        task_id: str,
+        model_path: str,
+        model_type: str = "smolvla",
+        **kwargs
+    ) -> InferenceResult:
+        """
+        执行 PyTorch 推理任务。
+
+        Args:
+            task_id: 任务ID（如 "fold_simple"）
+            model_path: 模型路径（暂未使用，从脚本配置读取）
+            model_type: 模型类型（"smolvla" 或 "pi0"）
+            **kwargs: 其他参数（忽略）
+
+        Returns:
+            InferenceResult
+        """
+        logger.info(f"[PyTorchBackend] execute: task={task_id}, model={model_type}")
+
+        if not EXECUTE_TASK_SH.exists():
+            return InferenceResult(
+                success=False,
+                error=f"执行脚本不存在: {EXECUTE_TASK_SH}",
+            )
+
+        try:
+            result = subprocess.run(
+                ["bash", str(EXECUTE_TASK_SH), task_id, model_type],
+                capture_output=True,
+                text=True,
+                timeout=self.timeout,
+            )
+
+            return InferenceResult(
+                success=result.returncode == 0,
+                stdout=result.stdout,
+                stderr=result.stderr[-500:] if result.stderr else "",
+                returncode=result.returncode,
+            )
+
+        except subprocess.TimeoutExpired:
+            logger.error(f"[PyTorchBackend] 任务执行超时: {task_id}")
+            return InferenceResult(
+                success=False,
+                error=f"任务执行超时（{self.timeout}秒）",
+                returncode=-1,
+            )
+        except Exception as e:
+            logger.error(f"[PyTorchBackend] 任务执行异常: {e}")
+            return InferenceResult(
+                success=False,
+                error=str(e),
+                returncode=-2,
+            )
+
+    def health_check(self) -> bool:
+        """检查执行脚本是否可用"""
+        return EXECUTE_TASK_SH.exists()
