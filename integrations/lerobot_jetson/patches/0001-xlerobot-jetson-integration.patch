 from lerobot.robots import Robot
 
 
+# Global action smoothing state
+_action_smoothing_window: int = 1
+_action_history: list[torch.Tensor] = []
+
+
+def set_action_smoothing_window(window: int) -> None:
+    """Set the action smoothing window size for moving average filter.
+
+    Args:
+        window: Window size (1 = disabled)
+    """
+    global _action_smoothing_window, _action_history
+    _action_smoothing_window = window
+    if window <= 1:
+        _action_history.clear()
+
+
+def _apply_action_smoothing(action: torch.Tensor) -> torch.Tensor:
+    """Apply moving average filter to smooth action sequence.
+
+    Args:
+        action: Action tensor of shape (action_dim,)
+
+    Returns:
+        Smoothed action tensor
+    """
+    global _action_history
+
+    if _action_smoothing_window <= 1:
+        return action
+
+    # Add current action to history
+    _action_history.append(action.clone())
+
+    # Keep only the necessary history
+    if len(_action_history) > _action_smoothing_window:
+        _action_history.pop(0)
+
+    # Calculate moving average
+    if len(_action_history) < _action_smoothing_window:
+        # Not enough history yet, use simple average of available
+        stacked = torch.stack(_action_history, dim=0)
+        smoothed = stacked.mean(dim=0)
+    else:
+        # Full window available
+        stacked = torch.stack(_action_history[-_action_smoothing_window:], dim=0)
+        smoothed = stacked.mean(dim=0)
+
+    return smoothed
+
+
