@@ -0,0 +1,53 @@
+#!/bin/bash
+export DISPLAY="${DISPLAY:-:1}"
+
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+
+# 1. 自动定位并激活 Conda 环境
+if [ -z "$CONDA_PREFIX" ]; then
+    if [ -n "$CONDA_EXE" ]; then
+        CONDA_BASE="$(dirname "$(dirname "$CONDA_EXE")")"
+    elif [ -d "$HOME/miniconda3" ]; then
+        CONDA_BASE="$HOME/miniconda3"
+    elif [ -d "$HOME/anaconda3" ]; then
+        CONDA_BASE="$HOME/anaconda3"
+    elif [ -d "/opt/conda" ]; then
+        CONDA_BASE="/opt/conda"
+    fi
+    if [ -f "$CONDA_BASE/etc/profile.d/conda.sh" ]; then
+        source "$CONDA_BASE/etc/profile.d/conda.sh"
+    fi
+fi
+conda activate lerobot_pzy 2>/dev/null || conda activate lerobot 2>/dev/null || true
+
+# 2. 设备串口权限配置
+for dev in /dev/ttyACM0 /dev/ttyACM1 /dev/ttyACM2 /dev/ttyACM3; do
+    [ -e "$dev" ] && sudo chmod 666 "$dev" 2>/dev/null || true
+done
+
+# 3. 动态配置 Python 模块路径
+if [ -d "$SCRIPT_DIR/thrid-party/XLeRobot/software/src" ]; then
+    export PYTHONPATH="$SCRIPT_DIR/thrid-party/XLeRobot/software/src:$PYTHONPATH"
+elif [ -d "$SCRIPT_DIR/../XLeRobot/software/src" ]; then
+    export PYTHONPATH="$SCRIPT_DIR/../XLeRobot/software/src:$PYTHONPATH"
+fi
+
+# 4. 加载本地可选环境配置（如代理、API 密钥等）
+if [ -f "$SCRIPT_DIR/../.env" ]; then
+    set -a
+    source "$SCRIPT_DIR/../.env"
+    set +a
+elif [ -f "$SCRIPT_DIR/.env" ]; then
+    set -a
+    source "$SCRIPT_DIR/.env"
+    set +a
+fi
+
+# 5. torch.compile 持久化缓存（基于当前目录相对路径）
+export TORCH_COMPILE_CACHE_DIR="$SCRIPT_DIR/.torch_compile_cache"
+export TORCHINDUCTOR_FX_GRAPH_CACHE=1
+
+# 6. 解决 conda TRT 兼容问题
+if [ -f /usr/lib/aarch64-linux-gnu/libnvinfer.so.10 ]; then
+    export LD_PRELOAD=/usr/lib/aarch64-linux-gnu/libnvinfer.so.10
+fi
