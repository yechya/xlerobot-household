--- /dev/null
+++ b/src/lerobot/policies/smolvla/trt_expert_decoder.py
@@ -0,0 +1,152 @@
+"""TensorRT runtime wrapper for SmolVLA expert decode path.
+
+Loads a pre-built TensorRT engine and executes the expert decode forward pass,
+replacing the PyTorch vlm_with_expert.forward() call in the denoise loop.
+
+Engine specs:
+  - 35 inputs: suffix_embs, attention_mask, position_ids, + 16 layers x 2 KV tensors
+  - 1 output: expert_output
+  - KV cache tensors are BF16, output is BF16
+"""
+
+import logging
+import os
+
+import tensorrt as trt
+import torch
+
+logger = logging.getLogger(__name__)
+
+
+class TRTExpertDecoder:
+    def __init__(self, engine_path: str, device: str = "cuda"):
+        if not os.path.exists(engine_path):
+            raise FileNotFoundError(f"TRT engine not found: {engine_path}")
+
+        self.device = device
+        self.logger = trt.Logger(trt.Logger.WARNING)
+
+        # Load engine
+        self.runtime = trt.Runtime(self.logger)
+        with open(engine_path, "rb") as f:
+            self.engine = self.runtime.deserialize_cuda_engine(f.read())
+
+        self.context = self.engine.create_execution_context()
+
+        # Reusable CUDA stream to avoid per-call allocation overhead
+        self.stream = torch.cuda.Stream()
+
+        # Build IO metadata
+        self.input_names = []
+        self.output_names = []
+        self._trt_to_torch_dtype = {
+            trt.DataType.FLOAT: torch.float32,
+            trt.DataType.HALF: torch.float16,
+            trt.DataType.BF16: torch.bfloat16,
+            trt.DataType.BOOL: torch.bool,
+            trt.DataType.INT32: torch.int32,
+            trt.DataType.INT64: torch.int64,
+        }
+
+        # Store per-input TRT dtypes so we cast correctly at runtime
+        self._input_trt_dtypes = {}
+
+        for i in range(self.engine.num_io_tensors):
+            name = self.engine.get_tensor_name(i)
+            if self.engine.get_tensor_mode(name) == trt.TensorIOMode.INPUT:
+                self.input_names.append(name)
+                self._input_trt_dtypes[name] = self.engine.get_tensor_dtype(name)
+            else:
+                self.output_names.append(name)
+
+        # Derive num layers from KV tensor naming (not positional assumption)
+        layer_indices = set()
+        for name in self.input_names:
+            if name.startswith("kv_layer"):
+                idx = int(name.split("kv_layer")[1].split("_")[0])
+                layer_indices.add(idx)
+        self._num_layers = max(layer_indices) + 1 if layer_indices else 0
+
+        logger.info(
+            f"TRTExpertDecoder loaded: {len(self.input_names)} inputs, "
+            f"{len(self.output_names)} outputs, {self._num_layers} KV layers"
+        )
+
+    def run(
+        self,
+        suffix_embs: torch.Tensor,
+        attention_mask: torch.Tensor,
+        position_ids: torch.Tensor,
+        past_key_values: dict,
+    ) -> torch.Tensor:
+        """Execute TRT engine for one denoise step.
+
+        Args:
+            suffix_embs: (B, chunk_size, expert_hidden_size) float32
+            attention_mask: (B, chunk_size, prefix_len + chunk_size) bool
+            position_ids: (B, chunk_size) int64
+            past_key_values: dict with int keys 0..num_layers-1, each containing
+                {"key_states": Tensor, "value_states": Tensor}
+
+        Returns:
+            expert_output: (B, chunk_size, expert_hidden_size) float32
+        """
+        # Prepare all input tensors matching engine input names and dtypes
+        input_tensors = {
+            "suffix_embs": suffix_embs.contiguous().to(torch.float32),
+            "attention_mask": attention_mask.contiguous().to(torch.bool),
+            "position_ids": position_ids.contiguous().to(torch.int64),
+        }
+
+        for i in range(self._num_layers):
+            input_tensors[f"kv_layer{i}_key"] = past_key_values[i]["key_states"].contiguous().to(torch.bfloat16)
+            input_tensors[f"kv_layer{i}_value"] = past_key_values[i]["value_states"].contiguous().to(torch.bfloat16)
+
+        # Cast each input to match the engine's expected dtype
+        # (BF16 ONNX engines expect BF16 KV cache, FP32+QDQ ONNX engines expect FP32 KV cache)
+        for name in self.input_names:
+            tensor = input_tensors[name]
+            target_dtype = self._trt_to_torch_dtype.get(self._input_trt_dtypes[name])
+            if target_dtype is not None and tensor.dtype != target_dtype:
+                input_tensors[name] = tensor.to(target_dtype)
+
+        # Set input shapes + addresses so TRT can resolve dynamic output shapes
+        for name in self.input_names:
+            self.context.set_input_shape(name, tuple(input_tensors[name].shape))
+            self.context.set_tensor_address(name, input_tensors[name].data_ptr())
+
+        # Allocate output buffer using engine-resolved shape
+        output_bufs = {}
+        for name in self.output_names:
+            out_shape = self.context.get_tensor_shape(name)
+            out_shape = tuple(max(d, 1) for d in out_shape)
+            out_dtype = self._trt_to_torch_dtype.get(
+                self.engine.get_tensor_dtype(name), torch.bfloat16
+            )
+            output_bufs[name] = torch.empty(out_shape, dtype=out_dtype, device=self.device)
+            self.context.set_tensor_address(name, output_bufs[name].data_ptr())
+
+        # Execute
+        with torch.cuda.stream(self.stream):
+            self.context.execute_async_v3(self.stream.cuda_stream)
+
+        torch.cuda.current_stream().wait_stream(self.stream)
+
+        result = output_bufs["expert_output"].to(torch.float32)
+
+        # Clamp to prevent action explosion from FP16 precision loss
+        result = torch.clamp(result, -10.0, 10.0)
+
+        if torch.isnan(result).any() or torch.isinf(result).any():
+            logger.warning("TRT output contains NaN/Inf, returning zeros as fallback")
+            result = torch.zeros_like(result)
+
+        return result
+
+    def __del__(self):
+        if hasattr(self, "context"):
+            del self.context
+        if hasattr(self, "engine"):
+            del self.engine
+        if hasattr(self, "runtime"):
+            del self.runtime
