+        position_ids=prefix_position_ids,
+        past_key_values=None,
+        inputs_embeds=[prefix_embs, None],
+        use_cache=cfg.use_cache,
+        fill_kv_cache=True,
+        prune_config=cfg.prune_config if cfg.enable_token_pruning else None,
