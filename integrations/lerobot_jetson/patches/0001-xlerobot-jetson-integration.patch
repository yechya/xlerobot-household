diff --git a/scripts/verify_trt_accuracy.py b/scripts/verify_trt_accuracy.py
new file mode 100644
index 000000000..52b2232c8
--- /dev/null
+++ b/scripts/verify_trt_accuracy.py
@@ -0,0 +1,183 @@
+#!/usr/bin/env python3
+"""
+对比 TRT engine 和 PyTorch 单步 expert decode 输出一致性。
+
+用法:
+  export LD_PRELOAD=/usr/lib/aarch64-linux-gnu/libnvinfer.so.10
+  PYTHONPATH="src:thrid-party/XLeRobot/software/src:$PYTHONPATH" \
+  python scripts/verify_trt_accuracy.py \
+    --policy_path outputs/train/smolvla_pick_up_bottle/checkpoints/last/pretrained_model \
+    --engine_path outputs/trt_engines/smolvla_pick_up_bottle/smolvla_pick_up_bottle.engine
+"""
+
+import argparse
+import torch
+import numpy as np
+
+
+def parse_args():
+    p = argparse.ArgumentParser()
+    p.add_argument("--policy_path", type=str, required=True)
+    p.add_argument("--engine_path", type=str, required=True)
+    p.add_argument("--device", type=str, default="cuda")
+    return p.parse_args()
+
+
+def main():
+    args = parse_args()
+    torch.manual_seed(42)
+    np.random.seed(42)
+
+    print("=" * 60)
+    print("TRT vs PyTorch 输出一致性验证")
+    print("=" * 60)
+
+    from lerobot.policies.smolvla.modeling_smolvla import SmolVLAPolicy, make_att_2d_masks
+    from lerobot.policies.smolvla.trt_expert_decoder import TRTExpertDecoder
+
+    policy = SmolVLAPolicy.from_pretrained(args.policy_path)
+    policy.to(args.device)
+    policy.eval()
+    model = policy.model
+    cfg = model.config
+
+    trt = TRTExpertDecoder(args.engine_path)
+
+    # 构造固定输入
+    from transformers import AutoTokenizer
+    tokenizer = AutoTokenizer.from_pretrained("HuggingFaceTB/SmolVLM2-500M-Video-Instruct")
+    tokens = tokenizer("put the bottle into the basket", max_length=512, truncation=True, padding="max_length", return_tensors="pt")
+
+    batch = {}
+    image_keys = [k for k in cfg.input_features if "image" in k]
+    for key in image_keys:
+        feat = cfg.input_features[key]
+        batch[key] = torch.rand(1, 3, feat.shape[1], feat.shape[2], device=args.device)
+    batch["observation.state"] = torch.rand(1, cfg.input_features["observation.state"].shape[0], device=args.device)
+    batch["observation.language.tokens"] = tokens["input_ids"].to(args.device)
+    batch["observation.language.attention_mask"] = tokens["attention_mask"].to(args.device).bool()
+
+    images, img_masks = policy.prepare_images(batch)
+    state = policy.prepare_state(batch)
+    lang_tokens = batch["observation.language.tokens"]
+    lang_masks = batch["observation.language.attention_mask"]
+
+    # Prefill
+    prefix_embs, prefix_pad_masks, prefix_att_masks = model.embed_prefix(
+        images, img_masks, lang_tokens, lang_masks, state=state
+    )
+    prefix_att_2d_masks = make_att_2d_masks(prefix_pad_masks, prefix_att_masks)
+    prefix_position_ids = torch.cumsum(prefix_pad_masks, dim=1) - 1
+
+    ee_coords_2d = torch.tensor(cfg.ee_coords_2d_default, dtype=torch.float32, device=args.device)
+    actual_grid_area = 64
+    num_images = len(images)
+    num_visual_tokens = actual_grid_area * 2
+    lang_start = actual_grid_area * num_images
+
+    suffix_embs_temp, _, _ = model.embed_suffix(
+        torch.zeros(1, cfg.chunk_size, cfg.max_action_dim, device=args.device),
+        torch.ones(1, device=args.device, dtype=torch.float32) * 0.5
+    )
+    suffix_len = suffix_embs_temp.shape[1]
+    total_seq_len = prefix_embs.shape[1] + suffix_len
+    prompt_abs_indices = torch.arange(lang_start, total_seq_len, device=args.device, dtype=torch.long)
+
+    _, past_key_values = model.vlm_with_expert.forward(
