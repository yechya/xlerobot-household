@@ -0,0 +1,135 @@
+"""
+Multi-camera live preview for manual focus adjustment.
+
+Usage:
+    python scripts/camera_preview.py                     # all cameras
+    python scripts/camera_preview.py 0 2 4               # specific cameras
+    python scripts/camera_preview.py 4 --res 1280 720    # higher resolution
+"""
+import argparse
+import threading
+import time
+import sys
+
+import cv2
+import numpy as np
+
+
+def get_resolution(cap):
+    w = int(cap.get(cv2.CAP_PROP_FRAME_WIDTH))
+    h = int(cap.get(cv2.CAP_PROP_FRAME_HEIGHT))
+    return w, h
+
+
+def set_resolution(cap, width, height):
+    cap.set(cv2.CAP_PROP_FRAME_WIDTH, width)
+    cap.set(cv2.CAP_PROP_FRAME_HEIGHT, height)
+
+
+class CameraView:
+    def __init__(self, camera_id, width=None, height=None):
+        self.camera_id = camera_id
+        self.dev = f"/dev/video{camera_id}"
+        self.cap = cv2.VideoCapture(self.dev)
+        if not self.cap.isOpened():
+            raise RuntimeError(f"Cannot open {self.dev}")
+        if width and height:
+            set_resolution(self.cap, width, height)
+        self.frame = None
+        self.stopped = False
+        self.lock = threading.Lock()
+
+    def start(self):
+        t = threading.Thread(target=self._loop, daemon=True)
+        t.start()
+        return self
+
+    def _loop(self):
+        while not self.stopped:
+            ret, frame = self.cap.read()
+            if ret:
+                with self.lock:
+                    self.frame = frame
+            else:
+                time.sleep(0.05)
+
+    def get_frame(self):
+        with self.lock:
+            return self.frame.copy() if self.frame is not None else None
+
+    def stop(self):
+        self.stopped = True
+        self.cap.release()
+
+
+def build_window(cameras):
+    parts = []
+    for cam in cameras:
+        f = cam.get_frame()
+        if f is None:
+            w, h = 640, 480
+            f = np.zeros((h, w, 3), dtype=np.uint8)
+            cv2.putText(f, f"No signal: {cam.dev}", (80, 240),
+                        cv2.FONT_HERSHEY_SIMPLEX, 1, (0, 0, 255), 2)
+        w, h = get_resolution(cam.cap)
+        # Scale each to max 480 height
+        scale = 480 / f.shape[0]
+        if scale < 1:
+            f = cv2.resize(f, None, fx=scale, fy=scale)
+        # Add label
+        label = f"{cam.dev} ({w}x{h})"
+        cv2.putText(f, label, (10, 25), cv2.FONT_HERSHEY_SIMPLEX, 0.7, (0, 255, 0), 2)
+        parts.append(f)
+    # Pad to same height
+    max_h = max(p.shape[0] for p in parts)
+    padded = []
+    for p in parts:
+        if p.shape[0] < max_h:
+            pad = np.zeros((max_h - p.shape[0], p.shape[1], 3), dtype=np.uint8)
+            p = np.vstack([p, pad])
+        padded.append(p)
+    return np.hstack(padded)
+
+
+def main():
+    parser = argparse.ArgumentParser(description="Camera live preview for focus adjustment")
+    parser.add_argument("cameras", nargs="*", type=int, default=[0, 2, 4],
+                        help="Camera IDs to preview (default: 0 2 4)")
+    parser.add_argument("--res", nargs=2, type=int, default=None,
+                        metavar=("W", "H"), help="Set resolution (e.g. 1280 720)")
+    args = parser.parse_args()
+
+    cameras = []
+    for cid in args.cameras:
+        try:
+            cam = CameraView(cid, *(args.res if args.res else [None, None]))
+            cam.start()
+            cameras.append(cam)
+            print(f"Opened {cam.dev}")
+        except RuntimeError as e:
+            print(f"Skipping: {e}")
+
+    if not cameras:
+        print("No cameras available")
+        sys.exit(1)
+
+    print("\nPress 'q' to quit\n")
+
+    window_name = "Camera Preview - Press 'q' to quit"
+    cv2.namedWindow(window_name, cv2.WINDOW_NORMAL)
+
+    try:
+        while True:
+            display = build_window(cameras)
+            cv2.imshow(window_name, display)
+            if cv2.waitKey(30) & 0xFF == ord("q"):
+                break
+    finally:
+        for cam in cameras:
+            cam.stop()
+        cv2.destroyAllWindows()
+        print("Done.")
+
+
+if __name__ == "__main__":
+    main()
