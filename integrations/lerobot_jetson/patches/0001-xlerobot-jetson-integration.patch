+class SimpleHeadControl:
+    def __init__(self, initial_obs, kp=1.2):
+        self.kp = kp
+        self.degree_step = 1
+
+        # Use current actual joint positions as home/zero position
+        self.target_positions = {
+            "head_motor_1": initial_obs.get("head_motor_1.pos", 0.0),
+            "head_motor_2": initial_obs.get("head_motor_2.pos", 0.0),
+        }
+        self.zero_pos = {
+            "head_motor_1": initial_obs.get("head_motor_1.pos", 0.0),
+            "head_motor_2": initial_obs.get("head_motor_2.pos", 0.0),
+        }
+
+    def move_to_zero_position(self, robot):
+        print(f"[HEAD] Moving to Zero Position")
+        self.target_positions = self.zero_pos.copy()
+        action = self.p_control_action(robot)
+        robot.send_action(action)
+
+    def handle_keys(self, key_state):
+        if key_state.get('head_motor_1+'):
+            self.target_positions["head_motor_1"] += self.degree_step
+        if key_state.get('head_motor_1-'):
+            self.target_positions["head_motor_1"] -= self.degree_step
+        if key_state.get('head_motor_2+'):
+            self.target_positions["head_motor_2"] += self.degree_step
+        if key_state.get('head_motor_2-'):
+            self.target_positions["head_motor_2"] -= self.degree_step
+
+    def p_control_action(self, robot, obs=None):
+        if obs is None:
+            obs = robot.get_observation()
+        action = {}
+        for motor in self.target_positions:
+            current = obs.get(f"{HEAD_MOTOR_MAP[motor]}.pos", 0.0)
+            error = self.target_positions[motor] - current
+            control = self.kp * error
+            action[f"{HEAD_MOTOR_MAP[motor]}.pos"] = current + control
+        return action
+
+
+class SimpleTeleopArm:
+    def __init__(self, kinematics, joint_map, initial_obs, prefix="left", kp=1.2):
+        self.kinematics = kinematics
+        self.joint_map = joint_map
+        self.prefix = prefix
+        self.kp = kp
+
+        # Store initial joint positions from the robot's actual position
+        self.joint_positions = {
+            "shoulder_pan": initial_obs[f"{prefix}_arm_shoulder_pan.pos"],
+            "shoulder_lift": initial_obs[f"{prefix}_arm_shoulder_lift.pos"],
+            "elbow_flex": initial_obs[f"{prefix}_arm_elbow_flex.pos"],
+            "wrist_flex": initial_obs[f"{prefix}_arm_wrist_flex.pos"],
+            "wrist_roll": initial_obs[f"{prefix}_arm_wrist_roll.pos"],
+            "gripper": initial_obs[f"{prefix}_arm_gripper.pos"],
+        }
+
+        # Use the current actual position as starting point for IK
+        # Try to compute from current joint positions, fall back to default if failed
+        try:
+            # Create joint position array [shoulder_pan, shoulder_lift, elbow_flex]
+            joint_pos = np.array([
+                self.joint_positions["shoulder_pan"],
+                self.joint_positions["shoulder_lift"],
+                self.joint_positions["elbow_flex"]
+            ])
+            # Compute forward kinematics to get end-effector position
+            T = self.kinematics.forward_kinematics(joint_pos)
+            self.current_x = T[0, 3]  # Extract x coordinate from transformation matrix
+            self.current_y = T[1, 3]  # Extract y coordinate from transformation matrix
+        except Exception as e:
+            # If FK fails, use defaults
+            print(f"[{self.prefix}] Warning: Failed to compute forward kinematics: {e}")
+            print(f"[{self.prefix}] Using default position: x=0.1629, y=0.1131")
+            self.current_x = 0.1629
+            self.current_y = 0.1131
+
+        self.pitch = 0.0
+        self.degree_step = 2
+        self.xy_step = 0.005
+
+        # Use current actual joint positions as zero/home position
+        self.zero_pos = {
+            'shoulder_pan': self.joint_positions["shoulder_pan"],
+            'shoulder_lift': self.joint_positions["shoulder_lift"],
+            'elbow_flex': self.joint_positions["elbow_flex"],
+            'wrist_flex': self.joint_positions["wrist_flex"],
+            'wrist_roll': self.joint_positions["wrist_roll"],
+            'gripper': self.joint_positions["gripper"],
+        }
+
+        # Initialize target positions to match zero position
+        self.target_positions = self.zero_pos.copy()
+        self.last_gripper_state = None
+
+    def move_to_zero_position(self, robot):
+        print(f"[{self.prefix}] Moving to Zero Position...")
+        self.target_positions = self.zero_pos.copy()
+        self.pitch = 0.0
+        self.target_positions["wrist_flex"] = (
+            -self.target_positions["shoulder_lift"]
+            -self.target_positions["elbow_flex"]
+            + self.pitch
+        )
+
+        action = self.p_control_action(robot)
+        robot.send_action(action)
+        print(f"[{self.prefix}] Arrived at home position ✓")
+
+    def handle_keys(self, key_state):
+        if key_state.get('shoulder_pan+'):
+            self.target_positions["shoulder_pan"] += self.degree_step
+        if key_state.get('shoulder_pan-'):
+            self.target_positions["shoulder_pan"] -= self.degree_step
+        if key_state.get('wrist_roll+'):
+            self.target_positions["wrist_roll"] += self.degree_step
+        if key_state.get('wrist_roll-'):
+            self.target_positions["wrist_roll"] -= self.degree_step
+
+        gripper_pressed = key_state.get('gripper+', False)
+        if gripper_pressed:
+            if self.last_gripper_state != 'closed':
+                self.target_positions["gripper"] = 2
+                self.last_gripper_state = 'closed'
+                print(f"[{self.prefix}] gripper: CLOSED")
+        else:
+            if self.last_gripper_state != 'open':
+                self.target_positions["gripper"] = 90
+                self.last_gripper_state = 'open'
+                print(f"[{self.prefix}] gripper: OPENED")
+
+        if key_state.get('pitch+'):
+            self.pitch += self.degree_step
+        if key_state.get('pitch-'):
+            self.pitch -= self.degree_step
+
+        moved = False
+        if key_state.get('x+'):
+            self.current_x += self.xy_step
+            moved = True
+        if key_state.get('x-'):
+            self.current_x -= self.xy_step
+            moved = True
+        if key_state.get('y+'):
+            self.current_y += self.xy_step
+            moved = True
+        if key_state.get('y-'):
+            self.current_y -= self.xy_step
+            moved = True
+        if moved:
+            joint2, joint3 = self.kinematics.inverse_kinematics(self.current_x, self.current_y)
+            self.target_positions["shoulder_lift"] = joint2
+            self.target_positions["elbow_flex"] = joint3
+
+        self.target_positions["wrist_flex"] = (
+            -self.target_positions["shoulder_lift"]
+            -self.target_positions["elbow_flex"]
+            + self.pitch
+        )
+
+    def p_control_action(self, robot, obs=None):
+        if obs is None:
+            obs = robot.get_observation()
+        current = {j: obs[f"{self.prefix}_arm_{j}.pos"] for j in self.joint_map}
+        action = {}
+        for j in self.target_positions:
+            error = self.target_positions[j] - current[j]
+            control = self.kp * error
+            action[f"{self.joint_map[j]}.pos"] = current[j] + control
+        return action
+
