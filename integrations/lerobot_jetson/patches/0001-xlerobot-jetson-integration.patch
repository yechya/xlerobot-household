+#!/usr/bin/env python3
+"""
+对 SmolVLA expert decode ONNX 模型做选择性 INT8 量化。
+
+只对 MatMul（Linear）层做 INT8 量化，其余层保持 FP16。
+使用 onnxruntime.quantization 的 QDQ 模式（插入 QuantizeLinear/DequantizeLinear 节点）。
+
+流程：
+  FP16 ONNX → onnxruntime quantize_static（校准 + 量化）→ INT8 ONNX → trtexec → INT8 engine
+
+用法:
+  PYTHONPATH="src:thrid-party/XLeRobot/software/src:$PYTHONPATH" \
+  LD_PRELOAD=/usr/lib/aarch64-linux-gnu/libnvinfer.so.10 \
+  python scripts/quantize_onnx_int8.py \
+    --policy_path outputs/train/smolvla_pick_up_bottle_three/checkpoints/last/pretrained_model \
+    --onnx_path outputs/trt_engines/smolvla_pick_up_bottle_three/smolvla_pick_up_bottle_three.onnx \
+    --dataset_path $HOME/.cache/huggingface/lerobot/usrname1/eval_smolvla_pick_up_bottle_three_py_20s \
+    --task "put the bottle into the basket in front of you" \
+    --num_frames 50
+"""
+
+import argparse
+import json
+import logging
+import os
+import time
+
+import numpy as np
+import onnx
+import torch
+
+logging.basicConfig(level=logging.INFO, format="%(asctime)s %(levelname)s %(message)s")
+logger = logging.getLogger(__name__)
+
+
+def parse_args():
+    p = argparse.ArgumentParser(description="Selective INT8 quantization for SmolVLA expert decode ONNX")
+    p.add_argument("--policy_path", type=str, required=True)
+    p.add_argument("--onnx_path", type=str, required=True, help="FP16 ONNX input")
+    p.add_argument("--dataset_path", type=str, required=True, help="Dataset for calibration data")
+    p.add_argument("--task", type=str, default="put the bottle into the basket in front of you")
+    p.add_argument("--num_frames", type=int, default=50)
+    p.add_argument("--device", type=str, default="cuda")
+    p.add_argument("--output_dir", type=str, default=None,
+                   help="Output dir (default: same dir as onnx_path)")
+    return p.parse_args()
+
+
+def load_video_frames(video_path, num_frames):
+    import av
+    frames = []
+    container = av.open(video_path)
+    stream = container.streams.video[0]
+    for i, frame in enumerate(container.decode(stream)):
+        if i >= num_frames:
+            break
+        frames.append(np.array(frame.to_ndarray(format="rgb24")))
+    container.close()
+    return frames
+
+
+def make_observation(frame_idx, states, videos, task):
+    obs = {}
+    for cam in ["head_cam", "left_cam", "right_cam"]:
+        key = f"observation.images.{cam}"
+        obs[key] = videos[key][frame_idx]
+    obs["observation.state"] = states[frame_idx].astype(np.float32)
+    obs["task"] = task
+    return obs
+
+
+def capture_calib_samples(policy, device, observations):
+    """
+    Run full inference pipeline, monkey-patch denoise_step to capture
+    expert decode inputs (suffix_embs, attention_mask, position_ids, kv_cache).
+    Returns list of {input_name: numpy_array} dicts.
+    """
+    from lerobot.policies.factory import make_pre_post_processors
+    from lerobot.policies.smolvla.modeling_smolvla import make_att_2d_masks
+    import copy
+
+    preprocessor, _ = make_pre_post_processors(policy.config, pretrained_path=None)
+
+    samples = []
+    captured_tensors = []
+    original_denoise_step = policy.model.denoise_step
+
+    def capturing_denoise_step(prefix_pad_masks, past_key_values, x_t, timestep):
+        # Build inputs same as original denoise_step
+        suffix_embs, suffix_pad_masks, suffix_att_masks = policy.model.embed_suffix(x_t, timestep)
+        suffix_len = suffix_pad_masks.shape[1]
+        batch_size = prefix_pad_masks.shape[0]
+        prefix_len = prefix_pad_masks.shape[1]
+        prefix_pad_2d_masks = prefix_pad_masks[:, None, :].expand(batch_size, suffix_len, prefix_len)
+
+        # Handle pruning mask
+        if past_key_values is not None and "pruned_indices" in past_key_values:
+            pruned_indices = past_key_values["pruned_indices"]
+            prefix_mask = pruned_indices < prefix_len
+            pruned_indices_prefix = pruned_indices[prefix_mask]
+            if pruned_indices_prefix.numel() < prefix_len and pruned_indices_prefix.numel() > 0:
+                prune_mask = torch.ones(batch_size, 1, prefix_len, dtype=torch.bool, device=prefix_pad_masks.device)
+                all_indices = torch.arange(prefix_len, device=prefix_pad_masks.device, dtype=torch.long)
+                is_kept = torch.zeros(prefix_len, dtype=torch.bool, device=prefix_pad_masks.device)
+                is_kept[pruned_indices_prefix] = True
+                pruned_positions = all_indices[~is_kept]
+                if pruned_positions.numel() > 0:
+                    prune_mask.scatter_(2, pruned_positions.view(1, 1, -1).expand(batch_size, 1, -1), False)
+                    prefix_pad_2d_masks = prefix_pad_2d_masks & prune_mask
+
+        suffix_att_2d_masks = make_att_2d_masks(suffix_pad_masks, suffix_att_masks)
+        full_att_2d_masks = torch.cat([prefix_pad_2d_masks, suffix_att_2d_masks], dim=2)
+        prefix_offsets = torch.sum(prefix_pad_masks, dim=-1)[:, None]
+        position_ids = prefix_offsets + torch.cumsum(suffix_pad_masks, dim=1) - 1
+
+        # Capture as numpy
+        num_layers = len([k for k in past_key_values if isinstance(k, int)])
+        sample = {
+            "suffix_embs": suffix_embs.detach().cpu().float().numpy(),
+            "attention_mask": full_att_2d_masks.detach().cpu().to(torch.bool).numpy().astype(np.float32),
+            "position_ids": position_ids.detach().cpu().long().numpy().astype(np.float32),
+        }
+        for i in range(num_layers):
+            sample[f"kv_layer{i}_key"] = past_key_values[i]["key_states"].detach().cpu().float().numpy()
+            sample[f"kv_layer{i}_value"] = past_key_values[i]["value_states"].detach().cpu().float().numpy()
+
+        captured_tensors.append(sample)
+        return original_denoise_step(prefix_pad_masks, past_key_values, x_t, timestep)
+
+    policy.model.denoise_step = capturing_denoise_step
+
+    try:
+        for frame_idx, obs in enumerate(observations):
+            obs_copy = copy.copy(obs)
+            task = obs_copy.pop("task", None)
+
+            with torch.inference_mode():
+                for name in obs_copy:
+                    obs_copy[name] = torch.from_numpy(obs_copy[name])
+                    if "image" in name:
+                        obs_copy[name] = obs_copy[name].type(torch.float32) / 255
+                        obs_copy[name] = obs_copy[name].permute(2, 0, 1).contiguous()
+                    obs_copy[name] = obs_copy[name].unsqueeze(0).to(device)
+
+                obs_copy["task"] = task if task else ""
+                obs_copy["robot_type"] = ""
+                obs_copy = preprocessor(obs_copy)
+
+                policy._queues["action"].clear()
+                for k in list(policy._queues.keys()):
+                    if k != "action":
+                        policy._queues[k].clear()
+
+                _ = policy.select_action(obs_copy)
+
+            logger.info(f"  Frame {frame_idx+1}/{len(observations)}: "
+                       f"captured {len(captured_tensors)} samples total")
+    finally:
+        policy.model.denoise_step = original_denoise_step
+
+    return captured_tensors
+
+
+class SmolVLACalibrationReader:
+    """Calibration data reader for onnxruntime quantization."""
+
+    def __init__(self, samples):
+        self.samples = samples
+        self.index = 0
+
+    def get_next(self):
+        if self.index >= len(self.samples):
+            return None
+        sample = self.samples[self.index]
+        self.index += 1
+        # Keep original dtypes matching ONNX input specs
+        result = {}
+        for k, v in sample.items():
+            if k == "position_ids":
+                result[k] = v.astype(np.int64)
+            elif k == "attention_mask":
+                # attention_mask is bool in ONNX
+                result[k] = v.astype(np.bool_)
+            else:
+                result[k] = v  # float32 for embs and kv_cache
+        return result
+
+    def rewind(self):
+        self.index = 0
+
+
+def _convert_bf16_to_fp32(input_onnx, output_onnx):
+    """Convert all BF16 tensors to FP32 for ORT CPU compatibility.
+
+    Three places to fix:
+    1. Initializers (weights) - data type
+    2. Cast nodes that output BF16 - change to FP32
+    3. value_info / input / output type declarations
+    """
+    import onnx
+    import numpy as np
+    from onnx import numpy_helper, TensorProto
+
+    model = onnx.load(input_onnx)
+
+    # 1. Convert BF16 initializers to FP32
+    init_converted = 0
+    for init in model.graph.initializer:
+        if init.data_type == TensorProto.BFLOAT16:
+            # Read raw BF16 bytes as uint16 (bit-pattern reinterpret, NOT numeric conversion)
+            bf16_raw = np.frombuffer(init.raw_data, dtype=np.uint16).copy()
+            fp32_raw = bf16_raw.astype(np.uint32) << 16
+            fp32_arr = fp32_raw.view(np.float32).reshape(list(init.dims))
+            new_init = numpy_helper.from_array(fp32_arr, name=init.name)
+            init.CopyFrom(new_init)
+            init_converted += 1
+
+    # 2. Convert Cast nodes that output BF16 to FP32
+    cast_converted = 0
+    for node in model.graph.node:
+        if node.op_type == 'Cast':
+            for attr in node.attribute:
+                if attr.name == 'to' and attr.i == TensorProto.BFLOAT16:
+                    attr.i = TensorProto.FLOAT
+                    cast_converted += 1
+
+    # 3. Convert BF16 value_info to FP32
+    vi_converted = 0
+    for vi in model.graph.value_info:
+        if vi.type.tensor_type.elem_type == TensorProto.BFLOAT16:
+            vi.type.tensor_type.elem_type = TensorProto.FLOAT
+            vi_converted += 1
+    for inp in model.graph.input:
+        if inp.type.tensor_type.elem_type == TensorProto.BFLOAT16:
+            inp.type.tensor_type.elem_type = TensorProto.FLOAT
+    for out in model.graph.output:
+        if out.type.tensor_type.elem_type == TensorProto.BFLOAT16:
+            out.type.tensor_type.elem_type = TensorProto.FLOAT
+
+    logger.info(f"  BF16→FP32: {init_converted} initializers, {cast_converted} Cast nodes, {vi_converted} value_info")
+    onnx.save(model, output_onnx)
+    logger.info(f"  Saved: {output_onnx} ({os.path.getsize(output_onnx)/1024/1024:.1f} MB)")
+    return output_onnx
+
+
+def analyze_onnx(onnx_path):
+    """List MatMul nodes (INT8 candidates) and non-quantizable nodes."""
+    from collections import Counter
+    model = onnx.load(onnx_path)
+
+    ops = Counter()
+    matmul_names = []
+    for node in model.graph.node:
+        ops[node.op_type] += 1
+        if node.op_type == "MatMul":
+            matmul_names.append(node.name)
+
+    logger.info(f"ONNX model: {len(model.graph.node)} nodes, {len(matmul_names)} MatMul (INT8 candidates)")
+    logger.info(f"Top ops: {ops.most_common(10)}")
+    return matmul_names
+
+
+def _convert_fp32_to_bf16(input_onnx, output_onnx):
+    """Convert FP32 non-weight tensors back to BF16 for TRT compatibility.
+
+    After ORT QDQ quantization, the ONNX graph is in FP32 (because ORT needed
+    BF16→FP32 conversion). TRT cannot handle this FP32+QDQ combination correctly
+    (it does excessive constant folding, collapsing the engine to 9MB).
+
+    This function converts non-INT8, non-scale, non-zero_point initializers back
+    to BF16, restoring the graph to the dtype structure TRT expects.
+    """
+    import onnx
+    import numpy as np
+    from onnx import numpy_helper, TensorProto
+
+    model = onnx.load(input_onnx)
+
+    # Identify scale and zero_point initializers (must stay FP32)
+    qdq_param_names = set()
+    for node in model.graph.node:
+        if node.op_type in ('QuantizeLinear', 'DequantizeLinear'):
+            # Inputs: [tensor, scale, zero_point], scale is index 1, zp is index 2
+            if len(node.input) >= 2:
+                qdq_param_names.add(node.input[1])  # scale
+            if len(node.input) >= 3:
+                qdq_param_names.add(node.input[2])  # zero_point
+
+    # Also identify the DequantizeLinear output names (these are intermediate FP32
+    # activations between DQ and MatMul - must stay FP32)
+    dq_output_names = set()
+    for node in model.graph.node:
+        if node.op_type == 'DequantizeLinear':
+            for out in node.output:
+                dq_output_names.add(out)
+
+    # Also identify QuantizeLinear input names that come from model inputs
+    # (these tensors flow from BF16 inputs → need Cast BF16→FP32 → Q/DQ)
+    ql_input_names = set()
+    for node in model.graph.node:
+        if node.op_type == 'QuantizeLinear':
+            ql_input_names.add(node.input[0])
+
+    # Also identify Cast nodes that output to QDQ inputs - these should stay FP32
+    # since they feed into QuantizeLinear which expects FP32 scales
+    converted = 0
+    for init in model.graph.initializer:
+        # Skip: INT8 weights, QDQ scale/zero_point, small tensors
+        if init.data_type != TensorProto.FLOAT:
+            continue
+        if init.name in qdq_param_names:
+            continue
+        arr = numpy_helper.to_array(init)
+        # Skip very small tensors (like shape constants, indices)
+        if arr.nbytes < 64:
+            continue
+        # Skip tensors that feed into QDQ nodes (need to stay FP32 for Q/DQ math)
+        # Check if this initializer's name appears as input to any node
+        is_qdq_intermediate = False
+        for node in model.graph.node:
+            if init.name in node.input:
+                # If this tensor feeds into a Cast that feeds into Q/DQ, skip
+                if node.op_type == 'Cast':
+                    for out in node.output:
+                        if out in ql_input_names:
+                            is_qdq_intermediate = True
+                            break
+        if is_qdq_intermediate:
+            continue
+
+        # Convert FP32 → BF16
+        bf16_raw = arr.astype(np.float32).view(np.uint32)
+        bf16_raw = (bf16_raw >> 16).astype(np.uint16)
+        bf16_arr = bf16_raw.view(np.uint16)
+        new_init = onnx.helper.make_tensor(
+            name=init.name,
+            data_type=TensorProto.BFLOAT16,
+            dims=init.dims,
+            vals=bf16_arr.tobytes(),
+            raw=True,
+        )
+        init.CopyFrom(new_init)
+        converted += 1
+
+    # Convert Cast nodes that output BF16 (from the original model) back to BF16
+    cast_converted = 0
+    for node in model.graph.node:
+        if node.op_type == 'Cast':
+            # Check if this Cast was originally BF16→FP32 (now we want FP32→BF16)
+            for attr in node.attribute:
+                if attr.name == 'to' and attr.i == TensorProto.FLOAT:
+                    # Check if the output feeds into a QDQ node
+                    output_name = node.output[0]
+                    feeds_qdq = any(
+                        n.op_type in ('QuantizeLinear', 'DequantizeLinear')
+                        and output_name in n.input
+                        for n in model.graph.node
+                    )
+                    if not feeds_qdq:
+                        attr.i = TensorProto.BFLOAT16
+                        cast_converted += 1
+
+    # Convert value_info types back to BF16 where appropriate
+    vi_converted = 0
+    for vi in model.graph.value_info:
+        if vi.type.tensor_type.elem_type == TensorProto.FLOAT:
+            vi.type.tensor_type.elem_type = TensorProto.BFLOAT16
+            vi_converted += 1
+
+    # Convert input types: KV cache inputs back to BF16
+    kv_inputs = {'kv_layer' + str(i) + suffix for i in range(20) for suffix in ('_key', '_value')}
+    input_converted = 0
+    for inp in model.graph.input:
+        if inp.type.tensor_type.elem_type == TensorProto.FLOAT:
+            # Convert ALL FP32 inputs to BF16 (suffix_embs, KV caches, etc.)
+            # The QDQ nodes will handle quantization internally
+            inp.type.tensor_type.elem_type = TensorProto.BFLOAT16
+            input_converted += 1
+
+    # Convert output type to BF16
+    for out in model.graph.output:
+        if out.type.tensor_type.elem_type == TensorProto.FLOAT:
+            out.type.tensor_type.elem_type = TensorProto.BFLOAT16
+
+    logger.info(f"  FP32→BF16 post-QDQ: {converted} initializers, "
+                f"{cast_converted} Cast nodes, {vi_converted} value_info, "
+                f"{input_converted} KV inputs")
+    onnx.save(model, output_onnx)
+    logger.info(f"  Saved: {output_onnx} ({os.path.getsize(output_onnx)/1024/1024:.1f} MB)")
+    return output_onnx
+
+
+def quantize_onnx(input_onnx, output_onnx, calib_reader, matmul_node_names, nodes_to_exclude=None):
+    """Quantize ONNX model: only specified MatMul layers get INT8.
+
+    Key fix: only quantize the exact MatMul nodes, not the entire graph.
+    Previous version used nodes_to_quantize=None which caused ORT to insert
+    QDQ nodes around ALL operations (including Shape, Gather, Where, etc.),
+    corrupting non-MatMul computation paths.
+
+    After QDQ quantization, converts non-INT8 weights back to BF16 so that
+    TRT can properly handle the graph (FP32+QDQ causes TRT constant folding issues).
+    """
+    from onnxruntime.quantization import quantize_static, QuantFormat, QuantType
+
+    # Step 1: Convert BF16 weights to FP32 (ORT CPU doesn't support BF16 MatMul)
+    logger.info("Converting BF16 weights to FP32 for ORT compatibility...")
+    fp32_onnx = input_onnx.replace(".onnx", "_fp32.onnx")
+    _convert_bf16_to_fp32(input_onnx, fp32_onnx)
+    actual_input = fp32_onnx
+
+    # Step 2: QDQ quantize (only MatMul nodes)
+    logger.info(f"Quantizing: {actual_input} → {output_onnx}")
+    logger.info(f"  Format: QDQ (only {len(matmul_node_names)} MatMul nodes)")
+    logger.info(f"  Weight type: QInt8, Per-channel: True")
+
+    t0 = time.perf_counter()
+    quantize_static(
+        model_input=actual_input,
+        model_output=output_onnx,
+        calibration_data_reader=calib_reader,
+        quant_format=QuantFormat.QDQ,
+        weight_type=QuantType.QInt8,
+        activation_type=QuantType.QInt8,
+        per_channel=True,
+        nodes_to_exclude=nodes_to_exclude or [],
+        nodes_to_quantize=matmul_node_names,  # ONLY quantize these MatMul nodes
+        extra_options={
+            "ActivationSymmetric": True,
+            "WeightSymmetric": True,
+        },
+    )
+    t1 = time.perf_counter()
+    logger.info(f"  Quantization done in {t1-t0:.1f}s")
+
+    # Verify output
+    qmodel = onnx.load(output_onnx)
+    from collections import Counter
+    qops = Counter(node.op_type for node in qmodel.graph.node)
+    logger.info(f"  Quantized ONNX: {len(qmodel.graph.node)} nodes")
+    logger.info(f"  QuantizeLinear: {qops.get('QuantizeLinear', 0)}")
+    logger.info(f"  DequantizeLinear: {qops.get('DequantizeLinear', 0)}")
+    logger.info(f"  MatMul: {qops.get('MatMul', 0)}")
+    logger.info(f"  Size: {os.path.getsize(output_onnx)/1024/1024:.1f} MB")
+
+    # Note: Keep the QDQ ONNX in FP32 format. TRT with --fp16 --int8 handles FP32+QDQ
+    # natively (it's the standard QDQ format). Converting back to BF16 causes dtype
+    # mismatches where QuantizeLinear nodes receive BF16 inputs instead of FP32.
+    logger.info(f"  Final FP32+QDQ ONNX: {output_onnx} "
+                f"({os.path.getsize(output_onnx)/1024/1024:.1f} MB)")
+
+    return output_onnx
+
+
+def build_trt_engine(onnx_path, engine_path, policy_path):
+    """Build TRT engine from INT8 ONNX using trtexec.
+
+    When the ONNX model already contains QDQ (QuantizeLinear/DequantizeLinear) nodes,
+    TRT will recognize them as explicit quantization and use INT8 for those MatMul ops.
+    We pass --int8 to tell TRT to honor the QDQ nodes, and avoid --fp16 which would
+    override the INT8 precision.
+    """
+    import subprocess
+    import json
+
+    logger.info(f"Building TRT engine: {onnx_path} → {engine_path}")
+
+    # Read chunk_size from policy config for shape specification
+    with open(os.path.join(policy_path, "config.json")) as f:
+        cfg = json.load(f)
+    chunk_size = cfg["chunk_size"]
+
+    # Read prefix_len from original (non-int8) ONNX
+    orig_onnx = onnx_path.replace("_int8.onnx", ".onnx")
+    import onnx as onnx_mod
+    orig_model = onnx_mod.load(orig_onnx)
+    prefix_len = None
+    for inp in orig_model.graph.input:
+        if inp.name == "kv_layer0_key":
+            dims = [d.dim_value for d in inp.type.tensor_type.shape.dim]
+            prefix_len = dims[1]
+            break
+    if prefix_len is None:
+        raise RuntimeError("Cannot determine prefix_len from original ONNX")
+    total_len = prefix_len + chunk_size
+
+    logger.info(f"  prefix_len={prefix_len}, chunk_size={chunk_size}, total_len={total_len}")
+
+    # Build KV cache shape strings for all 16 layers (required by trtexec INT8 mode)
+    kv_shapes = ""
+    for i in range(16):
+        kv_shapes += f",kv_layer{i}_key:1x{prefix_len}x5x64,kv_layer{i}_value:1x{prefix_len}x5x64"
+
+    # Build trtexec command
+    # Use --fp16 --int8: FP16 for non-quantized layers,
+    # INT8 for QDQ-annotated MatMul layers.
+    shape_spec = (f"suffix_embs:1x{chunk_size}x720,"
+                  f"attention_mask:1x{chunk_size}x{total_len},"
+                  f"position_ids:1x{chunk_size}")
+    cmd = [
+        "/usr/src/tensorrt/bin/trtexec",
+        "--onnx=" + onnx_path,
+        "--saveEngine=" + engine_path,
+        "--fp16",
+        "--int8",
+        "--memPoolSize=workspace:1024",
+        f"--minShapes={shape_spec}{kv_shapes}",
+        f"--optShapes={shape_spec}{kv_shapes}",
+        f"--maxShapes={shape_spec}{kv_shapes}",
+    ]
+
+    logger.info(f"  Running trtexec with --int8 (QDQ mode)...")
+    t0 = time.perf_counter()
+    result = subprocess.run(cmd, capture_output=True, text=True, timeout=600)
+    t1 = time.perf_counter()
+
+    if result.returncode != 0:
+        logger.error(f"trtexec failed (exit {result.returncode}):")
+        logger.error(result.stderr[-2000:] if len(result.stderr) > 2000 else result.stderr)
+        raise RuntimeError("trtexec failed")
+
+    engine_size = os.path.getsize(engine_path) / 1024 / 1024
+    logger.info(f"  Engine built in {t1-t0:.1f}s, size: {engine_size:.1f} MB")
+    return engine_path
+
+
+def main():
+    args = parse_args()
+    device = torch.device(args.device)
+
+    if args.output_dir is None:
+        args.output_dir = os.path.dirname(os.path.abspath(args.onnx_path))
+
+    print("=" * 70)
+    print("SmolVLA Selective INT8 Quantization (MatMul only)")
+    print("=" * 70)
+
+    # [1] Analyze ONNX
+    print("\n[1/5] Analyzing ONNX model...")
+    matmul_names = analyze_onnx(args.onnx_path)
+
+    # [2] Load model
+    print("\n[2/5] Loading model for calibration data...")
+    from lerobot.policies.smolvla.modeling_smolvla import SmolVLAPolicy
+    policy = SmolVLAPolicy.from_pretrained(args.policy_path)
+    policy.to(device)
+    policy.eval()
+
+    # [3] Load dataset
+    print(f"\n[3/5] Loading {args.num_frames} frames from dataset...")
+    import pyarrow.parquet as pq
+    from pathlib import Path
+
+    ds_path = Path(args.dataset_path).expanduser()
+    table = pq.read_table(str(ds_path / "data/chunk-000/file-000.parquet"))
+    states = np.stack(table.column("observation.state").to_numpy().tolist())
+    total_frames = min(args.num_frames, len(states))
+
+    cam_names = ["head_cam", "left_cam", "right_cam"]
+    videos = {}
+    for cam in cam_names:
+        key = f"observation.images.{cam}"
+        vp = str(ds_path / f"videos/{key}/chunk-000/file-000.mp4")
+        videos[key] = load_video_frames(vp, total_frames)
+
+    observations = [make_observation(i, states, videos, args.task) for i in range(total_frames)]
+
+    # [4] Capture calibration data + Quantize ONNX
+    print(f"\n[4/5] Capturing calibration data + Quantizing ONNX...")
+    samples = capture_calib_samples(policy, device, observations)
+    logger.info(f"Total calibration samples: {len(samples)}")
+
+    if len(samples) == 0:
+        print("ERROR: No calibration samples!")
+        return
+
+    # Quantize - pass explicit MatMul node names to only quantize those
+    int8_onnx_path = args.onnx_path.replace(".onnx", "_int8.onnx")
+    calib_reader = SmolVLACalibrationReader(samples)
+    quantize_onnx(args.onnx_path, int8_onnx_path, calib_reader, matmul_names)
+
+    # [5] Build TRT engine (using the improved build_trt_engine function)
+    print(f"\n[5/5] Building TRT engine from INT8 ONNX...")
+    int8_engine_path = args.onnx_path.replace(".onnx", "_int8_v2.engine")
+    build_trt_engine(int8_onnx_path, int8_engine_path, args.policy_path)
+
+    engine_size = os.path.getsize(int8_engine_path) / 1024 / 1024
+
+    print("\n" + "=" * 70)
+    print("DONE!")
+    print("=" * 70)
+    print(f"  INT8 ONNX:  {int8_onnx_path} ({os.path.getsize(int8_onnx_path)/1024/1024:.1f} MB)")
+    print(f"  INT8 engine: {int8_engine_path} ({engine_size:.1f} MB)")
+    print(f"\n下一步: 验证精度和速度")
+    print(f"  python scripts/verify_trt_with_real_data.py \\")
+    print(f"    --policy_path {args.policy_path} \\")
+    print(f"    --engine_path {int8_engine_path} \\")
+    print(f"    --dataset_path {args.dataset_path} \\")
+    print(f'    --task "{args.task}"')
+
+
+if __name__ == "__main__":
+    main()
