+        ee_coords_2d=ee_coords_2d,
+        num_visual_tokens=num_visual_tokens,
+        visual_abs_indices=torch.arange(num_visual_tokens, device=args.device, dtype=torch.long),
+        prompt_abs_indices=prompt_abs_indices,
+        lang_start=lang_start,
+    )
+
+    # 去噪循环，逐步对比
+    bsize = 1
+    dt = torch.tensor(-1.0 / cfg.num_steps, dtype=torch.float32, device=args.device)
+    actions_shape = (bsize, cfg.chunk_size, cfg.max_action_dim)
+    noise = model.sample_noise(actions_shape, args.device)
+
+    x_t_pt = noise.clone()
+    x_t_trt = noise.clone()
+    time_val = torch.tensor(1.0, dtype=torch.float32, device=args.device)
+
+    print(f"\n去噪循环 ({cfg.num_steps} 步):")
+    print(f"  {'步数':>4s}  {'max_abs_diff':>12s}  {'mean_abs_diff':>14s}  {'allclose':>10s}")
+    print("  " + "-" * 50)
+
+    all_close = True
+    for step in range(cfg.num_steps):
+        expanded_time = time_val.expand(bsize)
+
+        suffix_embs, suffix_pad_masks, suffix_att_masks = model.embed_suffix(x_t_pt, expanded_time)
+        s_len = suffix_pad_masks.shape[1]
+        p_len = prefix_pad_masks.shape[1]
+        p2d = prefix_pad_masks[:, None, :].expand(bsize, s_len, p_len)
+
+        if past_key_values is not None and "pruned_indices" in past_key_values:
+            pruned_indices = past_key_values["pruned_indices"]
+            pmask = pruned_indices < p_len
+            pi = pruned_indices[pmask]
+            if pi.numel() < p_len and pi.numel() > 0:
