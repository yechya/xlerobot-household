+#!/usr/bin/env python3
+"""测试3个摄像头连接和图像捕获"""
+
+import cv2
+import time
+
+def test_camera(camera_id, name, width=640, height=480):
+    """测试单个摄像头"""
+    print(f"\n{'='*50}")
+    print(f"测试 {name} (ID: {camera_id})")
+    print(f"{'='*50}")
+    
+    cap = cv2.VideoCapture(camera_id)
+    
+    if not cap.isOpened():
+        print(f"❌ 无法打开摄像头 {camera_id}")
+        return False
+    
+    # 设置分辨率
+    cap.set(cv2.CAP_PROP_FRAME_WIDTH, width)
+    cap.set(cv2.CAP_PROP_FRAME_HEIGHT, height)
+    
+    # 获取实际分辨率
+    actual_width = cap.get(cv2.CAP_PROP_FRAME_WIDTH)
+    actual_height = cap.get(cv2.CAP_PROP_FRAME_HEIGHT)
+    print(f"✓ 摄像头已打开")
+    print(f"  期望分辨率: {width}x{height}")
+    print(f"  实际分辨率: {int(actual_width)}x{int(actual_height)}")
+    
+    # 捕获测试图像
+    ret, frame = cap.read()
+    
+    if ret and frame is not None:
+        print(f"✓ 图像捕获成功")
+        print(f"  图像尺寸: {frame.shape}")
+        
+        # 保存测试图像
+        filename = f"test_{name.replace(' ', '_')}.jpg"
+        cv2.imwrite(filename, frame)
+        print(f"✓ 图像已保存: {filename}")
+        
+        # 显示图像基本信息
+        gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)
+        print(f"  灰度图统计: min={gray.min()}, max={gray.max()}, mean={gray.mean():.1f}")
+        
+        cap.release()
+        return True
+    else:
+        print(f"❌ 图像捕获失败")
+        cap.release()
+        return False
+
+def main():
+    """测试所有3个摄像头"""
+    cameras = [
+        ("/dev/video2", "Head_Cam"),
+        ("/dev/video0", "Left_Cam"),
+        ("/dev/video4", "Right_Cam"),
+    ]
+    
+    results = []
+    
+    for camera_id, name in cameras:
+        success = test_camera(camera_id, name)
+        results.append((name, success))
+        time.sleep(1)  # 等待摄像头完全关闭
+    
+    # 打印汇总
+    print(f"\n{'='*50}")
+    print("测试汇总")
+    print(f"{'='*50}")
+    
+    for name, success in results:
+        status = "✓ 通过" if success else "❌ 失败"
+        print(f"  {name}: {status}")
+    
+    all_passed = all(r[1] for r in results)
+    print(f"\n总体结果: {'✓ 所有摄像头正常' if all_passed else '❌ 存在问题的摄像头'}")
+    
+    return all_passed
+
+if __name__ == "__main__":
+    main()
