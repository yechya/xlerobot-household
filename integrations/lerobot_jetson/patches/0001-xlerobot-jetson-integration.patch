+#!/usr/bin/env python3
+"""
+底盘运动控制脚本
+
+功能：通过指定方向和距离/角度来控制底盘移动
+
+使用方法：
+    PYTHONPATH=src python py_scripts/chassis_control.py --direction forward --distance 0.5
+    PYTHONPATH=src python py_scripts/chassis_control.py --direction rotate_left --angle 90
+
+支持的方向：
+    - forward: 前进
+    - backward: 后退
+    - left: 左移
+    - right: 右移
+    - rotate_left: 左转（逆时针）
+    - rotate_right: 右转（顺时针）
+"""
+
+import argparse
+import time
+import sys
+
+from lerobot.robots.xlerobot import XLerobot, XLerobotConfig
+
+
+# 速度配置 (m/s 和 deg/s)
+SPEED_LEVELS = {
+    "slow": {"xy": 0.1, "theta": 30},
+    "medium": {"xy": 0.2, "theta": 60},
+    "fast": {"xy": 0.3, "theta": 90},
+}
+
+DEFAULT_SPEED = "medium"
+
+
+class ChassisController:
+    """底盘控制器类"""
+
+    def __init__(self, speed_level: str = DEFAULT_SPEED):
+        """
+        初始化底盘控制器
+
+        Args:
+            speed_level: 速度等级 ("slow", "medium", "fast")
+        """
+        self.robot_config = XLerobotConfig()
+        self.robot = XLerobot(self.robot_config)
+        self.speed_level = speed_level
+        self.speed_setting = SPEED_LEVELS.get(speed_level, SPEED_LEVELS[DEFAULT_SPEED])
+
+    def connect(self):
+        """连接机器人"""
+        try:
+            self.robot.connect()
+            print(f"[INFO] 成功连接到机器人")
+        except Exception as e:
+            print(f"[ERROR] 连接机器人失败: {e}")
+            sys.exit(1)
+
+    def disconnect(self):
+        """断开机器人连接"""
+        try:
+            self.robot.stop_base()
+            self.robot.disconnect()
+            print(f"[INFO] 已断开机器人连接")
+        except Exception as e:
+            print(f"[ERROR] 断开连接失败: {e}")
+
+    def _get_velocity_command(self, direction: str) -> dict:
+        """
+        根据方向获取速度命令
+
+        Args:
+            direction: 移动方向
+
+        Returns:
+            包含 x.vel, y.vel, theta.vel 的字典
+        """
+        xy_speed = self.speed_setting["xy"]
+        theta_speed = self.speed_setting["theta"]
+
+        # 初始化速度命令
+        velocity = {"x.vel": 0.0, "y.vel": 0.0, "theta.vel": 0.0}
+
+        if direction == "forward":
+            velocity["x.vel"] = -xy_speed
+        elif direction == "backward":
+            velocity["x.vel"] = xy_speed
+        elif direction == "left":
+            velocity["y.vel"] = xy_speed
+        elif direction == "right":
+            velocity["y.vel"] = -xy_speed
+        elif direction == "rotate_left":
+            velocity["theta.vel"] = theta_speed
+        elif direction == "rotate_right":
+            velocity["theta.vel"] = -theta_speed
+        else:
+            raise ValueError(f"未知方向: {direction}")
+
+        return velocity
+
+    def _calculate_duration(self, direction: str, distance: float = None, angle: float = None) -> float:
+        """
+        计算运动持续时间
+
+        Args:
+            direction: 移动方向
+            distance: 移动距离 (米)
+            angle: 旋转角度 (度)
+
+        Returns:
+            运动持续时间 (秒)
+        """
+        xy_speed = self.speed_setting["xy"]
+        theta_speed = self.speed_setting["theta"]
+
+        if direction in ["forward", "backward", "left", "right"]:
+            if distance is None:
+                raise ValueError("线性移动需要指定 distance 参数")
+            if xy_speed == 0:
+                raise ValueError("xy 速度不能为 0")
+            return distance / xy_speed
+        elif direction in ["rotate_left", "rotate_right"]:
+            if angle is None:
+                raise ValueError("旋转移动需要指定 angle 参数")
+            if theta_speed == 0:
+                raise ValueError("theta 速度不能为 0")
+            return angle / theta_speed
+        else:
+            raise ValueError(f"未知方向: {direction}")
+
+    def move(self, direction: str, distance: float = None, angle: float = None):
+        """
+        控制底盘移动
+
+        Args:
+            direction: 移动方向 (forward, backward, left, right, rotate_left, rotate_right)
+            distance: 移动距离 (米)，用于线性移动
+            angle: 旋转角度 (度)，用于旋转
+        """
+        # 验证方向参数
+        valid_directions = ["forward", "backward", "left", "right", "rotate_left", "rotate_right"]
+        if direction not in valid_directions:
+            raise ValueError(f"无效的方向: {direction}。有效方向: {valid_directions}")
+
+        # 获取速度命令
+        velocity_cmd = self._get_velocity_command(direction)
+
+        # 计算持续时间
+        duration = self._calculate_duration(direction, distance, angle)
+
+        # 打印运动信息
+        direction_names = {
+            "forward": "前进",
+            "backward": "后退",
+            "left": "左移",
+            "right": "右移",
+            "rotate_left": "左转",
+            "rotate_right": "右转",
+        }
+        if direction in ["forward", "backward", "left", "right"]:
+            print(f"[INFO] {direction_names[direction]} {distance:.2f} 米 (速度: {self.speed_setting['xy']} m/s, 预计时间: {duration:.2f}s)")
+        else:
+            print(f"[INFO] {direction_names[direction]} {angle:.1f} 度 (速度: {self.speed_setting['theta']} deg/s, 预计时间: {duration:.2f}s)")
+
+        # 发送速度命令并等待
+        start_time = time.perf_counter()
+
+        while True:
+            elapsed = time.perf_counter() - start_time
+            if elapsed >= duration:
+                break
+
+            # 发送动作命令
+            self.robot.send_action(velocity_cmd)
+
+            # 短暂休眠以避免 CPU 占用过高
+            time.sleep(0.02)  # 20ms 控制周期
+
+        # 停止底盘
+        self.robot.stop_base()
+        print(f"[INFO] 运动完成，实际用时: {elapsed:.2f}s")
+
+    def move_continuous(self, direction: str, duration: float = None):
+        """
+        持续移动直到超时或用户中断
+
+        Args:
+            direction: 移动方向
+            duration: 持续时间 (秒)，None 表示无限持续直到手动停止
+        """
+        velocity_cmd = self._get_velocity_command(direction)
+
+        direction_names = {
+            "forward": "前进",
+            "backward": "后退",
+            "left": "左移",
+            "right": "右移",
+            "rotate_left": "左转",
+            "rotate_right": "右转",
+        }
+
+        if duration:
+            print(f"[INFO] 开始{direction_names[direction]}，持续 {duration:.2f} 秒...")
+        else:
+            print(f"[INFO] 开始{direction_names[direction]}，按 Ctrl+C 停止...")
+
+        try:
+            start_time = time.perf_counter()
+
+            while True:
+                if duration:
+                    elapsed = time.perf_counter() - start_time
+                    if elapsed >= duration:
+                        break
+
+                self.robot.send_action(velocity_cmd)
+                time.sleep(0.02)
+
+        except KeyboardInterrupt:
+            print("\n[INFO] 用户中断")
+        finally:
+            self.robot.stop_base()
+            print("[INFO] 已停止")
+
+
+def main():
+    parser = argparse.ArgumentParser(
+        description="底盘运动控制脚本",
+        formatter_class=argparse.RawDescriptionHelpFormatter,
+        epilog="""
+示例:
+  前进 0.5 米:
+    python py_scripts/chassis_control.py --direction forward --distance 0.5
+
+  左转 90 度:
+    python py_scripts/chassis_control.py --direction rotate_left --angle 90
+
+  以快速模式右移 1 米:
+    python py_scripts/chassis_control.py --direction right --distance 1.0 --speed fast
+
+  持续前进 5 秒:
+    python py_scripts/chassis_control.py --direction forward --duration 5.0
+
+  无限前进直到手动停止:
+    python py_scripts/chassis_control.py --direction forward
+        """
+    )
+
+    parser.add_argument(
+        "--direction", "-d",
+        type=str,
+        required=True,
+        choices=["forward", "backward", "left", "right", "rotate_left", "rotate_right"],
+        help="移动方向"
+    )
+
+    parser.add_argument(
+        "--distance",
+        type=float,
+        default=None,
+        help="移动距离 (米)，用于 linear 移动"
+    )
+
+    parser.add_argument(
+        "--angle",
+        type=float,
+        default=None,
+        help="旋转角度 (度)，用于 rotate 移动"
+    )
+
+    parser.add_argument(
+        "--duration",
+        type=float,
+        default=None,
+        help="持续时间 (秒)，替代 distance/angle 进行时间控制"
+    )
+
+    parser.add_argument(
+        "--speed", "-s",
+        type=str,
+        default=DEFAULT_SPEED,
+        choices=["slow", "medium", "fast"],
+        help=f"速度等级 (默认: {DEFAULT_SPEED})"
+    )
+
+    args = parser.parse_args()
+
+    # 创建控制器
+    controller = ChassisController(speed_level=args.speed)
+
+    try:
+        # 连接机器人
+        controller.connect()
+
+        # 执行运动
+        if args.duration is not None:
+            controller.move_continuous(args.direction, args.duration)
+        else:
+            controller.move(args.direction, args.distance, args.angle)
+
+    except ValueError as e:
+        print(f"[ERROR] 参数错误: {e}")
+        sys.exit(1)
+    except Exception as e:
+        print(f"[ERROR] 发生错误: {e}")
+        sys.exit(1)
+    finally:
+        controller.disconnect()
+
+
+if __name__ == "__main__":
+    main()
