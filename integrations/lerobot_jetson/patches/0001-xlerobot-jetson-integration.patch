diff --git a/scripts/replay_action.py b/scripts/replay_action.py
new file mode 100644
index 000000000..3c63fa2df
--- /dev/null
+++ b/scripts/replay_action.py
@@ -0,0 +1,160 @@
+#!/usr/bin/env python3
+"""
+回放录制的 action 数据到机械臂
+读取 pick_up_bottle 数据集中的 action，直接发送给 bimanual_follower 机械臂
+
+用法:
+    python3 scripts/replay_action.py --episode 0  # 默认15fps
+"""
+import sys
+from pathlib import Path
+_ROOT = Path(__file__).resolve().parent.parent
+sys.path.insert(0, str(_ROOT / "src"))
+sys.path.insert(0, str(_ROOT / "thrid-party/XLeRobot/software/src"))
+import time
+import argparse
+import numpy as np
+import pandas as pd
+from lerobot.robots.bi_so100_follower.bi_so100_follower import BiSO100Follower
+from lerobot.robots.bi_so100_follower.config_bi_so100_follower import BiSO100FollowerConfig
+
+# ============ 配置 ============
+DATA_PATH = str(Path.home() / ".cache/huggingface/lerobot/usrname1/pick_up_bottle/data/chunk-000/file-000.parquet")
+EPISODE_IDX = 0
+DATASET_FPS = 15.0  # 数据集帧率
+
+# 机器人串口
+LEFT_ARM_PORT = "/dev/ttyACM0"
+RIGHT_ARM_PORT = "/dev/ttyACM1"
+ROBOT_ID = "bimanual_follower0"
+
+# 校准目录（使用已有的校准文件）
+CALIBRATION_DIR = None  # None 则使用默认路径
+
+
+def load_actions(data_path: str, episode_idx: int):
+    """从 parquet 加载指定 episode 的 action 数据"""
+    df = pd.read_parquet(data_path)
+    ep_mask = df["episode_index"] == episode_idx
+    df_ep = df[ep_mask].reset_index(drop=True)
+
+    actions = np.array([np.array(a) for a in df_ep["action"].tolist()], dtype=np.float64)
+    timestamps = df_ep["timestamp"].values.astype(np.float64)
+
+    print(f"加载 Episode {episode_idx}: {len(actions)} 帧")
+    print(f"  action shape: {actions.shape}")
+    print(f"  关节顺序: [左肩pan, 左肩lift, 左肘, 左腕flex, 左腕roll, 左夹爪, 右肩pan, 右肩lift, 右肘, 右腕flex, 右腕roll, 右夹爪]")
+    print(f"  数据单位: 度数 (degrees)")
+
+    return actions, timestamps
+
+
+def actions_to_dict(actions: np.ndarray):
+    """将 action 数组（度数）转换为机器人期望的 dict 格式"""
+    joints = [
+        "left_shoulder_pan", "left_shoulder_lift", "left_elbow_flex",
+        "left_wrist_flex", "left_wrist_roll", "left_gripper",
+        "right_shoulder_pan", "right_shoulder_lift", "right_elbow_flex",
+        "right_wrist_flex", "right_wrist_roll", "right_gripper",
+    ]
+    result = []
+    for i in range(len(actions)):
+        action_dict = {}
+        for j, joint in enumerate(joints):
+            action_dict[f"{joint}.pos"] = float(actions[i, j])
+        result.append(action_dict)
+    return result
+
+
+def replay(actions, timestamps, fps):
+    """连接到机械臂并回放 action"""
+    dt = 1.0 / fps
+    n_frames = len(actions)
+
+    # 初始化机器人配置
+    robot_config = BiSO100FollowerConfig(
+        left_arm_port=LEFT_ARM_PORT,
+        right_arm_port=RIGHT_ARM_PORT,
+        id=ROBOT_ID,
+        calibration_dir=CALIBRATION_DIR,
+        # 使用度数模式（与录制时一致，数据集里存的就是度数）
+        left_arm_use_degrees=True,
+        right_arm_use_degrees=True,
+        # 不限制每次移动的最大相对位移（让 action 完整执行）
+        left_arm_max_relative_target=None,
+        right_arm_max_relative_target=None,
+    )
+
+    # 初始化机器人
+    robot = BiSO100Follower(robot_config)
+
+    print(f"\n连接到机械臂...")
+    robot.connect()
+    print("连接成功！")
+
+    if not robot.is_connected:
+        raise RuntimeError("机械臂连接失败！")
+
+    print(f"\n开始回放 {n_frames} 帧 @ {fps} fps...")
+    print("按 Ctrl+C 提前停止\n")
+
+    joints = [
+        "left_shoulder_pan", "left_shoulder_lift", "left_elbow_flex",
+        "left_wrist_flex", "left_wrist_roll", "left_gripper",
+        "right_shoulder_pan", "right_shoulder_lift", "right_elbow_flex",
+        "right_wrist_flex", "right_wrist_roll", "right_gripper",
+    ]
+
+    try:
+        for i, (action_dict, ts) in enumerate(zip(actions, timestamps)):
+            t0 = time.perf_counter()
+
+            # 发送 action
+            robot.send_action(action_dict)
+
+            # 计算实际等待时间
+            elapsed = time.perf_counter() - t0
+            sleep_time = dt - elapsed
+            if sleep_time > 0:
+                time.sleep(sleep_time)
+
+            # 打印进度
+            if i % 30 == 0 or i == n_frames - 1:
+                progress = (i + 1) / n_frames * 100
+                dt_ms = elapsed * 1000
+                # 打印前4个关节的值（左右各2个主要关节）
+                vals = " | ".join(f"{action_dict.get(f'{j}.pos', 0):.1f}"[:6] for j in joints[:4])
+                print(f"  [{i+1:4d}/{n_frames}] {progress:5.1f}% | {vals} | {dt_ms:.1f}ms")
+
+    except KeyboardInterrupt:
+        print(f"\n用户中断，回放停止在帧 {i+1}/{n_frames}")
+
+    finally:
+        print("\n断开机械臂连接...")
+        robot.disconnect()
+        print("完成！")
+
+
+def main():
+    parser = argparse.ArgumentParser(description="回放录制的 action 数据")
+    parser.add_argument("--episode", type=int, default=EPISODE_IDX,
+                        help="回放的 episode 索引 (default: 0)")
+    parser.add_argument("--fps", type=float, default=DATASET_FPS,
+                        help=f"回放帧率 (default: {DATASET_FPS})")
+    parser.add_argument("--left-port", type=str, default=LEFT_ARM_PORT,
+                        help=f"左臂串口 (default: {LEFT_ARM_PORT})")
+    parser.add_argument("--right-port", type=str, default=RIGHT_ARM_PORT,
+                        help=f"右臂串口 (default: {RIGHT_ARM_PORT})")
+    args = parser.parse_args()
+
+    # 加载数据（度数）
+    actions_deg, timestamps = load_actions(DATA_PATH, args.episode)
+    # 转换为 dict，直接以度数值发送（use_degrees=True 时 send_action 期望度数）
+    actions = actions_to_dict(actions_deg)
+
+    # 回放
+    replay(actions, timestamps, args.fps)
+
+
+if __name__ == "__main__":
+    main()
