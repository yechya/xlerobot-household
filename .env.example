# ==============================================================================
# XLeRobot Household Service Robot - 环境配置模板
# 使用方法：复制本文件为 .env 并按需填写配置
#   cp .env.example .env
# ==============================================================================

# 网络代理（可选，若在国内网络环境拉取 Hugging Face 模型/镜像时使用）
# http_proxy=http://127.0.0.1:7890
# https_proxy=http://127.0.0.1:7890
# all_proxy=http://127.0.0.1:7890
# no_proxy=localhost,127.0.0.1

# VLM 视觉感知模型配置（OpenAI-compatible HTTP 接口）
# VLM_API_URL=https://api.openai.com/v1
# VLM_API_TOKEN=your_api_key_here
# VLM_MODEL=gpt-4o

# 机器人硬件串口配置（默认按 Linux 标准设备文件）
# LEFT_ARM_PORT=/dev/ttyACM0
# RIGHT_ARM_PORT=/dev/ttyACM1
# CHASSIS_PORT=/dev/ttyACM2
# PAN_TILT_PORT=/dev/ttyACM3
