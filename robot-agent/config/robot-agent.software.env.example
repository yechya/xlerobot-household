# Software-only deployment profile. It does not grant access to robot devices.
# Replace /home/you with the account that runs the user service.
ROBOT_AGENT_STATE_DIR=/home/you/.local/state/robot-agent
ROBOT_AGENT_RUNTIME_DIR=/run/user/1000/robot-agent
ROBOT_AGENT_SOCKET=/run/user/1000/robot-agent/robotd.sock
ROBOT_AGENT_LOG_LEVEL=INFO

# Keep all real-actuation and promotion gates closed in software-only mode.
ROBOT_AGENT_REQUIRE_OBSERVATION=false
ROBOT_AGENT_REQUIRE_POLICY_BENCHMARK=false
ROBOT_AGENT_REQUIRE_POLICY_EVIDENCE=false
ROBOT_AGENT_REQUIRE_SAFETY_INTERLOCK=false
ROBOT_AGENT_MOTION_BACKEND=disabled
ROBOT_AGENT_EMERGENCY_STOP_COMMAND=

# Empty paths select the package's reviewed default catalogs.
ROBOT_AGENT_POLICY_REGISTRY=
ROBOT_AGENT_DATASET_RECORDING_CONFIG=
ROBOT_AGENT_TASK_CATALOG=
ROBOT_AGENT_MISSION_CATALOG=
ROBOT_AGENT_SEMANTIC_MAP_CONFIG=
ROBOT_AGENT_EPISODE_CONTEXT=
ROBOT_AGENT_BENCHMARK_REPORT=

# Catalog inspection needs no camera or VLM. Manipulation dry-run uses the real
# evidence/scheduling pipeline and therefore requires all three snapshots plus VLM_API_TOKEN.
ROBOT_AGENT_CAMERA_HOST=127.0.0.1
ROBOT_AGENT_CAMERA_PORT=8766
ROBOT_AGENT_HEAD_CAMERA_DEVICE=/dev/video2
ROBOT_AGENT_LEFT_CAMERA_DEVICE=/dev/video4
ROBOT_AGENT_RIGHT_CAMERA_DEVICE=/dev/video0
ROBOT_AGENT_HEAD_CAMERA_SNAPSHOT_URL=
ROBOT_AGENT_LEFT_CAMERA_SNAPSHOT_URL=
ROBOT_AGENT_RIGHT_CAMERA_SNAPSHOT_URL=
VLM_API_TOKEN=
