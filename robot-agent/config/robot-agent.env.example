# Runtime ownership and local IPC
ROBOT_AGENT_STATE_DIR=/var/lib/robot-agent
ROBOT_AGENT_RUNTIME_DIR=/run/robot-agent
ROBOT_AGENT_SOCKET=/run/robot-agent/robotd.sock
ROBOT_AGENT_LOG_LEVEL=INFO

# Safety policy
ROBOT_AGENT_REQUIRE_OBSERVATION=true
ROBOT_AGENT_OBSERVATION_TTL=30
ROBOT_AGENT_SHUTDOWN_GRACE=2.0
ROBOT_AGENT_MAX_CHASSIS_DISTANCE=0.30
ROBOT_AGENT_MAX_CHASSIS_ANGLE=45

# Immutable episode manifests and learned-policy promotion gate.
ROBOT_AGENT_EPISODE_DIR=/var/lib/robot-agent/episodes
ROBOT_AGENT_EPISODE_CONTEXT=/etc/robot-agent/episode-context.yaml
# Episode-only label for controlled RGB/VLA comparison; does not alter authorization binding.
ROBOT_AGENT_EXPERIMENT_MODE=rgb_pre_post_vla
ROBOT_AGENT_REQUIRE_POLICY_BENCHMARK=true
ROBOT_AGENT_REQUIRE_POLICY_EVIDENCE=true
ROBOT_AGENT_BENCHMARK_REPORT=/var/lib/robot-agent/benchmarks/reports
ROBOT_AGENT_BENCHMARK_MAX_AGE=2592000

# Structured person/pet/privacy boundary gate. Production defaults to required.
ROBOT_AGENT_REQUIRE_SAFETY_INTERLOCK=true
ROBOT_AGENT_SAFETY_POLICY=/etc/robot-agent/safety-policy.yaml
ROBOT_AGENT_SAFETY_SNAPSHOT=/run/robot-agent/safety-snapshot.json

# Hardware adapters. Keep unset until each adapter passes hardware-in-loop tests.
ROBOT_AGENT_POLICY_REGISTRY=/etc/robot-agent/policies.yaml
ROBOT_AGENT_TASK_CATALOG=/etc/robot-agent/tasks.yaml
ROBOT_AGENT_MISSION_CATALOG=/etc/robot-agent/missions.yaml
ROBOT_AGENT_TABLE_CATALOG=/etc/robot-agent/tables.yaml
ROBOT_AGENT_SEMANTIC_MAP_CONFIG=/etc/robot-agent/semantic-map.yaml
ROBOT_AGENT_CHASSIS_COMMAND=/opt/robot-agent/bin/chassis_control
ROBOT_AGENT_PANORAMA_COMMAND=/opt/robot-agent/bin/panorama_capture
ROBOT_AGENT_EMERGENCY_STOP_COMMAND=/opt/robot-agent/bin/hardware_estop

# ROS 2 / Nav2 named motion. Keep disabled until simulation and HIL gates pass.
ROBOT_AGENT_MOTION_BACKEND=disabled
ROBOT_AGENT_NAVIGATION_CATALOG=/etc/robot-agent/navigation.yaml
ROBOT_AGENT_BRINGUP_MANIFEST=/etc/robot-agent/bringup.yaml
ROBOT_AGENT_HIL_REPORT=/var/lib/robot-agent/hil/latest-report.json
ROBOT_AGENT_NAVIGATE_ACTION=navigate_to_pose
ROBOT_AGENT_DOCK_ACTION=dock_robot
ROBOT_AGENT_CMD_VEL_TOPIC=/xlerobot/base/cmd_vel_safe
ROBOT_AGENT_HEARTBEAT_TOPIC=robot_agent/heartbeat
ROBOT_AGENT_NAVIGATION_TIMEOUT=300
ROBOT_AGENT_DOCKING_TIMEOUT=180
ROBOT_AGENT_WATCHDOG_TIMEOUT=0.5
# Optional std_srvs/Trigger endpoint owned by the hardware safety layer.
ROBOT_AGENT_WATCHDOG_ESTOP_SERVICE=

# Three-camera RGB perception
ROBOT_AGENT_CAMERA_HOST=127.0.0.1
ROBOT_AGENT_CAMERA_PORT=8766
ROBOT_AGENT_CAMERA_FFMPEG=ffmpeg
ROBOT_AGENT_CAMERA_WIDTH=640
ROBOT_AGENT_CAMERA_HEIGHT=480
ROBOT_AGENT_CAMERA_FPS=15
ROBOT_AGENT_CAMERA_INPUT_FORMAT=mjpeg
ROBOT_AGENT_HEAD_CAMERA_DEVICE=/dev/video2
ROBOT_AGENT_LEFT_CAMERA_DEVICE=/dev/video4
ROBOT_AGENT_RIGHT_CAMERA_DEVICE=/dev/video0
ROBOT_AGENT_HEAD_CAMERA_SNAPSHOT_URL=http://127.0.0.1:8766/cameras/head_cam/snapshot
ROBOT_AGENT_LEFT_CAMERA_SNAPSHOT_URL=http://127.0.0.1:8766/cameras/left_cam/snapshot
ROBOT_AGENT_RIGHT_CAMERA_SNAPSHOT_URL=http://127.0.0.1:8766/cameras/right_cam/snapshot
ROBOT_AGENT_HEAD_CAMERA_MJPEG_URL=http://127.0.0.1:8766/cameras/head_cam/stream
ROBOT_AGENT_LEFT_CAMERA_MJPEG_URL=http://127.0.0.1:8766/cameras/left_cam/stream
ROBOT_AGENT_RIGHT_CAMERA_MJPEG_URL=http://127.0.0.1:8766/cameras/right_cam/stream
VLM_API_URL=https://example.invalid/v1/chat/completions
VLM_API_TOKEN=
VLM_MODEL=your-vision-model
VLM_TIMEOUT=30
