<?xml version="1.0"?>
<package format="3">
  <name>xlerobot_agent_bringup</name>
  <version>0.1.0</version>
  <description>Safety-gated Nav2 bringup for XLeRobot Agent.</description>
  <maintainer email="robot@example.invalid">XLeRobot Maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>diagnostic_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>python3-zmq</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>xlerobot_manipulation_msgs</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
